<Window x:Class="InkCanvas.SettingsTreeView.SettingsTreeViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ICC CE 设置完整目录"
        Width="900" Height="700"
        WindowStartupLocation="CenterScreen">
    <Grid Background="Black">
        <TreeView x:Name="settingsTreeView" Margin="8">
            <TreeViewItem Header="应用设置" IsExpanded="True">
                <TreeViewItem Header="首页" />
                <TreeViewItem Header="── ICC CE 设置 ──" />
                <TreeViewItem Header="通用" IsExpanded="True">
                    <TreeViewItem Header="基本" IsExpanded="True">
                        <TreeViewItem Header='TextBlock "行为"' IsExpanded="True">
                            <TreeViewItem Header="SettingsCard: 开机自启 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsCard: 注册 Url 协议 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsExpander: 托盘图标 → ToggleSwitch（开则展开）" IsExpanded="True">
                                <TreeViewItem Header="SettingsCard: 鼠标左键/触屏单击时 → ComboBox" />
                                <TreeViewItem Header="SettingsCard: 鼠标右键/触屏长按时 → ComboBox" />
                            </TreeViewItem>
                            <TreeViewItem Header="SettingsCard: 教学安全模式 → ComboBox" />
                            <TreeViewItem Header="SettingsExpander: 显示启动加载界面 → ToggleSwitch（开则展开）" IsExpanded="True">
                                <TreeViewItem Header="SettingsCard: 启动画面风格 → ComboBox" />
                                <TreeViewItem Header="SettingsCard: 自定义图片" />
                                <TreeViewItem Header="SettingsCard: 文字位置" />
                            </TreeViewItem>
                        </TreeViewItem>
                    </TreeViewItem>
                    <TreeViewItem Header="时钟">
                        <TreeViewItem Header='TextBlock "时钟"'>
                            <TreeViewItem Header="SettingsCard: 使用24小时制显示时间 → ComboBox" />
                        </TreeViewItem>
                    </TreeViewItem>
                    <TreeViewItem Header="隐私">
                        <TreeViewItem Header='TextBlock "隐私与遥测"'>
                            <TreeViewItem Header="SettingsExpander: 隐私与遥测（默认展开）" IsExpanded="True">
                                <TreeViewItem Header="SettingsCard → CheckBox: 隐私协议" />
                                <TreeViewItem Header="SettingsCard: 遥测级别 → ComboBox" />
                            </TreeViewItem>
                        </TreeViewItem>
                    </TreeViewItem>
                    <TreeViewItem Header="安全" IsExpanded="True">
                        <TreeViewItem Header='TextBlock "安全密码"' IsExpanded="True">
                            <TreeViewItem Header="InfoBar: 安全密码说明" />
                            <TreeViewItem Header="LabeledSettingsCard: 启用密码保护 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsCard: 密码管理 → Button" />
                            <TreeViewItem Header="LabeledSettingsCard: 启用 TOTP → ToggleSwitch" />
                            <TreeViewItem Header="SettingsCard: TOTP 密钥 → TextBox + Button" />
                            <TreeViewItem Header="LabeledSettingsCard: 退出时要求密码 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 进入设置时要求密码 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 重置配置时要求密码 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 修改/清空名单时要求密码 → ToggleSwitch" />
                        </TreeViewItem>
                        <TreeViewItem Header='TextBlock "U盘验证"'>
                            <TreeViewItem Header="InfoBar: U盘验证说明" />
                            <TreeViewItem Header="LabeledSettingsCard: 启用 U盘验证 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsCard: 已授权 U盘序列号 → TextBox" />
                            <TreeViewItem Header="SettingsCard: 检测并授权 U盘 → ComboBox + Button" />
                        </TreeViewItem>
                        <TreeViewItem Header='TextBlock "进程保护"'>
                            <TreeViewItem Header="InfoBar: 进程保护说明" />
                            <TreeViewItem Header="LabeledSettingsCard: 进程保护 → ToggleSwitch" />
                        </TreeViewItem>
                    </TreeViewItem>
                    <TreeViewItem Header="高级" IsExpanded="True">
                        <TreeViewItem Header='TextBlock "高级"' IsExpanded="True">
                            <TreeViewItem Header="LabeledSettingsCard: 特殊屏幕模式 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 禁用硬件加速 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsExpander: 触控倍率（默认展开）" IsExpanded="True">
                                <TreeViewItem Header="Slider + TextBlock" />
                                <TreeViewItem Header="SettingsCard: 触控倍率校准 → Border + TextBlock" />
                            </TreeViewItem>
                            <TreeViewItem Header="LabeledSettingsCard: 橡皮擦绑定触控倍率 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsCard: 笔尖模式边界宽度 → Slider" />
                            <TreeViewItem Header="SettingsCard: 手指模式边界宽度 → Slider" />
                            <TreeViewItem Header="LabeledSettingsCard: 四点红外模式 → ToggleSwitch" />
                        </TreeViewItem>
                        <TreeViewItem Header='TextBlock "日志"'>
                            <TreeViewItem Header="LabeledSettingsCard: 启用日志 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 按日期保存日志 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 退出时确认 → ToggleSwitch" />
                        </TreeViewItem>
                        <TreeViewItem Header='TextBlock "配置"'>
                            <TreeViewItem Header="TextBlock: 配置说明" />
                            <TreeViewItem Header="SettingsCard: 配置方案 → ComboBox" />
                            <TreeViewItem Header="SettingsCard → Button: 删除 / Button: 另存为" />
                        </TreeViewItem>
                    </TreeViewItem>
                </TreeViewItem>
                <TreeViewItem Header="主界面">
                    <TreeViewItem Header="窗口">
                        <TreeViewItem Header='TextBlock "窗口设置"' IsExpanded="True">
                            <TreeViewItem Header="LabeledSettingsCard: 无焦点模式 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 无边框模式 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 窗口 Chrome 渲染 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 避免全屏辅助 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 多屏支持 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 跟随鼠标屏幕 → ToggleSwitch（多屏开时可见）" />
                            <TreeViewItem Header="SettingsExpander: 窗口置顶 → ToggleSwitch（开则展开）">
                                <TreeViewItem Header="SettingsCard: 置顶模式 → RadioButton × 2" />
                                <TreeViewItem Header="SettingsCard: 重启按钮 → Button" />
                            </TreeViewItem>
                        </TreeViewItem>
                    </TreeViewItem>
                    <TreeViewItem Header="个性化" IsExpanded="True">
                        <TreeViewItem Header='TextBlock "主题"'>
                            <TreeViewItem Header="SettingsCard: 主题 → ComboBox" />
                            <TreeViewItem Header="SettingsCard: 窗口背景材质 → ComboBox" />
                            <TreeViewItem Header="SettingsCard: 语言 → ComboBox" />
                        </TreeViewItem>
                        <TreeViewItem Header='TextBlock "浮动栏图标"' IsExpanded="True">
                            <TreeViewItem Header="SettingsCard: 浮动栏图标 → ComboBox" />
                            <TreeViewItem Header="Button: 上传自定义 + Button: 管理自定义" />
                            <TreeViewItem Header="SettingsCard: 黑板缩放比例 → Slider" />
                            <TreeViewItem Header="LabeledSettingsCard: 画板模式显示时间 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 使用24小时制 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 画板模式显示鸡汤 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsCard: 鸡汤来源 → ComboBox + Button" />
                            <TreeViewItem Header="LabeledSettingsCard: 启用快捷面板 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsCard: 快捷面板底部偏移 → Slider" />
                            <TreeViewItem Header="SettingsCard: 展开按钮图标 → ComboBox" />
                        </TreeViewItem>
                        <TreeViewItem Header='TextBlock "浮动栏按钮"'>
                            <TreeViewItem Header="LabeledSettingsCard: 使用旧版浮动栏 UI → ToggleSwitch" />
                            <TreeViewItem Header="SettingsCard: 浮动栏按钮 → Clickable" />
                        </TreeViewItem>
                    </TreeViewItem>
                    <TreeViewItem Header="快捷键">
                        <TreeViewItem Header="InfoBar: 快捷键说明" />
                        <TreeViewItem Header='TextBlock "鼠标模式"'>
                            <TreeViewItem Header="LabeledSettingsCard: 鼠标模式下启用快捷键 → ToggleSwitch" />
                        </TreeViewItem>
                        <TreeViewItem Header='TextBlock "基本操作"'>
                            <TreeViewItem Header="HotkeyItem: 撤销" />
                            <TreeViewItem Header="HotkeyItem: 重做" />
                            <TreeViewItem Header="HotkeyItem: 清除" />
                            <TreeViewItem Header="HotkeyItem: 粘贴" />
                        </TreeViewItem>
                        <TreeViewItem Header='TextBlock "工具切换"'>
                            <TreeViewItem Header="HotkeyItem: 选择工具" />
                            <TreeViewItem Header="HotkeyItem: 画笔工具" />
                            <TreeViewItem Header="HotkeyItem: 橡皮擦工具" />
                            <TreeViewItem Header="HotkeyItem: 黑板工具" />
                            <TreeViewItem Header="HotkeyItem: 退出画笔工具" />
                        </TreeViewItem>
                        <TreeViewItem Header='TextBlock "画笔设置"'>
                            <TreeViewItem Header="HotkeyItem: 画笔 1" />
                            <TreeViewItem Header="HotkeyItem: 画笔 2" />
                            <TreeViewItem Header="HotkeyItem: 画笔 3" />
                            <TreeViewItem Header="HotkeyItem: 画笔 4" />
                            <TreeViewItem Header="HotkeyItem: 画笔 5" />
                        </TreeViewItem>
                        <TreeViewItem Header='TextBlock "功能快捷键"'>
                            <TreeViewItem Header="HotkeyItem: 画直线" />
                            <TreeViewItem Header="HotkeyItem: 截图" />
                            <TreeViewItem Header="HotkeyItem: 快速画笔" />
                            <TreeViewItem Header="HotkeyItem: 隐藏" />
                            <TreeViewItem Header="HotkeyItem: 退出" />
                        </TreeViewItem>
                        <TreeViewItem Header="Button: 恢复默认 + Button: 保存设置" />
                    </TreeViewItem>
                </TreeViewItem>
                <TreeViewItem Header="画板设置">
                    <TreeViewItem Header="画布" IsExpanded="True">
                        <TreeViewItem Header='TextBlock "画布"' IsExpanded="True">
                            <TreeViewItem Header="LabeledSettingsCard: 显示笔光标 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 启用压感触控 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 忽略压感 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsCard: 橡皮擦大小 → ComboBox" />
                            <TreeViewItem Header="LabeledSettingsCard: 选择时隐藏墨迹 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 清除画布同时清除历史 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 清除画布同时清除图片 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 压缩上传图片 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 白板展台启动希沃视频展台 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsCard: 保留双曲线渐近线 → ComboBox" />
                            <TreeViewItem Header="LabeledSettingsCard: 显示圆心 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 显示坐标单位刻度 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsCard: 曲线平滑模式 → ComboBox" />
                            <TreeViewItem Header="SettingsExpander: 画笔自动恢复 → ToggleSwitch（开则展开）">
                                <TreeViewItem Header="SettingsCard: 自动恢复时间点 → TextBox" />
                                <TreeViewItem Header="SettingsCard: 恢复颜色 → ComboBox" />
                                <TreeViewItem Header="SettingsCard: 恢复宽度 → Slider" />
                                <TreeViewItem Header="SettingsCard: 恢复透明度 → Slider" />
                            </TreeViewItem>
                            <TreeViewItem Header="SettingsExpander: 橡皮擦后自动切回 → ToggleSwitch（开则展开）">
                                <TreeViewItem Header="SettingsCard: 切回延迟 → Slider" />
                            </TreeViewItem>
                        </TreeViewItem>
                        <TreeViewItem Header='TextBlock "手势"'>
                            <TreeViewItem Header="LabeledSettingsCard: 允许旋转缩放 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsExpander: 手掌擦除 → ToggleSwitch（开则展开）">
                                <TreeViewItem Header="SettingsCard: 手掌擦除灵敏度 → ComboBox" />
                            </TreeViewItem>
                        </TreeViewItem>
                    </TreeViewItem>
                    <TreeViewItem Header="墨迹识别">
                        <TreeViewItem Header='TextBlock "墨迹识别"' IsExpanded="True">
                            <TreeViewItem Header="LabeledSettingsCard: 启用墨迹识别 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsCard: 形状识别引擎 → ComboBox" />
                            <TreeViewItem Header="LabeledSettingsCard: 手写美化 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsCard: 手写美化字体 → ComboBox（手写美化开时可见）" />
                            <TreeViewItem Header="LabeledSettingsCard: 矩形块假压感 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 三角形块假压感 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsExpander: 形状修正（墨迹识别开则展开）">
                                <TreeViewItem Header="SettingsCard → CheckBox: 修正三角形" />
                                <TreeViewItem Header="SettingsCard → CheckBox: 修正矩形" />
                                <TreeViewItem Header="SettingsCard → CheckBox: 修正椭圆" />
                            </TreeViewItem>
                            <TreeViewItem Header="SettingsExpander: 自动直线 → ToggleSwitch（开则展开）">
                                <TreeViewItem Header="SettingsCard: 长度阈值 → Slider" />
                                <TreeViewItem Header="SettingsCard: 灵敏度 → Slider" />
                                <TreeViewItem Header="SettingsCard: 高精度直线 → ToggleSwitch" />
                                <TreeViewItem Header="SettingsCard: 暂停直线 → ToggleSwitch" />
                                <TreeViewItem Header="SettingsCard: 暂停延迟 → Slider" />
                            </TreeViewItem>
                            <TreeViewItem Header="SettingsExpander: 线段端点吸附 → ToggleSwitch（开则展开）">
                                <TreeViewItem Header="SettingsCard: 吸附距离 → Slider" />
                            </TreeViewItem>
                        </TreeViewItem>
                    </TreeViewItem>
                </TreeViewItem>
                <TreeViewItem Header="PPT联动" IsExpanded="True">
                    <TreeViewItem Header='TextBlock "PPT联动"'>
                        <TreeViewItem Header="LabeledSettingsCard: 支持 PowerPoint → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: PPT增强 → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: 跳过动画 → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: 使用 Rot PPT 链接 → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: 支持 WPS → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: 杀死 WPP 进程 → ToggleSwitch" />
                    </TreeViewItem>
                    <TreeViewItem Header='TextBlock "翻页按钮"' IsExpanded="True">
                        <TreeViewItem Header="LabeledSettingsCard: 显示翻页按钮 → ToggleSwitch" />
                        <TreeViewItem Header="SettingsExpander: 左侧按钮 → CheckBox（翻页按钮开则展开）">
                            <TreeViewItem Header="SettingsCard: 左侧偏移 → Slider" />
                            <TreeViewItem Header="SettingsCard: 左侧透明度 → Slider" />
                        </TreeViewItem>
                        <TreeViewItem Header="SettingsExpander: 右侧按钮 → CheckBox（翻页按钮开则展开）">
                            <TreeViewItem Header="SettingsCard: 右侧偏移 → Slider" />
                            <TreeViewItem Header="SettingsCard: 右侧透明度 → Slider" />
                        </TreeViewItem>
                        <TreeViewItem Header="SettingsExpander: 左下按钮 → CheckBox（翻页按钮开则展开）">
                            <TreeViewItem Header="SettingsCard: 左下偏移 → Slider" />
                            <TreeViewItem Header="SettingsCard: 左下透明度 → Slider" />
                        </TreeViewItem>
                        <TreeViewItem Header="SettingsExpander: 右下按钮 → CheckBox（翻页按钮开则展开）">
                            <TreeViewItem Header="SettingsCard: 右下偏移 → Slider" />
                            <TreeViewItem Header="SettingsCard: 右下透明度 → Slider" />
                        </TreeViewItem>
                        <TreeViewItem Header="SettingsCard: 侧边组 → CheckBox × 3" />
                        <TreeViewItem Header="SettingsCard: 底部组 → CheckBox × 3" />
                        <TreeViewItem Header="LabeledSettingsCard: 页码按钮可点击 → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: 增强预览 → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: 长按翻页 → ToggleSwitch" />
                    </TreeViewItem>
                    <TreeViewItem Header='TextBlock "进入放映时进入批注"'>
                        <TreeViewItem Header="LabeledSettingsCard: 进入放映时进入批注 → ToggleSwitch" />
                    </TreeViewItem>
                    <TreeViewItem Header='TextBlock "PPT设置"'>
                        <TreeViewItem Header="LabeledSettingsCard: 双指手势 → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: 手势翻页 → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: 时间胶囊 → ToggleSwitch" />
                        <TreeViewItem Header="SettingsCard: 时间胶囊位置 → ComboBox" />
                        <TreeViewItem Header="SettingsCard: 时间胶囊透明度 → Slider" />
                        <TreeViewItem Header="SettingsCard: 时间胶囊缩放 → Slider" />
                        <TreeViewItem Header="SettingsCard: 时间胶囊重置位置 → Button" />
                        <TreeViewItem Header="LabeledSettingsCard: 放映时显示快捷面板 → ToggleSwitch" />
                    </TreeViewItem>
                    <TreeViewItem Header='TextBlock "自动截图"'>
                        <TreeViewItem Header="LabeledSettingsCard: 自动截图 → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: 自动保存墨迹 → ToggleSwitch" />
                    </TreeViewItem>
                    <TreeViewItem Header='TextBlock "记住上次页面"'>
                        <TreeViewItem Header="LabeledSettingsCard: 记住上次页面 → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: 重新进入时跳到第一页 → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: 通知隐藏页面 → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: 通知自动播放 → ToggleSwitch" />
                    </TreeViewItem>
                </TreeViewItem>
                <TreeViewItem Header="更新">
                    <TreeViewItem Header="状态横幅（当前版本/更新状态）" />
                    <TreeViewItem Header="TabControl" IsExpanded="True">
                        <TreeViewItem Header="Tab: 更新日志">
                            <TreeViewItem Header="MarkdownScrollViewer" />
                        </TreeViewItem>
                        <TreeViewItem Header="Tab: 更新设置" IsExpanded="True">
                            <TreeViewItem Header='TextBlock "自动更新"'>
                                <TreeViewItem Header="LabeledSettingsCard: 自动更新 → ToggleSwitch" />
                                <TreeViewItem Header="LabeledSettingsCard: 静默更新 → ToggleSwitch（自动更新开时可见）" />
                                <TreeViewItem Header="LabeledSettingsCard: 智能更新 → ToggleSwitch" />
                                <TreeViewItem Header="SettingsExpander: 静默更新时间范围（静默更新开则展开）">
                                    <TreeViewItem Header="SettingsCard: 时间范围设置 → ComboBox × 2" />
                                    <TreeViewItem Header="SettingsCard: 时间段说明" />
                                </TreeViewItem>
                            </TreeViewItem>
                            <TreeViewItem Header='TextBlock "更新通道"'>
                                <TreeViewItem Header="SettingsCard: 更新通道 → ComboBox" />
                                <TreeViewItem Header="SettingsCard: 更新包架构 → ComboBox" />
                            </TreeViewItem>
                            <TreeViewItem Header='TextBlock "维护"'>
                                <TreeViewItem Header="SettingsCard: 版本修复 → Button" />
                            </TreeViewItem>
                        </TreeViewItem>
                        <TreeViewItem Header="Tab: 历史版本">
                            <TreeViewItem Header="SettingsCard: 选择版本 → ComboBox" />
                            <TreeViewItem Header="MarkdownScrollViewer" />
                            <TreeViewItem Header="Button: 回滚到此版本" />
                        </TreeViewItem>
                    </TreeViewItem>
                </TreeViewItem>
                <TreeViewItem Header="通知" IsExpanded="True">
                    <TreeViewItem Header="通知设置" IsExpanded="True">
                        <TreeViewItem Header='TextBlock "通知"'>
                            <TreeViewItem Header="LabeledSettingsCard: 启用公告 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 启用强制弹窗 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsCard: 公告中心 → Button" />
                            <TreeViewItem Header="LabeledSettingsCard: 启用动态 → ToggleSwitch" />
                            <TreeViewItem Header="LabeledSettingsCard: 启用 Windows 通知 → ToggleSwitch" />
                            <TreeViewItem Header="SettingsExpander: 听写免打扰 → ToggleSwitch（开则展开）">
                                <TreeViewItem Header="SettingsCard: PPT 模式免打扰 → CheckBox" />
                                <TreeViewItem Header="SettingsCard: 白板模式免打扰 → CheckBox" />
                            </TreeViewItem>
                        </TreeViewItem>
                        <TreeViewItem Header='TextBlock "通知提供商"'>
                            <TreeViewItem Header="SettingsCard: 通知提供商管理 → Button" />
                            <TreeViewItem Header="ItemsControl: 提供商列表（动态）" />
                        </TreeViewItem>
                        <TreeViewItem Header='TextBlock "行为"'>
                            <TreeViewItem Header="SettingsCard: 通知位置 → ComboBox" />
                            <TreeViewItem Header="SettingsCard: 动画模式 → ComboBox" />
                            <TreeViewItem Header="SettingsCard: 更新通知持续时间 → Slider" />
                            <TreeViewItem Header="SettingsCard: 紧急通知持续时间 → Slider" />
                            <TreeViewItem Header="SettingsCard: 重要通知持续时间 → Slider" />
                            <TreeViewItem Header="SettingsCard: 提醒通知持续时间 → Slider" />
                            <TreeViewItem Header="SettingsCard: 其他通知持续时间 → Slider" />
                        </TreeViewItem>
                        <TreeViewItem Header='TextBlock "操作"'>
                            <TreeViewItem Header="SettingsCard: 测试通知 → Button" />
                        </TreeViewItem>
                    </TreeViewItem>
                    <TreeViewItem Header="公告中心">
                        <TreeViewItem Header='TextBlock "无"'>
                            <TreeViewItem Header="Button: 全部标为已读" />
                            <TreeViewItem Header="Button: 清空历史" />
                        </TreeViewItem>
                    </TreeViewItem>
                </TreeViewItem>
                <TreeViewItem Header="实验性">
                    <TreeViewItem Header='TextBlock "无"'>
                        <TreeViewItem Header="LabeledSettingsCard: 全屏辅助 → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: 边缘手势工具 → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: 强制全屏 → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: DPI 变更检测 → ToggleSwitch" />
                        <TreeViewItem Header="LabeledSettingsCard: 分辨率变更检测 → ToggleSwitch" />
                    </TreeViewItem>
                </TreeViewItem>
                <TreeViewItem Header="存储" IsExpanded="True">
                    <TreeViewItem Header="存储管理" IsExpanded="True">
                        <TreeViewItem Header='TextBlock "存储管理"'>
                            <TreeViewItem Header="概览卡片（总用量 + 占比柱状图 + 图例）" />
                            <TreeViewItem Header="Button: 刷新 + Button: 打开应用文件夹" />
                        </TreeViewItem>
