<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Ink_Canvas.Controls</RootNamespace>
    <AssemblyName>InkCanvas.Controls</AssemblyName>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>10</LangVersion>
    <NoWarn>CA1416;CS1591</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- NuGet 打包元数据。包版本号由 Nerdbank.GitVersioning 依据 version.json 自动生成，无需手动维护。
       手动发版时可用 -p:NBGV_OverrideVersion=x.y.z 强制指定。 -->
  <PropertyGroup>
    <PackageId>InkCanvas.Controls</PackageId>
    <Authors>InkCanvasForClass</Authors>
    <Description>InkCanvas 墨迹白板（ICC-CE）插件共用 WPF 控件库：工具栏按钮、颜色选择、设置卡片等，供插件 UI 与宿主视觉风格保持一致。</Description>
    <PackageTags>wpf;controls;whiteboard;plugin;inkcanvas</PackageTags>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/InkCanvasForClass/community</PackageProjectUrl>
    <RepositoryUrl>https://github.com/InkCanvasForClass/community</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- NuGet 包元数据：图标与 README 让 nuget.org 详情页更好看。 -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 组织维护的非官方 fork：包 ID 为 InkCanvasForClass.UI.WPF.Modern，程序集仍叫 iNKORE.UI.WPF.Modern。
         走普通包引用后，本工程打包（InkCanvas.Controls）生成的 nuspec 依赖也指向这个包，符合预期。 -->
    <PackageReference Include="InkCanvasForClass.UI.WPF.Modern" Version="0.11.0-icc.7df536a" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="iNKORE.UI.WPF" Version="1.2.8" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.303" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet 包图标（128x128 PNG，复用仓库 icc.png）。 -->
    <None Include="icon.png" Pack="True" PackagePath="" />
    <!-- NuGet 包详情页显示的 README。 -->
    <None Include="README.md" Pack="True" PackagePath="" />
  </ItemGroup>

</Project>
