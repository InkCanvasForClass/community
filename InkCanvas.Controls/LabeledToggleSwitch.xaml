<UserControl x:Class="Ink_Canvas.Controls.LabeledToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta">
    <!-- 原生 StackPanel 没有 Spacing 属性（.NET 10 WPF 仍未提供），改用 Violeta 的 SimpleStackPanel。 -->
    <vio:SimpleStackPanel Spacing="4">
        <vio:SimpleStackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       VerticalAlignment="Center"
                       Foreground="#fafafa"
                       FontSize="14"
                       Margin="0,0,16,0"/>
            <ui:ToggleSwitch x:Name="ToggleSwitch"
                              IsChecked="{Binding IsOn, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                              FontWeight="Bold"
                              Checked="ToggleSwitch_Checked"
                              Unchecked="ToggleSwitch_Unchecked"/>
        </vio:SimpleStackPanel>
        <TextBlock x:Name="HintTextBlock"
                   Text="{Binding Hint, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   TextWrapping="Wrap"
                   Foreground="#a1a1aa"
                   Visibility="Collapsed"/>
    </vio:SimpleStackPanel>
</UserControl>