<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Ink_Canvas.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
      SettingsCard 默认样式。

      重要：这里【不能】设置 OverridesDefaultStyle —— WPF 禁止在默认（隐式）样式里设置该属性，
      会抛 InvalidOperationException「无法在默认 Style 中设置 OverridesDefaultStyle 属性」，
      进而导致所有使用 SettingsCard 的页面加载失败。
    -->
    <Style TargetType="{x:Type controls:SettingsCard}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,16,14,16" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsCard}">
                    <Border x:Name="RootBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 左侧图标（可选） -->
                            <ContentControl x:Name="IconHost"
                                            Grid.Column="0"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center"
                                            Content="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                            Focusable="False"
                                            FontSize="24" />

                            <!-- 标题 + 说明 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ContentPresenter x:Name="HeaderPresenter"
                                                  Content="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                <TextBlock x:Name="DescriptionText"
                                           Margin="0,2,0,0"
                                           Text="{Binding Description, RelativeSource={RelativeSource TemplatedParent}}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- 右侧内容 -->
                            <ContentPresenter x:Name="ContentPresenter"
                                              Grid.Column="2"
                                              Margin="14,0,0,0"
                                              HorizontalAlignment="{Binding ContentAlignment, RelativeSource={RelativeSource TemplatedParent}}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- 无内容时去掉右侧间距 -->
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ContentPresenter" Property="Margin" Value="0" />
                        </Trigger>
                        <!-- 无说明文字时整行隐藏 -->
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- 无图标时隐藏并去掉左边距 -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconHost" Property="Margin" Value="0" />
                        </Trigger>
                        <!-- 不可点击时不显示手型光标 -->
                        <Trigger Property="IsClickEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      SettingsExpander 默认样式。

      基于 WPF-UI 的 DefaultCardExpanderStyle（保留其展开/折叠动画与 Chevron 箭头），
      只在 Header 区追加一行说明文字。
      同样【不能】设置 OverridesDefaultStyle（WPF 会抛 InvalidOperationException）。
    -->
    <Style TargetType="{x:Type controls:SettingsExpander}"
           BasedOn="{StaticResource DefaultCardExpanderStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsExpander}">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 标题区：Icon + Header/Description + 箭头 -->
                            <ToggleButton Grid.Row="0"
                                          x:Name="ToggleButton"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="Stretch"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl x:Name="IconHost"
                                                    Grid.Column="0"
                                                    Margin="0,0,14,0"
                                                    VerticalAlignment="Center"
                                                    Content="{TemplateBinding Icon}"
                                                    Focusable="False"
                                                    FontSize="24" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ContentPresenter Content="{TemplateBinding Header}"
                                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                                        <TextBlock x:Name="DescriptionText"
                                                   Margin="0,2,0,0"
                                                   Text="{TemplateBinding Description}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ui:SymbolIcon Grid.Column="2"
                                                   x:Name="ChevronIcon"
                                                   Symbol="ChevronDown24"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"
                                                   Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                            </ToggleButton>

                            <!-- 展开内容：用 ItemsControl 呈现 Items 集合（默认内容属性已指向 Items，
                                 故 XAML 里的多个直接子元素都会进这里） -->
                            <ItemsControl x:Name="ItemsHost"
                                          Grid.Row="1"
                                          Margin="{TemplateBinding ContentPadding}"
                                          ItemsSource="{TemplateBinding Items}"
                                          ItemTemplate="{TemplateBinding ItemTemplate}"
                                          ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          TextElement.Foreground="{TemplateBinding Foreground}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ChevronIcon" Property="Symbol" Value="ChevronUp24" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconHost" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>