<UserControl x:Class="Ink_Canvas.Controls.PopupTabTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             mc:Ignorable="d" d:Width="300">
    <Border x:Name="RootBorder" BorderBrush="#1e3a8a" Height="32"
            BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Background="#2563eb"
            Margin="-1,-1,-1,0" Padding="1,1,1,0">
        <ikw:SimpleStackPanel Orientation="Vertical" VerticalAlignment="Center">
            <DockPanel>
                <ui:FontIcon x:Name="CloseIcon" DockPanel.Dock="Right"
                             Icon="{x:Static ui:SegoeFluentIcons.ChromeCloseContrast}"
                             Foreground="White" FontSize="16" VerticalAlignment="Center"
                             Margin="8,0,8,0" />
                <ikw:SimpleStackPanel x:Name="TabsPanel" Orientation="Horizontal"
                                      Margin="8,0,0,0" Spacing="2" />
            </DockPanel>
        </ikw:SimpleStackPanel>
    </Border>
</UserControl>
