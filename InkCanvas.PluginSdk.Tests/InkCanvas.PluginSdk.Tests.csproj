<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InkCanvas.PluginSdk\InkCanvas.PluginSdk.csproj" />
    <Compile Include="..\Ink Canvas\Helpers\TimeMachine.cs" Link="Helpers\TimeMachine.cs" />
    <Compile Include="..\Ink Canvas\Plugins\PluginCanvasToolSession.cs" Link="Plugins\PluginCanvasToolSession.cs" />
    <Compile Include="..\Ink Canvas\Plugins\PluginCanvasResourceCleanup.cs" Link="Plugins\PluginCanvasResourceCleanup.cs" />
    <Compile Include="..\Ink Canvas\Plugins\PluginWhiteboardStateStore.cs" Link="Plugins\PluginWhiteboardStateStore.cs" />
    <Compile Include="..\Ink Canvas\Plugins\PluginCompatibility.cs" Link="Plugins\PluginCompatibility.cs" />
    <Compile Include="..\Ink Canvas\Plugins\PluginSettingsNavigationRegistry.cs" Link="Plugins\PluginSettingsNavigationRegistry.cs" />
    <Compile Include="..\Ink Canvas\Properties\PluginStrings.Designer.cs" Link="Properties\PluginStrings.Designer.cs" />
    <EmbeddedResource Include="..\Ink Canvas\Properties\PluginStrings.resx" Link="Properties\PluginStrings.resx">
      <LogicalName>Ink_Canvas.Properties.PluginStrings.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Ink Canvas\Properties\PluginStrings.en-US.resx" Link="Properties\PluginStrings.en-US.resx">
      <LogicalName>Ink_Canvas.Properties.PluginStrings.en-US.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Ink Canvas\Properties\PluginStrings.zh-ME.resx" Link="Properties\PluginStrings.zh-ME.resx">
      <LogicalName>Ink_Canvas.Properties.PluginStrings.zh-ME.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
