<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:compat="clr-namespace:WpfUiCompat.Controls"
    xmlns:keys="clr-namespace:WpfUiCompat.Common.IconKeys">

    <!-- ============ SettingsCard ============ -->
    <Style TargetType="compat:SettingsCard">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,14,16,14"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="compat:SettingsCard">
                    <Border
                        x:Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4,4,4,4"
                        Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ContentPresenter
                                Grid.Column="0" Grid.Row="0"
                                x:Name="PART_HeaderIcon"
                                Content="{TemplateBinding HeaderIcon}"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0"
                                TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                            <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <ContentPresenter
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    TextElement.FontWeight="SemiBold"
                                    TextElement.Foreground="{TemplateBinding Foreground}"
                                    VerticalAlignment="Center"/>
                                <ContentPresenter
                                    x:Name="PART_Description"
                                    Content="{TemplateBinding Description}"
                                    TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextElement.FontSize="12"
                                    Margin="0,2,0,0"
                                    VerticalAlignment="Center"/>
                            </StackPanel>

                            <ContentPresenter
                                x:Name="PART_ActionIcon"
                                Grid.Column="2" Grid.Row="0"
                                Content="{TemplateBinding ActionIcon}"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"/>                            <ContentPresenter
                                x:Name="PART_Content"
                                Grid.Column="2" Grid.Row="0"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="0,0,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HeaderIcon" Value="{x:Null}">
                            <Setter TargetName="PART_HeaderIcon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="PART_Description" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ContentAlignment" Value="Left">
                            <Setter TargetName="PART_Content" Property="HorizontalAlignment" Value="Left"/>
                            <Setter TargetName="PART_Content" Property="Grid.Column" Value="2"/>
                        </Trigger>
                        <Trigger Property="ContentAlignment" Value="Right">
                            <Setter TargetName="PART_Content" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="ContentAlignment" Value="Vertical">
                            <Setter TargetName="PART_Content" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="PART_Content" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="PART_Content" Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter TargetName="PART_Content" Property="Margin" Value="0,8,0,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ SettingsExpander ============ -->
    <Style TargetType="compat:SettingsExpander">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,14,16,14"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="compat:SettingsExpander">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4,4,4,4"
                        ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 标题行 -->
                            <ToggleButton
                                x:Name="PART_ExpanderToggle"
                                Grid.Row="0"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Focusable="False"
                                Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                        Grid.Column="0"
                                        x:Name="PART_HeaderIcon"
                                        Content="{TemplateBinding HeaderIcon}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,14,0"
                                        TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <ContentPresenter
                                            Content="{TemplateBinding Header}"
                                            TextElement.FontWeight="SemiBold"
                                            TextElement.Foreground="{TemplateBinding Foreground}"
                                            VerticalAlignment="Center"/>
                                        <ContentPresenter
                                            x:Name="PART_Description"
                                            Content="{TemplateBinding Description}"
                                            TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            TextElement.FontSize="12"
                                            Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <ContentPresenter
                                        Grid.Column="2"
                                        Content="{TemplateBinding Content}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"/>

                                    <compat:FontIcon
                                        Grid.Column="3"
                                        Icon="{x:Static keys:SegoeFluentIcons.ChevronDown}"
                                        FontSize="14"
                                        VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <compat:FontIcon.RenderTransform>
                                            <RotateTransform x:Name="PART_ChevronTransform" Angle="0"/>
                                        </compat:FontIcon.RenderTransform>
                                    </compat:FontIcon>
                                </Grid>
                            </ToggleButton>

                            <!-- 展开区域 -->
                            <StackPanel x:Name="PART_ItemsHost" Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}" ItemTemplate="{TemplateBinding ItemTemplate}"/>
                                <ContentPresenter
                                    x:Name="PART_ExpandedContent"
                                    Content="{TemplateBinding Content}"
                                    Margin="16,4,16,8"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="PART_ItemsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_ChevronTransform" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_ChevronTransform" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="HeaderIcon" Value="{x:Null}">
                            <Setter TargetName="PART_HeaderIcon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="PART_Description" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>