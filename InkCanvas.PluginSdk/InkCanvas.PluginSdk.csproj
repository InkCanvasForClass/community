<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Ink_Canvas.Plugins</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- NuGet 打包元数据。包版本号由 Nerdbank.GitVersioning 依据 version.json 自动生成，无需手动维护。
       手动发版时可用 -p:NBGV_OverrideVersion=x.y.z 强制指定。 -->
  <PropertyGroup>
    <PackageId>InkCanvas.PluginSdk</PackageId>
    <Authors>InkCanvasForClass</Authors>
    <Description>InkCanvas 墨迹白板（ICC-CE）插件开发 SDK：提供插件接口、宿主服务抽象、API 兼容性声明以及 .icpx 打包支持。插件项目通过 PackageReference 引用本包后自动获得 CreateIcpx 打包能力。</Description>
    <PackageTags>wpf;ink;whiteboard;plugin;sdk;inkcanvas;ppt;classisland</PackageTags>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/InkCanvasForClass/community</PackageProjectUrl>
    <RepositoryUrl>https://github.com/InkCanvasForClass/community</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1570;CS1573;CS1574</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <!-- 自包含引用 Nerdbank.GitVersioning：HostApiRequirement 使用 ThisAssembly.AssemblyFileVersion（NBGV 源生成）。
         独立构建本 SDK（如 InkCanvas.PluginSdk 仓库的 sync-and-build 工作流）时不会带上仓库根 Directory.Build.props，
         必须在此显式引用才能生成 ThisAssembly。
         社区仓库内构建时 Directory.Build.props 已统一注入 NBGV（标记 NBGVProvidedByDirectoryBuildProps=true），
         跳过此处引用以避免 NU1504 重复包引用。 -->
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.9.50" PrivateAssets="All"
                      Condition="'$(NBGVProvidedByDirectoryBuildProps)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="InkCanvas.PluginSdk.targets" Pack="True" PackagePath="build\net10.0-windows10.0.19041.0" />
  </ItemGroup>

</Project>
