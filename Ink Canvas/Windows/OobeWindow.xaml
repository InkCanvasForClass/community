<?xml version="1.0" encoding="utf-8"?><Window xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.OobeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta" xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls" xmlns:sys="clr-namespace:System;assembly=mscorlib" mc:Ignorable="d" Title="{x:Static props:OobeStrings.Oobe_WelcomeTitle}" Height="700" Width="1080" MinHeight="520" MinWidth="880" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Topmost="True" Loaded="OobeWindow_OnLoaded" Closing="OobeWindow_OnClosing" StateChanged="OobeWindow_OnStateChanged">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>

            <Style x:Key="SettingsSectionHeaderTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="1,2,0,6" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent" IsHitTestVisible="True" Canvas.ZIndex="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="137" />
                </Grid.ColumnDefinitions>
                <vio:SimpleStackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="\Resources\icc.ico" Width="18" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Static props:OobeStrings.Oobe_WelcomeTitle}" TextWrapping="NoWrap" />
                </vio:SimpleStackPanel>

                <Rectangle Grid.Column="2" Width="138" />
            </Grid>
        </Border>

        <!-- 主体: 左侧导航 + 内容 -->
        <ui:NavigationView x:Name="NavView" Grid.Row="1" PaneDisplayMode="Left" IsPaneOpen="True" IsBackButtonVisible="Collapsed" OpenPaneLength="240" SelectionChanged="NavView_SelectionChanged">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="NavItemWelcome" Content="{x:Static props:OobeStrings.Oobe_NavWelcome}" Tag="welcome">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem x:Name="NavItemTelemetry" Content="{x:Static props:OobeStrings.Oobe_NavTelemetry}" Tag="step0">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Shield24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavItemCanvas" Content="{x:Static props:OobeStrings.Oobe_NavCanvas}" Tag="step1">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Edit24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavItemGestures" Content="{x:Static props:OobeStrings.Oobe_NavGestures}" Tag="step2">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="HandDraw24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavItemAppearance" Content="{x:Static props:ThemeStrings.Theme_GroupTitle}" Tag="step3">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PaintBrush24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavItemPPT" Content="{x:Static props:OobeStrings.Oobe_NavPPT}" Tag="step4">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="SlideTransition24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavItemAutomation" Content="{x:Static props:OobeStrings.Oobe_NavAutomation}" Tag="step5">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavItemLuckyRandom" Content="{x:Static props:RandomStrings.Random_Title}" Tag="step6">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="People24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavItemAdvanced" Content="{x:Static props:OobeStrings.Oobe_NavAdvanced}" Tag="step7">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem x:Name="NavItemFinish" Content="{x:Static props:OobeStrings.Oobe_NavFinish}" Tag="finish">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Checkmark24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.ContentOverlay><Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 内容区 -->
                <Grid Grid.Row="0" ClipToBounds="True">

                    <!-- 欢迎页 (居中布局, 不进 ScrollViewer 的滚动条) -->
                    <Grid x:Name="WelcomePanel" Visibility="Visible">
                        <vio:SimpleStackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640" Spacing="16">
                            <Border Width="96" Height="96" HorizontalAlignment="Center" CornerRadius="20" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                <Image Source="\Resources\icc.ico" Width="64" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <TextBlock Text="{x:Static props:OobeStrings.Oobe_WelcomeTitle}" Style="{DynamicResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" />

                            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.85" Style="{DynamicResource BodyTextBlockStyle}" Text="{x:Static props:OobeStrings.Oobe_WelcomeDesc}" />

                            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.6" Style="{DynamicResource CaptionTextBlockStyle}" Text="{x:Static props:OobeStrings.Oobe_StepCount}" />

                            <ui:Button x:Name="BtnStartWelcome" HorizontalAlignment="Center" MinWidth="180" Height="36" Margin="0,12,0,0" Click="BtnStartWelcome_Click" Appearance="Primary">
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Static props:OobeStrings.Oobe_StartStepByStep}" />
                                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="12" />
                                </vio:SimpleStackPanel>
                            </ui:Button>

                            <Button x:Name="BtnUsePreset" HorizontalAlignment="Center" MinWidth="180" Height="36" Click="BtnUsePreset_Click">
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <ui:SymbolIcon Symbol="Wrench24" FontSize="12" />
                                    <TextBlock Text="{x:Static props:OobeStrings.Oobe_UsePreset}" />
                                </vio:SimpleStackPanel>
                            </Button>
                        </vio:SimpleStackPanel>
                    </Grid>

                    <!-- 步骤页 (8 个) -->
                    <ScrollViewer x:Name="StepScrollViewer" Visibility="Collapsed" PanningMode="VerticalFirst" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="40,16,40,0">
                            <vio:SimpleStackPanel x:Name="StepHost" MaxWidth="900" HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">
                                <vio:SimpleStackPanel.RenderTransform>
                                    <TranslateTransform x:Name="StepHostTransform" X="0" Y="0" />
                                </vio:SimpleStackPanel.RenderTransform>

                                <!-- 步骤标题 -->
                                <vio:SimpleStackPanel Margin="0,0,0,8" Spacing="2">
                                    <TextBlock x:Name="StepIndicatorText" Style="{DynamicResource CaptionTextBlockStyle}" Opacity="0.7" Text="步骤 1 / 8" />
                                    <TextBlock x:Name="StepTitleText" Style="{DynamicResource TitleTextBlockStyle}" Text="{x:Static props:OobeStrings.Oobe_Step1Title}" />
                                    <TextBlock x:Name="StepSubtitleText" Style="{DynamicResource BodyTextBlockStyle}" Margin="0,2,0,0" Opacity="0.85" TextWrapping="Wrap" Text="{x:Static props:OobeStrings.Oobe_Step1Subtitle}" />
                                </vio:SimpleStackPanel>

                                <!-- 步骤 1: 启动与隐私 -->
                                <vio:SimpleStackPanel x:Name="StepTelemetryPanel" Spacing="{StaticResource SettingsCardSpacing}">
                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:OobeStrings.Oobe_PrivacyTitle}" />

                                    <ui:CardExpander IsExpanded="True">
                                        <ui:CardExpander.Header>
                                            <StackPanel>
                                                <TextBlock Text="{x:Static props:OobeStrings.Oobe_PrivacyTitle}" />
                                                <TextBlock Text="{x:Static props:OobeStrings.Oobe_PrivacyDesc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </ui:CardExpander.Header>
                                        <ui:CardExpander.Icon>
                                            <ui:SymbolIcon Symbol="Shield24" />
                                        </ui:CardExpander.Icon>
                                        <StackPanel>
                                            <ui:CardControl>
                                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <CheckBox x:Name="CheckBoxPrivacyAccepted" VerticalAlignment="Center" Checked="CheckBoxPrivacyAccepted_Changed" Unchecked="CheckBoxPrivacyAccepted_Changed" Content="{x:Static props:OobeStrings.Oobe_AgreePrivacy}" />
                                                    <ui:HyperlinkButton Content="{x:Static props:OobeStrings.Oobe_PrivacyPolicy}" Padding="4,0" VerticalAlignment="Center" Click="HyperlinkPrivacy_Click" />
                                                </vio:SimpleStackPanel>
                                            </ui:CardControl>
                                            <ui:CardControl>
                                                <ui:CardControl.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Static props:OobeStrings.Oobe_TelemetryLevel}" />
                                                        <TextBlock Text="{x:Static props:OobeStrings.Oobe_TelemetryLevelDesc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </ui:CardControl.Header>
                                                <ComboBox x:Name="ComboBoxTelemetryUploadLevel">
                                                    <ComboBoxItem Content="{x:Static props:OobeStrings.Oobe_TelemetryNone}" />
                                                    <ComboBoxItem Content="{x:Static props:OobeStrings.Oobe_TelemetryBasic}" />
                                                    <ComboBoxItem Content="{x:Static props:OobeStrings.Oobe_TelemetryOptional}" />
                                                </ComboBox>
                                            </ui:CardControl>
                                        </StackPanel>
                                    </ui:CardExpander>

                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,18,0,6" Text="{x:Static props:OobeStrings.Oobe_StartupCrashTitle}" />

                                    <controls:LabeledSettingsCard x:Name="CardFoldAtStartup" Header="{x:Static props:OobeStrings.Oobe_FoldAtStartup}" Description="{x:Static props:OobeStrings.Oobe_FoldAtStartupDesc}" Symbol="ChevronLeft24" SwitchName="ToggleSwitchFoldAtStartup" />

                                    <controls:LabeledSettingsCard x:Name="CardAutoUpdate" Header="{x:Static props:UpdateStrings.Header_AutoUpdate}" Description="{x:Static props:OobeStrings.Oobe_AutoUpdate}" Symbol="ArrowSync24" SwitchName="ToggleSwitchAutoUpdate" />

                                    <ui:CardControl>
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{x:Static props:OobeStrings.Oobe_CrashAction}" />
                                                <TextBlock Text="{x:Static props:OobeStrings.Oobe_CrashActionDesc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:CardControl.Icon>
                                            <ui:SymbolIcon Symbol="Warning24" />
                                        </ui:CardControl.Icon>
                                        <ComboBox x:Name="ComboBoxCrashAction">
                                            <ComboBoxItem Content="{x:Static props:OobeStrings.Oobe_CrashSilentRestart}" />
                                            <ComboBoxItem Content="{x:Static props:OobeStrings.Oobe_CrashNoAction}" />
                                            <ComboBoxItem Content="{x:Static props:OobeStrings.Oobe_CrashShowDialog}" />
                                        </ComboBox>
                                    </ui:CardControl>
                                </vio:SimpleStackPanel>

                                <!-- 步骤 2: 画板与墨迹(含纠正) -->
                                <vio:SimpleStackPanel x:Name="StepCanvasPanel" Spacing="{StaticResource SettingsCardSpacing}" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:OobeStrings.Oobe_Step2Title}" />

                                    <controls:LabeledSettingsCard x:Name="CardShowCursor" Header="{x:Static props:CanvasStrings.Canvas_ShowPenCursor}" Description="{x:Static props:OobeStrings.Oobe_ShowPenCursorDesc}" Symbol="HandDraw24" SwitchName="ToggleSwitchShowCursor" />

                                    <controls:LabeledSettingsCard x:Name="CardDisablePressure" Header="{x:Static props:CanvasStrings.Canvas_IgnorePressure}" Description="{x:Static props:OobeStrings.Oobe_IgnorePressureDesc}" Symbol="Edit24" SwitchName="ToggleSwitchDisablePressure" />

                                    <controls:LabeledSettingsCard x:Name="CardHideStrokeWhenSelecting" Header="{x:Static props:OobeStrings.Oobe_HideInkOnExit}" Description="{x:Static props:OobeStrings.Oobe_HideInkOnExitDesc}" Symbol="EyeOff24" SwitchName="ToggleSwitchHideStrokeWhenSelecting" />

                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,18,0,6" Text="{x:Static props:CanvasStrings.InkRecog_Title}" />

                                    <controls:LabeledSettingsCard x:Name="CardInkToShapeEnabled" Header="{x:Static props:CanvasStrings.InkRecog_EnableInkRecognition}" Description="{x:Static props:OobeStrings.Oobe_InkRecogDesc}" Symbol="DrawImage24" SwitchName="ToggleSwitchInkToShapeEnabled" />
                                </vio:SimpleStackPanel>

                                <!-- 步骤 3: 手势 -->
                                <vio:SimpleStackPanel x:Name="StepGesturesPanel" Spacing="{StaticResource SettingsCardSpacing}" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:OobeStrings.Oobe_Step3Title}" />

                                    <controls:LabeledSettingsCard x:Name="CardTwoFingerZoom" Header="{x:Static props:OobeStrings.Oobe_EnableTwoFingerZoom}" Symbol="Eye24" SwitchName="ToggleSwitchTwoFingerZoom" />

                                    <controls:LabeledSettingsCard x:Name="CardTwoFingerTranslate" Header="{x:Static props:OobeStrings.Oobe_EnableTwoFingerPan}" Symbol="HandDraw24" SwitchName="ToggleSwitchTwoFingerTranslate" />

                                    <controls:LabeledSettingsCard x:Name="CardEnablePalmEraser" Header="{x:Static props:GestureStrings.Gesture_EnablePalmEraser}" Description="{x:Static props:OobeStrings.Oobe_PalmEraserDesc}" Symbol="Eraser24" SwitchName="ToggleSwitchEnablePalmEraser" />
                                </vio:SimpleStackPanel>

                                <!-- 步骤 4: 个性化 -->
                                <vio:SimpleStackPanel x:Name="StepAppearancePanel" Spacing="{StaticResource SettingsCardSpacing}" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:ThemeStrings.Theme_Label}" />

                                    <ui:CardControl>
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{x:Static props:OobeStrings.Oobe_AppTheme}" />
                                                <TextBlock Text="{x:Static props:OobeStrings.Oobe_AppThemeDesc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:CardControl.Icon>
                                            <ui:SymbolIcon Symbol="PaintBrush24" />
                                        </ui:CardControl.Icon>
                                        <ComboBox x:Name="ComboBoxTheme">
                                            <ComboBoxItem Content="{x:Static props:OobeStrings.Oobe_ThemeLight}" />
                                            <ComboBoxItem Content="{x:Static props:FloatingBarStrings.OldUI_Dark}" />
                                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_System}" />
                                        </ComboBox>
                                    </ui:CardControl>

                                    <ui:CardControl>
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{x:Static props:ThemeStrings.Theme_WindowBackdrop}" />
                                                <TextBlock Text="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Description}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:CardControl.Icon>
                                            <ui:SymbolIcon Symbol="FullScreenMaximize24" />
                                        </ui:CardControl.Icon>
                                        <ComboBox x:Name="ComboBoxWindowBackdrop" SelectionChanged="ComboBoxWindowBackdrop_SelectionChanged">
                                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_None}" Tag="None" />
                                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Mica}" Tag="Mica" />
                                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Acrylic}" Tag="Acrylic" />
                                            <ComboBoxItem Content="Tabbed" Tag="Tabbed" />
                                            <ComboBoxItem Content="Transient" Tag="Transient" />
                                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Acrylic10}" Tag="Acrylic10" />
                                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Acrylic11}" Tag="Acrylic11" />
                                        </ComboBox>
                                    </ui:CardControl>

                                    <controls:LabeledSettingsCard x:Name="CardEnableSplashScreen" Header="{x:Static props:ThemeStrings.Theme_EnableSplash}" Description="{x:Static props:OobeStrings.Oobe_ShowSplashScreenDesc}" Symbol="Image24" SwitchName="ToggleSwitchEnableSplashScreen" />

                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,18,0,6" Text="{x:Static props:OobeStrings.Oobe_TrayAndQuickPanel}" />

                                    <controls:LabeledSettingsCard x:Name="CardEnableTrayIcon" Header="{x:Static props:OobeStrings.Oobe_EnableTrayIcon}" Description="{x:Static props:OobeStrings.Oobe_EnableTrayIconDesc}" Symbol="Pin24" SwitchName="ToggleSwitchEnableTrayIcon" />

                                    <controls:LabeledSettingsCard x:Name="CardShowQuickPanel" Header="{x:Static props:OobeStrings.Oobe_EnableQuickPanel}" Description="{x:Static props:OobeStrings.Oobe_EnableQuickPanelDesc}" Symbol="Grid24" SwitchName="ToggleSwitchShowQuickPanel" />

                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,18,0,6" Text="{x:Static props:NavStrings.Nav_Shortcuts}" />

                                    <controls:LabeledSettingsCard x:Name="CardEnableHotkeysInMouseMode" Header="{x:Static props:OobeStrings.Oobe_EnableGlobalHotkeys}" Description="{x:Static props:OobeStrings.Oobe_EnableGlobalHotkeysDesc}" Symbol="Pen24" SwitchName="ToggleSwitchEnableHotkeysInMouseMode" />
                                </vio:SimpleStackPanel>

                                <!-- 步骤 5: PowerPoint -->
                                <vio:SimpleStackPanel x:Name="StepPPTPanel" Spacing="{StaticResource SettingsCardSpacing}" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:OobeStrings.Oobe_Step5Title}" />

                                    <controls:LabeledSettingsCard x:Name="CardPPTSupport" Header="{x:Static props:OobeStrings.Oobe_EnablePPTLink}" Description="{x:Static props:OobeStrings.Oobe_EnablePPTLinkDesc}" Symbol="SlideTransition24" SwitchName="ToggleSwitchPPTSupport" />

                                    <controls:LabeledSettingsCard x:Name="CardPPTAutoSaveStrokes" Header="{x:Static props:OobeStrings.Oobe_AutoSaveStrokes}" Description="{x:Static props:OobeStrings.Oobe_AutoSaveStrokesDesc}" Symbol="Save24" SwitchName="ToggleSwitchPPTAutoSaveStrokes" />

                                    <controls:LabeledSettingsCard x:Name="CardPPTAutoSaveScreenshots" Header="{x:Static props:OobeStrings.Oobe_AutoScreenshot}" Description="{x:Static props:OobeStrings.Oobe_AutoScreenshotDesc}" Symbol="Camera24" SwitchName="ToggleSwitchPPTAutoSaveScreenshots" />

                                    <controls:LabeledSettingsCard x:Name="CardPPTTimeCapsule" Header="{x:Static props:OobeStrings.Oobe_EnableTimeCapsule}" Description="{x:Static props:OobeStrings.Oobe_EnableTimeCapsuleDesc}" Symbol="WeatherMoon24" SwitchName="ToggleSwitchPPTTimeCapsule" />
                                </vio:SimpleStackPanel>

                                <!-- 步骤 6: 自动化 + 截图 -->
                                <vio:SimpleStackPanel x:Name="StepAutomationPanel" Spacing="{StaticResource SettingsCardSpacing}" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:OobeStrings.Oobe_Step6Title}" />

                                    <controls:LabeledSettingsCard x:Name="CardAutoFoldInPPTSlideShow" Header="{x:Static props:OobeStrings.Oobe_AutoFoldInPPT}" Symbol="ChevronLeft24" SwitchName="ToggleSwitchAutoFoldInPPTSlideShow" />

                                    <controls:LabeledSettingsCard x:Name="CardEnableAutoSaveStrokes" Header="{x:Static props:OobeStrings.Oobe_AutoSaveInk}" Description="{x:Static props:OobeStrings.Oobe_AutoSaveInkDesc}" Symbol="Save24" SwitchName="ToggleSwitchEnableAutoSaveStrokes" />

                                    <controls:LabeledSettingsCard x:Name="CardFloatingWindowInterceptor" Header="{x:Static props:AutomationStrings.FloatingInterceptor_Enable}" Description="{x:Static props:OobeStrings.Oobe_FloatingInterceptorDesc}" Symbol="Dismiss24" SwitchName="ToggleSwitchFloatingWindowInterceptor" />

                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,18,0,6" Text="{x:Static props:OobeStrings.Oobe_ScreenshotTitle}" />

                                    <controls:LabeledSettingsCard x:Name="CardAutoSaveStrokesAtClear" Header="{x:Static props:OobeStrings.Oobe_AutoSaveScreenshot}" Symbol="Camera24" SwitchName="ToggleSwitchAutoSaveStrokesAtClear" />

                                    <controls:LabeledSettingsCard x:Name="CardSaveScreenshotsInDateFolders" Header="{x:Static props:OobeStrings.Oobe_SaveByDate}" Symbol="Folder24" SwitchName="ToggleSwitchSaveScreenshotsInDateFolders" />
                                </vio:SimpleStackPanel>

                                <!-- 步骤 7: 随机点名 -->
                                <vio:SimpleStackPanel x:Name="StepLuckyRandomPanel" Spacing="{StaticResource SettingsCardSpacing}" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:RandomStrings.Random_Title}" />

                                    <controls:LabeledSettingsCard x:Name="CardShowRandomAndSingleDraw" Header="{x:Static props:OobeStrings.Oobe_ShowRollCallButtons}" Symbol="People24" SwitchName="ToggleSwitchShowRandomAndSingleDraw" />
                                </vio:SimpleStackPanel>

                                <!-- 步骤 8: 高级 -->
                                <vio:SimpleStackPanel x:Name="StepAdvancedPanel" Spacing="{StaticResource SettingsCardSpacing}" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:OobeStrings.Oobe_Step8Title}" />

                                    <controls:LabeledSettingsCard x:Name="CardIsLogEnabled" Header="{x:Static props:OobeStrings.Oobe_EnableLog}" Description="{x:Static props:OobeStrings.Oobe_EnableLogDesc}" Symbol="Document24" SwitchName="ToggleSwitchIsLogEnabled" />
                                </vio:SimpleStackPanel>

                                <Rectangle Height="32" />
                            </vio:SimpleStackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- 完成页 -->
                    <Grid x:Name="FinishPanel" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <vio:SimpleStackPanel HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="640" Margin="40,32,40,16" Spacing="14">
                                <Border Width="80" Height="80" HorizontalAlignment="Center" CornerRadius="20" Background="{DynamicResource SystemControlBackgroundAccentBrush}">
                                    <ui:SymbolIcon FontSize="40" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Checkmark24" />
                                </Border>

                                <TextBlock Text="{x:Static props:OobeStrings.Oobe_FinishTitle}" Style="{DynamicResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" />

                                <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.85" Style="{DynamicResource BodyTextBlockStyle}" Text="{x:Static props:OobeStrings.Oobe_FinishDesc}" />

                                <Border CornerRadius="8" Padding="16" Margin="0,8,0,0" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                    <vio:SimpleStackPanel x:Name="FinishSummaryHost" Spacing="6" />
                                </Border>
                            </vio:SimpleStackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>

                <!-- Footer -->
                <Border Grid.Row="1" Padding="40,12,40,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ProgressBar x:Name="StepProgressBar" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="420" HorizontalAlignment="Stretch" Minimum="0" Maximum="100" Value="0" />

                        <TextBlock Grid.Column="1" x:Name="FooterStepText" VerticalAlignment="Center" Margin="0,0,16,0" Style="{DynamicResource CaptionTextBlockStyle}" Opacity="0.7" Text="" />

                        <Button x:Name="BtnPreviousStep" Grid.Column="2" MinWidth="96" Height="32" Margin="0,0,8,0" Click="BtnPreviousStep_Click">
                            <vio:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="12" />
                                <TextBlock Text="{x:Static props:OobeStrings.Oobe_Previous}" />
                            </vio:SimpleStackPanel>
                        </Button>

                        <ui:Button x:Name="BtnConfirm" Grid.Column="3" MinWidth="140" Height="32" Click="BtnConfirm_Click" Appearance="Primary">
                            <vio:SimpleStackPanel x:Name="BtnConfirmContent" Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="BtnConfirmText" Text="{x:Static props:OobeStrings.Oobe_Next}" />
                                <ui:SymbolIcon x:Name="BtnConfirmIcon" Symbol="ChevronRight24" FontSize="12" />
                            </vio:SimpleStackPanel>
                        </ui:Button>
                    </Grid>
                </Border>
            </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</Window>
