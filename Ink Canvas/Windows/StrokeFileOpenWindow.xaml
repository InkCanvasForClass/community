<Window x:Class="Ink_Canvas.Windows.StrokeFileOpenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:props="clr-namespace:Ink_Canvas.Properties"
        xmlns:local="clr-namespace:Ink_Canvas.Windows"
        Title="{x:Static props:MainWindowStrings.Main_OpenInk_Title}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.CornerStyle="Round">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DestinationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="72" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,18,24,20">
            <TextBlock Text="{x:Static props:MainWindowStrings.Main_OpenInk_ChooseDestination}"
                       FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="FileNameText" Margin="0,8,0,20" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Button x:Name="ScreenButton" Style="{StaticResource DestinationButton}" Click="Destination_Click"
                    Tag="{x:Static local:StrokeFileOpenTarget.Screen}"
                    AutomationProperties.Name="{x:Static props:MainWindowStrings.Main_OpenInk_Screen}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.InkingTool}" FontSize="24" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{x:Static props:MainWindowStrings.Main_OpenInk_Screen}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static props:MainWindowStrings.Main_OpenInk_ScreenDescription}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button x:Name="WhiteboardButton" Style="{StaticResource DestinationButton}" Click="Destination_Click"
                    Tag="{x:Static local:StrokeFileOpenTarget.Whiteboard}"
                    AutomationProperties.Name="{x:Static props:MainWindowStrings.Main_OpenInk_Whiteboard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Edit}" FontSize="24" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{x:Static props:MainWindowStrings.Main_OpenInk_Whiteboard}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static props:MainWindowStrings.Main_OpenInk_WhiteboardDescription}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button x:Name="BoothButton" Style="{StaticResource DestinationButton}" Click="Destination_Click"
                    Tag="{x:Static local:StrokeFileOpenTarget.Booth}"
                    AutomationProperties.Name="{x:Static props:MainWindowStrings.Main_OpenInk_Booth}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Video}" FontSize="24" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{x:Static props:MainWindowStrings.Main_OpenInk_Booth}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static props:MainWindowStrings.Main_OpenInk_BoothDescription}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Button>
            <TextBlock Text="{x:Static props:MainWindowStrings.Main_OpenInk_AppendHint}" TextWrapping="Wrap"
                       Margin="0,6,0,18" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Button x:Name="CancelButton" Content="{x:Static props:MainWindowStrings.Main_OpenInk_Cancel}"
                    IsCancel="True" MinWidth="88" HorizontalAlignment="Right" />
        </StackPanel>
    </ScrollViewer>
</Window>
