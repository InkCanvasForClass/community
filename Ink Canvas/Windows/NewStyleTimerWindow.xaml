<Window xmlns:props="clr-namespace:Ink_Canvas.Properties"
        x:Class="Ink_Canvas.Windows.NewStyleTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        mc:Ignorable="d"
        Title="{x:Static props:TimerStrings.Timer_Title}"
        Width="860"
        Height="520"
        MinWidth="680"
        MinHeight="420"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.SystemBackdropType="None"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.CornerStyle="Round">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DigitResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="MainBorder" Background="Transparent" MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <Grid>
            <Viewbox x:Name="MainViewController" StretchDirection="DownOnly" MaxWidth="860" MaxHeight="520">
                <Grid Width="900" Height="400">
                    <!-- Title bar -->
                    <Grid Height="50" x:Name="TitleBar" VerticalAlignment="Top" Margin="0,0,450,0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,0,0,0">
                            <Path Data="M5 13a7 7 0 1 0 14 0a7 7 0 0 0 -14 0z M14.5 10.5l-2.5 2.5 M17 8l1 -1 M14 3h-4"
                                  Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"
                                  StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="{x:Static props:TimerStrings.Timer_Title}" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"
                                       x:Name="TitleText"/>
                        </StackPanel>
                    </Grid>

                    <!-- Main content -->
                    <Grid x:Name="MainContentGrid" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,-25,0,25">
                        <!-- Left: 6-digit display -->
                        <Grid x:Name="MainDisplayGrid" Width="500" HorizontalAlignment="Left" Margin="-10,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" x:Name="DigitsPanel">
                                <!-- HH group -->
                                <Grid Margin="0,0,20,0" Width="120">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Grid Margin="0,0,15,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Button x:Name="Digit1PlusBtn" Width="40" Height="40" Cursor="Hand" Click="Digit1Plus_Click" Margin="0,0,0,15"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="15"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <Path Data="M12 5l0 14 M5 12l14 0" Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
                                                </Button>
                                                <Path x:Name="Digit1Display" Data="{StaticResource Digit0}" Fill="{DynamicResource NewTimerWindowDigitForeground}" Width="48" Height="48" HorizontalAlignment="Center" Stretch="Uniform" Margin="0,0,0,15"/>
                                                <Button x:Name="Digit1MinusBtn" Width="40" Height="40" Cursor="Hand" Click="Digit1Minus_Click"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="15"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <Path Data="M5 12l14 0" Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center">
                                                <Button x:Name="Digit2PlusBtn" Width="40" Height="40" Cursor="Hand" Click="Digit2Plus_Click" Margin="0,0,0,15"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="15"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <Path Data="M12 5l0 14 M5 12l14 0" Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
                                                </Button>
                                                <Path x:Name="Digit2Display" Data="{StaticResource Digit0}" Fill="{DynamicResource NewTimerWindowDigitForeground}" Width="48" Height="48" HorizontalAlignment="Center" Stretch="Uniform" Margin="0,0,0,15"/>
                                                <Button x:Name="Digit2MinusBtn" Width="40" Height="40" Cursor="Hand" Click="Digit2Minus_Click"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="15"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <Path Data="M5 12l14 0" Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="Colon1Display" Text=":" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource NewTimerWindowDigitForeground}" Margin="-20,-55,0,0"/>
                                <!-- MM group -->
                                <Grid Margin="0,0,20,0" Width="120">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Grid Margin="0,0,15,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Button x:Name="Digit3PlusBtn" Width="40" Height="40" Cursor="Hand" Click="Digit3Plus_Click" Margin="0,0,0,15"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="15"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <Path Data="M12 5l0 14 M5 12l14 0" Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
                                                </Button>
                                                <Path x:Name="Digit3Display" Data="{StaticResource Digit0}" Fill="{DynamicResource NewTimerWindowDigitForeground}" Width="48" Height="48" HorizontalAlignment="Center" Stretch="Uniform" Margin="0,0,0,15"/>
                                                <Button x:Name="Digit3MinusBtn" Width="40" Height="40" Cursor="Hand" Click="Digit3Minus_Click"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="15"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <Path Data="M5 12l14 0" Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center">
                                                <Button x:Name="Digit4PlusBtn" Width="40" Height="40" Cursor="Hand" Click="Digit4Plus_Click" Margin="0,0,0,15"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="15"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <Path Data="M12 5l0 14 M5 12l14 0" Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
                                                </Button>
                                                <Path x:Name="Digit4Display" Data="{StaticResource Digit0}" Fill="{DynamicResource NewTimerWindowDigitForeground}" Width="48" Height="48" HorizontalAlignment="Center" Stretch="Uniform" Margin="0,0,0,15"/>
                                                <Button x:Name="Digit4MinusBtn" Width="40" Height="40" Cursor="Hand" Click="Digit4Minus_Click"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="15"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <Path Data="M5 12l14 0" Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="Colon2Display" Text=":" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource NewTimerWindowDigitForeground}" Margin="-20,-55,0,0"/>
                                <!-- SS group -->
                                <Grid Width="120">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Grid Margin="0,0,15,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Button x:Name="Digit5PlusBtn" Width="40" Height="40" Cursor="Hand" Click="Digit5Plus_Click" Margin="0,0,0,15"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="15"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <Path Data="M12 5l0 14 M5 12l14 0" Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
                                                </Button>
                                                <Path x:Name="Digit5Display" Data="{StaticResource Digit0}" Fill="{DynamicResource NewTimerWindowDigitForeground}" Width="48" Height="48" HorizontalAlignment="Center" Stretch="Uniform" Margin="0,0,0,15"/>
                                                <Button x:Name="Digit5MinusBtn" Width="40" Height="40" Cursor="Hand" Click="Digit5Minus_Click"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="15"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <Path Data="M5 12l14 0" Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center">
                                                <Button x:Name="Digit6PlusBtn" Width="40" Height="40" Cursor="Hand" Click="Digit6Plus_Click" Margin="0,0,0,15"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="15"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <Path Data="M12 5l0 14 M5 12l14 0" Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
                                                </Button>
                                                <Path x:Name="Digit6Display" Data="{StaticResource Digit0}" Fill="{DynamicResource NewTimerWindowDigitForeground}" Width="48" Height="48" HorizontalAlignment="Center" Stretch="Uniform" Margin="0,0,0,15"/>
                                                <Button x:Name="Digit6MinusBtn" Width="40" Height="40" Cursor="Hand" Click="Digit6Minus_Click"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="15"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <Path Data="M5 12l14 0" Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Divider -->
                        <Border Width="2" Background="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" Opacity="0.3"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="465,0,0,0"/>

                        <!-- Right: quick options with TabControl -->
                        <Grid x:Name="QuickOptionsGrid" HorizontalAlignment="Center" Margin="470,0,0,0" Height="200">
                            <TabControl x:Name="TimerQuickTabControl"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Center"
                                        FontSize="14"
                                        Style="{StaticResource {x:Static ui:ThemeKeys.TabControlPivotStyleKey}}"
                                        SelectionChanged="TimerQuickTabControl_SelectionChanged">
                                <TabItem Header="{x:Static props:TimerStrings.Timer_CommonTab}">
                                    <Grid x:Name="CommonTimersGrid" Margin="0,4,0,0">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <Button x:Name="Common5MinBtn" Width="100" Height="55" Cursor="Hand" Click="Common5Min_Click" Margin="0,0,15,0"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Path Data="M10 15h2a1.5 1.5 0 0 0 0 -3h-2v-3h3.5 M3 12v.01 M21 12v.01 M12 21v.01 M7.5 4.2v.01 M16.5 19.8v.01 M7.5 19.8v.01 M4.2 16.5v.01 M19.8 16.5v.01 M19.8 7.5v.01 M4.2 7.5v.01 M16.5 4.206a9.042 9.042 0 0 0 -4.5 -1.206"
                                                              Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                                                        <TextBlock Text="05:00" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="Common10MinBtn" Width="100" Height="55" Cursor="Hand" Click="Common10Min_Click" Margin="0,0,15,0"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Path Data="M9 9v6 M12 11v2a2 2 0 1 0 4 0v-2a2 2 0 1 0 -4 0z M3 12v.01 M21 12v.01 M12 21v.01 M7.5 4.2v.01 M16.5 19.8v.01 M7.5 19.8v.01 M4.2 16.5v.01 M19.8 16.5v.01 M4.2 7.5v.01 M19.81 7.527a8.994 8.994 0 0 0 -7.81 -4.527"
                                                              Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                                                        <TextBlock Text="10:00" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="Common15MinBtn" Width="100" Height="55" Cursor="Hand" Click="Common15Min_Click"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Path Data="M12 15h2a1 1 0 0 0 1 -1v-1a1 1 0 0 0 -1 -1h-2v-3h3 M9 9v6 M3 12v.01 M12 21v.01 M7.5 4.2v.01 M16.5 19.8v.01 M7.5 19.8v.01 M4.2 16.5v.01 M19.8 16.5v.01 M4.2 7.5v.01 M21 12a9 9 0 0 0 -9 -9"
                                                              Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                                                        <TextBlock Text="15:00" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button x:Name="Common30MinBtn" Width="100" Height="55" Cursor="Hand" Click="Common30Min_Click" Margin="0,0,15,0"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Path Data="M14 10.5v3a1.5 1.5 0 0 0 3 0v-3a1.5 1.5 0 0 0 -3 0z M8 9h1.5a1.5 1.5 0 0 1 0 3h-.5h.5a1.5 1.5 0 0 1 0 3h-1.5 M3 12v.01 M7.5 4.2v.01 M7.5 19.8v.01 M4.2 16.5v.01 M4.2 7.5v.01 M12 21a9 9 0 0 0 0 -18"
                                                              Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                                                        <TextBlock Text="30:00" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="Common45MinBtn" Width="100" Height="55" Cursor="Hand" Click="Common45Min_Click" Margin="0,0,15,0"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Path Data="M13 15h2a1 1 0 0 0 1 -1v-1a1 1 0 0 0 -1 -1h-2v-3h3 M7 9v2a1 1 0 0 0 1 1h1 M10 9v6 M7.5 4.2v.01 M4.2 7.5v.01 M3 12a9 9 0 1 0 9 -9"
                                                              Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                                                        <TextBlock Text="45:00" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="Common60MinBtn" Width="100" Height="55" Cursor="Hand" Click="Common60Min_Click"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Path Data="M14 10.5v3a1.5 1.5 0 0 0 3 0v-3a1.5 1.5 0 0 0 -3 0z M11 9h-2a1 1 0 0 0 -1 1v4a1 1 0 0 0 1 1h1a1 1 0 0 0 1 -1v-1a1 1 0 0 0 -1 -1h-2 M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"
                                                              Stroke="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                                                        <TextBlock Text="60:00" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="{x:Static props:TimerStrings.Timer_RecentTab}">
                                    <Grid x:Name="RecentTimersGrid" Margin="0,4,0,0">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <Button x:Name="RecentTimer1Btn" Width="100" Height="55" Cursor="Hand" Click="RecentTimer1_Click" Margin="0,0,15,0"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <TextBlock x:Name="RecentTimer1Text" Text="--:--" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                                </Button>
                                                <Button x:Name="RecentTimer2Btn" Width="100" Height="55" Cursor="Hand" Click="RecentTimer2_Click" Margin="0,0,15,0"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <TextBlock x:Name="RecentTimer2Text" Text="--:--" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                                </Button>
                                                <Button x:Name="RecentTimer3Btn" Width="100" Height="55" Cursor="Hand" Click="RecentTimer3_Click"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <TextBlock x:Name="RecentTimer3Text" Text="--:--" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button x:Name="RecentTimer4Btn" Width="100" Height="55" Cursor="Hand" Click="RecentTimer4_Click" Margin="0,0,15,0"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <TextBlock x:Name="RecentTimer4Text" Text="--:--" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                                </Button>
                                                <Button x:Name="RecentTimer5Btn" Width="100" Height="55" Cursor="Hand" Click="RecentTimer5_Click" Margin="0,0,15,0"
                                                        Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorDefaultBrushKey}}" BorderThickness="0">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                                    <TextBlock x:Name="RecentTimer5Text" Text="--:--" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"/>
                                                </Button>
                                                <Button x:Name="RecentTimer6Btn" Width="100" Height="55" Cursor="Hand" Click="RecentTimer6_Click"
