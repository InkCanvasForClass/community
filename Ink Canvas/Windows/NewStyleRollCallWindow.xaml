<Window x:Class="Ink_Canvas.NewStyleRollCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:controls="clr-namespace:Ink_Canvas.Windows.Controls"
        Topmost="True"
        Background="Transparent"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Loaded="RollCallWindow_Loaded"
        Closing="Window_Closing"
        WindowStartupLocation="CenterScreen"
        MouseMove="Window_MouseMove"
        MouseEnter="Window_MouseEnter"
        Title="Ink Canvas 画板 - 点名"
        Height="500"
        Width="800"
        ui:ThemeManager.IsThemeAware="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Controls/WinUI3CloseButton.xaml" />
                <ResourceDictionary Source="../Resources/NewRollCallWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="RollCallAccentBrush" Color="#4CAF50" />
            <SolidColorBrush x:Key="RollCallAccentPointerOverBrush" Color="#43A047" />
            <SolidColorBrush x:Key="RollCallAccentPressedBrush" Color="#388E3C" />
            <SolidColorBrush x:Key="RollCallStopBrush" Color="#D13438" />
            <SolidColorBrush x:Key="RollCallStopPointerOverBrush" Color="#B3261E" />

            <Style x:Key="ModernRollCallCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource {x:Static ui:ThemeKeys.CardBackgroundFillColorDefaultBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.CardStrokeColorDefaultBrushKey}}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="ModernRollCallSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Static ui:ThemeKeys.DefaultButtonStyleKey}}">
                <Setter Property="Height" Value="38" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="ModernRollCallIconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Static ui:ThemeKeys.DefaultButtonStyleKey}}">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style x:Key="ModernRollCallPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Static ui:ThemeKeys.DefaultButtonStyleKey}}">
                <Setter Property="Height" Value="48" />
                <Setter Property="MinWidth" Value="128" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="Background" Value="{StaticResource RollCallAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource RollCallAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Resources>
                    <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonBackgroundPointerOverKey}" Color="#43A047" />
                    <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonBackgroundPressedKey}" Color="#388E3C" />
                    <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonForegroundKey}" Color="White" />
                </Style.Resources>
            </Style>

            <Style x:Key="ModernRollCallStopButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Static ui:ThemeKeys.DefaultButtonStyleKey}}">
                <Setter Property="Height" Value="48" />
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Background" Value="{StaticResource RollCallStopBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource RollCallStopBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Resources>
                    <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonBackgroundPointerOverKey}" Color="#B3261E" />
                    <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonBackgroundPressedKey}" Color="#8C1D18" />
                    <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonForegroundKey}" Color="White" />
                </Style.Resources>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="MainBorder"
            Margin="8"
            CornerRadius="8"
            BorderThickness="1"
            Background="{DynamicResource {x:Static ui:ThemeKeys.AcrylicBackgroundFillColorDefaultBrushKey}}"
            BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.CardStrokeColorDefaultBrushKey}}"
            MouseLeftButtonDown="WindowDragMove">
        <Grid>
            <controls:WinUI3CloseButton x:Name="CloseButton"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Panel.ZIndex="10"
                                        Cursor="Hand"
                                        Click="CloseButton_Click"
                                        Content="x" />

            <Viewbox x:Name="MainViewController" Margin="22,18,22,20">
                <Grid Width="1000" Height="550">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="76" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="TitleBar"
                          Grid.Row="0"
                          Margin="0,0,104,0"
                          Background="Transparent"
                          MouseLeftButtonDown="WindowDragMove">
                        <StackPanel Margin="4,0,0,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Width="36"
                                    Height="36"
                                    CornerRadius="8"
                                    Background="{DynamicResource {x:Static ui:ThemeKeys.LayerFillColorDefaultBrushKey}}"
                                    BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.CardStrokeColorDefaultBrushKey}}"
                                    BorderThickness="1">
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.People}"
                                             FontSize="18"
                                             Foreground="{DynamicResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}" />
                            </Border>
                            <TextBlock x:Name="TitleText"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="点名"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="MainContentGrid"
                          Grid.Row="1"
                          Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="500" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="482" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource ModernRollCallCardStyle}">
                            <Grid x:Name="MainDisplayGrid"
                                  Width="464"
                                  Height="350"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center">
                                    <Border x:Name="MainResultContainer"
                                            Width="420"
                                            MinHeight="156"
                                            HorizontalAlignment="Center"
                                            CornerRadius="8"
                                            Background="{DynamicResource {x:Static ui:ThemeKeys.LayerFillColorDefaultBrushKey}}"
                                            BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.CardStrokeColorDefaultBrushKey}}"
                                            BorderThickness="1"
                                            Padding="20">
                                        <Viewbox Stretch="Uniform"
                                                 MaxWidth="380"
                                                 MaxHeight="110">
                                            <TextBlock x:Name="MainResultDisplay"
                                                       Text="点击开始点名"
                                                       FontSize="48"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource NewRollCallWindowDigitForeground}"
                                                       TextAlignment="Center" />
                                        </Viewbox>
                                    </Border>

                                    <Border x:Name="MultiResultContainer"
                                            Width="420"
                                            MinHeight="236"
                                            HorizontalAlignment="Center"
                                            CornerRadius="8"
                                            Background="{DynamicResource {x:Static ui:ThemeKeys.LayerFillColorDefaultBrushKey}}"
                                            BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.CardStrokeColorDefaultBrushKey}}"
                                            BorderThickness="1"
                                            Padding="14"
                                            Visibility="Collapsed">
                                    <ScrollViewer x:Name="MultiResultScrollViewer"
                                                  VerticalAlignment="Center"
                                                  Margin="0,18,0,0"
                                                  MaxHeight="218"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <UniformGrid x:Name="MultiResultPanel"
                                                     Columns="5"
                                                     Rows="4"
                                                     HorizontalAlignment="Center">
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result1Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result2Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result3Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result4Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result5Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result6Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result7Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result8Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result9Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result10Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result11Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result12Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result13Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result14Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result15Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result16Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result17Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result18Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result19Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                            <Border Width="76" Height="36" Margin="4" CornerRadius="6" Background="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}"><Viewbox Margin="8,0"><TextBlock x:Name="Result20Display" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewRollCallWindowDigitForeground}" /></Viewbox></Border>
                                        </UniformGrid>
                                    </ScrollViewer>
                                    </Border>

                                    <TextBlock x:Name="StatusDisplay"
                                               Margin="0,18,0,0"
                                               Text="准备就绪"
                                               FontSize="14"
                                               Foreground="{DynamicResource NewRollCallWindowSecondaryTextForeground}"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid x:Name="ControlOptionsGrid" Grid.Column="2">
                            <Border Style="{StaticResource ModernRollCallCardStyle}" />
                            <StackPanel Width="430"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="点名人数"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" />
                                        <TextBlock x:Name="ListCountDisplay"
                                                   Margin="0,4,0,0"
                                                   Text="名单人数: 0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource NewRollCallWindowSecondaryTextForeground}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button x:Name="CountMinusBtn" Style="{StaticResource ModernRollCallIconButtonStyle}" Click="CountMinus_Click" ToolTipService.ToolTip="减少人数">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Remove}" FontSize="12" />
                                        </Button>
                                        <Border Width="64"
                                                Height="36"
                                                Margin="8,0"
                                                CornerRadius="8"
                                                Background="{DynamicResource {x:Static ui:ThemeKeys.LayerFillColorDefaultBrushKey}}"
                                                BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.CardStrokeColorDefaultBrushKey}}"
                                                BorderThickness="1">
                                            <TextBlock x:Name="CountDisplay"
                                                       Text="1"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource NewRollCallWindowDigitForeground}" />
                                        </Border>
                                        <Button x:Name="CountPlusBtn" Style="{StaticResource ModernRollCallIconButtonStyle}" Click="CountPlus_Click" ToolTipService.ToolTip="增加人数">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="点名模式"
                                               Margin="0,0,0,8"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" />
                                    <TabControl x:Name="RollCallModeTabControl"
                                                Width="376"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="14"
                                                Style="{StaticResource {x:Static ui:ThemeKeys.TabControlPivotStyleKey}}"
                                                SelectionChanged="RollCallModeTabControl_SelectionChanged">
                                        <TabItem Header="随机" />
                                        <TabItem Header="顺序" />
                                        <TabItem Header="分组" />
                                        <TabItem Header="外部" />
                                    </TabControl>
                                </StackPanel>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="外部点名"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" />
                                    <ComboBox x:Name="ExternalCallerTypeComboBox"
                                              Grid.Column="1"
                                              Width="172"
                                              Height="36"
                                              HorizontalAlignment="Right"
                                              SelectedIndex="0"
                                              SelectionChanged="ExternalCallerTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="ClassIsland" IsSelected="True" />
                                        <ComboBoxItem Content="SecRandom" />
                                        <ComboBoxItem Content="NamePicker" />
                                    </ComboBox>
                                </Grid>

                                <StackPanel>
                                    <TextBlock Text="名单管理"
                                               Margin="0,0,0,8"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" />
                                    <UniformGrid Columns="3">
                                        <Button x:Name="ImportListBtn" Style="{StaticResource ModernRollCallSmallButtonStyle}" Margin="0,0,8,0" Click="ImportList_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.OpenFile}" FontSize="13" Margin="0,0,6,0" />
                                                <TextBlock Text="导入" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ClearListBtn" Style="{StaticResource ModernRollCallSmallButtonStyle}" Margin="0,0,8,0" Click="ClearList_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Delete}" FontSize="13" Margin="0,0,6,0" />
                                                <TextBlock Text="清空" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ViewHistoryBtn" Style="{StaticResource ModernRollCallSmallButtonStyle}" Click="ViewHistory_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.History}" FontSize="13" Margin="0,0,6,0" />
                                                <TextBlock Text="历史" />
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <Border Width="420" Height="64" Style="{StaticResource ModernRollCallCardStyle}" Padding="10" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Button x:Name="StartRollCallBtn"
                                    Style="{StaticResource ModernRollCallPrimaryButtonStyle}"
                                    Click="StartRollCall_Click"
                                    Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="StartRollCallBtnIcon"
                                          Width="18"
                                          Height="18"
                                          Margin="0,0,8,0"
                                          Data="M5 7C5 8.06087 5.42143 9.07828 6.17157 9.82843C6.92172 10.5786 7.93913 11 9 11C10.0609 11 11.0783 10.5786 11.8284 9.82843C12.5786 9.07828 13 8.06087 13 7C13 5.93913 12.5786 4.92172 11.8284 4.17157C11.0783 3.42143 10.0609 3 9 3C7.93913 3 6.92172 3.42143 6.17157 4.17157C5.42143 4.92172 5 5.93913 5 7Z M3 21V19C3 17.9391 3.42143 16.9217 4.17157 16.1716C4.92172 15.4214 5.93913 15 7 15H11C12.0609 15 13.0783 15.4214 13.8284 16.1716C14.5786 16.9217 15 17.9391 15 19V21 M16 3.13C16.8604 3.35031 17.623 3.85071 18.1676 4.55232C18.7122 5.25392 19.0078 6.11683 19.0078 7.005C19.0078 7.89318 18.7122 8.75608 18.1676 9.45769C17.623 10.1593 16.8604 10.6597 16 10.88 M21 21V19C20.9949 18.1172 20.6979 17.2608 20.1553 16.5644C19.6126 15.868 18.8548 15.3707 18 15.15"
                                          Stroke="White"
                                          StrokeThickness="2"
                                          Fill="Transparent"
                                          Stretch="Uniform" />
                                    <TextBlock x:Name="StartRollCallBtnText"
                                               Text="开始点名"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="White" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="StopRollCallBtn"
                                    Style="{StaticResource ModernRollCallStopButtonStyle}"
                                    Click="StopRollCall_Click"
                                    Margin="0,0,14,0"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Cancel}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="停止" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="ResetBtn"
                                    Height="48"
                                    MinWidth="104"
                                    Padding="16,0"
                                    Click="Reset_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Refresh}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="重置" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Viewbox>
        </Grid>
    </Border>
</Window>
