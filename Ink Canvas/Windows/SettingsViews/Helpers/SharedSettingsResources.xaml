<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Thickness x:Key="ListViewItemCompactSelectedBorderThemeThickness">1.5</Thickness>
    <sys:Double x:Key="ListViewItemMinWidth">0</sys:Double>
    <sys:Double x:Key="ListViewItemMinHeight">36</sys:Double>

    <Style x:Key="BorderlessIconButtonStyle" TargetType="Button"
           BasedOn="{StaticResource {x:Static ui:ThemeKeys.DefaultButtonStyleKey}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

</ResourceDictionary>
