<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:dd="urn:gong-wpf-dragdrop">

    <Thickness x:Key="ListViewItemCompactSelectedBorderThemeThickness">1.5</Thickness>
    <sys:Double x:Key="ListViewItemMinWidth">0</sys:Double>
    <sys:Double x:Key="ListViewItemMinHeight">36</sys:Double>

    <!-- 必须 BasedOn 显式继承隐式 Button 样式：显式声明 TargetType 会屏蔽
         ControlsDictionary 里的隐式 Button 模板，导致按钮退回 WPF 系统默认外观
         （灰底方角、悬停无反馈），与整体 Fluent 风格割裂。 -->
    <Style x:Key="BorderlessIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="DragDropListViewStyle" TargetType="ListView">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="dd:DragDrop.IsDragSource" Value="True"/>
        <Setter Property="dd:DragDrop.IsDropTarget" Value="True"/>
        <Setter Property="dd:DragDrop.UseDefaultEffectDataTemplate" Value="False"/>
        <Setter Property="dd:DragDrop.DropTargetAdornerBrush" Value="#2563eb"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

</ResourceDictionary>
