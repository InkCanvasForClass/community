<ui:Page x:Class="Ink_Canvas.Windows.SettingsViews.Pages.AnnouncementCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:i18n="clr-namespace:Ink_Canvas.MarkupExtensions"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d"
      Title="{i18n:I18n Key=Announcement_CenterTitle}">

    <Grid Margin="59,0,59,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                   TargetType="TextBlock">
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style>
        </Grid.Resources>

        <TextBlock Text="{i18n:I18n Key=Announcement_CenterTitle}"
                   Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

        <ListBox x:Name="AnnouncementListBox"
                 Grid.Row="1"
                 BorderThickness="0"
                 Margin="0,8,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12"
                            Margin="0,0,0,8"
                            CornerRadius="8"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="{Binding Type}"
                                           DockPanel.Dock="Right"
                                           Opacity="0.65"
                                           FontSize="12" />
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Text="{Binding Summary}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Opacity="0.8" />
                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Opacity="0.55" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyTextBlock"
                   Grid.Row="1"
                   Text="{i18n:I18n Key=Announcement_NoItems}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.65"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="{i18n:I18n Key=Announcement_ClearHistory}"
                    Margin="0,0,8,0"
                    Click="ClearHistoryButton_Click" />
            <Button Content="{i18n:I18n Key=Notification_ViewDetails}"
                    Margin="0,0,8,0"
                    Click="ViewDetailsButton_Click" />
            <Button Content="{i18n:I18n Key=Notification_ProviderRefresh}"
                    Click="RefreshButton_Click" />
        </StackPanel>
    </Grid>
</ui:Page>
