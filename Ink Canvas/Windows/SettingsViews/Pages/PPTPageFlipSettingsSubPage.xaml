<ui:Page x:Class="Ink_Canvas.Windows.SettingsViews.Pages.PPTPageFlipSettingsSubPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d"
      Title="PPTPageFlipSettingsSubPage"
      Loaded="Page_Loaded">

    <Grid>
        <FrameworkElement.Resources>
            <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
        </FrameworkElement.Resources>
        
        <ikw:SimpleStackPanel Spacing="{StaticResource SettingsCardSpacing}">
            <!-- Enable ToggleSwitch (title right side) -->
            <ui:SettingsCard x:Name="CardPositionEnabled" Header="启用当前位置按钮"
                             Description="控制该位置的翻页按钮是否显示在屏幕上">
                <ui:ToggleSwitch x:Name="ToggleSwitchPositionEnabled" Toggled="ToggleSwitchPositionEnabled_Toggled"/>
            </ui:SettingsCard>

            <!-- Show Page Number ToggleSwitch -->
            <ui:SettingsCard x:Name="CardShowPageNumber" Header="显示页码"
                             Description="在翻页条中显示当前页码和总页数">
                <ui:ToggleSwitch x:Name="ToggleSwitchShowPageNumber" Toggled="ToggleSwitchShowPageNumber_Toggled"/>
            </ui:SettingsCard>

            <!-- Black Background ToggleSwitch -->
            <ui:SettingsCard x:Name="CardBlackBackground" Header="黑色背景"
                             Description="使用黑色半透明背景代替默认的主题透明背景">
                <ui:ToggleSwitch x:Name="ToggleSwitchBlackBackground" Toggled="ToggleSwitchBlackBackground_Toggled"/>
            </ui:SettingsCard>

            <!-- Offset Slider with Reset Button -->
            <ui:SettingsCard x:Name="CardOffset" Header="偏移">
                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="TextBlockOffsetValue" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                    <Slider x:Name="SliderOffset" Minimum="-500" Maximum="500" Width="200" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="SliderOffset_ValueChanged"/>
                    <Button Content="重置" Click="ButtonResetOffset_Click"/>
                </ikw:SimpleStackPanel>
            </ui:SettingsCard>

            <!-- Opacity Slider with Reset Button -->
            <ui:SettingsCard x:Name="CardOpacity" Header="透明度">
                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="TextBlockOpacityValue" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                    <Slider x:Name="SliderOpacity" Minimum="0.1" Maximum="1.0" Width="200" ValueChanged="SliderOpacity_ValueChanged"/>
                    <Button Content="重置" Click="ButtonResetOpacity_Click"/>
                </ikw:SimpleStackPanel>
            </ui:SettingsCard>
        </ikw:SimpleStackPanel>
    </Grid>
</ui:Page>
