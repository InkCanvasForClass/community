<ui:Page x:Class="Ink_Canvas.Windows.SettingsViews.Pages.WordPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
 xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
 xmlns:local="clr-namespace:Ink_Canvas.Controls" xmlns:p="clr-namespace:Ink_Canvas.Properties"
 Title="{x:Static p:WordStrings.Title}">
 <ScrollViewer PanningMode="VerticalFirst">
  <StackPanel Margin="59,30" MaxWidth="1000">
   <TextBlock Text="{x:Static p:WordStrings.Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
   <controls:LabeledSettingsCard x:Name="EnableWord" Header="{x:Static p:WordStrings.Enable}" Description="{x:Static p:WordStrings.EnableHint}" Toggled="SettingsChanged" Margin="0,0,0,4"/>
   <TextBlock Text="{x:Static p:WordStrings.FocusModeSettings}" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,12"/>
   <controls:LabeledSettingsCard x:Name="AutoEnterFocusMode" Header="{x:Static p:WordStrings.AutoEnterFocusMode}" Description="{x:Static p:WordStrings.AutoEnterFocusModeHint}" Toggled="SettingsChanged" Margin="0,0,0,4"/>
   <ui:SettingsCard Header="{x:Static p:WordStrings.FocusToolbarOpacity}" Margin="0,0,0,4">
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="{Binding Value, ElementName=FocusToolbarOpacity, StringFormat={}{0:P0}}" Width="48" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
     <Slider x:Name="FocusToolbarOpacity" Minimum="0.1" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="180" ValueChanged="SettingsChanged"/>
    </StackPanel>
   </ui:SettingsCard>
   <TextBlock Text="{x:Static p:WordStrings.NavigationAppearance}" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,12"/>
   <Border Background="#e4e4e7" CornerRadius="8" Padding="16" Margin="0,0,0,16">
    <StackPanel>
     <TextBlock Text="{x:Static p:WordStrings.Preview}" Foreground="#52525b" FontSize="12"/>
     <Viewbox Stretch="Uniform" MaxHeight="160" Margin="0,6,0,0">
      <Grid Width="1000" Height="180" IsHitTestVisible="False">
       <local:WordLectureBar x:Name="PreviewLeft" ShowZoom="False" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,20"/>
       <local:WordLectureBar x:Name="PreviewRight" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,20"/>
      </Grid>
     </Viewbox>
    </StackPanel>
   </Border>
   <TextBlock Text="{x:Static p:WordStrings.NavigationLayout}" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <controls:LabeledSettingsCard x:Name="ShowNavigation" Header="{x:Static p:WordStrings.ShowNavigation}" Toggled="SettingsChanged" Margin="0,0,0,4"/>
   <controls:LabeledSettingsCard x:Name="ShowZoom" Header="{x:Static p:WordStrings.ShowZoom}" Toggled="SettingsChanged" Margin="0,0,0,4"/>
   <controls:LabeledSettingsCard x:Name="FollowWindow" Header="{x:Static p:WordStrings.FollowWindow}" Description="{x:Static p:WordStrings.FollowWindowHint}" Toggled="SettingsChanged" Margin="0,0,0,4"/>
   <ui:SettingsCard Header="{x:Static p:WordStrings.HorizontalInset}" Margin="0,0,0,4">
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="{Binding Value, ElementName=HorizontalInset, StringFormat={}{0:F0}}" Width="48" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
     <Slider x:Name="HorizontalInset" Minimum="0" Maximum="300" TickFrequency="2" IsSnapToTickEnabled="True" Width="180" ValueChanged="SettingsChanged"/>
    </StackPanel>
   </ui:SettingsCard>
   <ui:SettingsCard Header="{x:Static p:WordStrings.BottomInset}" Margin="0,0,0,4">
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="{Binding Value, ElementName=BottomInset, StringFormat={}{0:F0}}" Width="48" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
     <Slider x:Name="BottomInset" Minimum="0" Maximum="200" TickFrequency="2" IsSnapToTickEnabled="True" Width="180" ValueChanged="SettingsChanged"/>
    </StackPanel>
   </ui:SettingsCard>
   <TextBlock Text="{x:Static p:WordStrings.CustomAppearance}" FontWeight="SemiBold" Margin="0,20,0,8"/>
   <controls:LabeledSettingsCard x:Name="UsePptAppearance" Header="{x:Static p:WordStrings.UsePptAppearance}" Description="{x:Static p:WordStrings.UsePptAppearanceHint}" Toggled="SettingsChanged" Margin="0,0,0,4"/>
   <StackPanel x:Name="CustomAppearanceControls">
   <controls:LabeledSettingsCard x:Name="ShowPageNumber" Header="{x:Static p:WordStrings.ShowPageNumber}" Toggled="SettingsChanged" Margin="0,0,0,4"/>
   <controls:LabeledSettingsCard x:Name="DarkBackground" Header="{x:Static p:WordStrings.DarkBackground}" Toggled="SettingsChanged" Margin="0,0,0,4"/>
   <ui:SettingsCard Header="{x:Static p:WordStrings.NavigationScale}" Margin="0,0,0,4">
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="{Binding Value, ElementName=NavScale, StringFormat={}{0:P0}}" Width="48" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
     <Slider x:Name="NavScale" Minimum="0.5" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="180" ValueChanged="SettingsChanged"/>
    </StackPanel>
   </ui:SettingsCard>
   <ui:SettingsCard Header="{x:Static p:WordStrings.NavigationOpacity}" Margin="0,0,0,4">
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="{Binding Value, ElementName=NavOpacity, StringFormat={}{0:P0}}" Width="48" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
     <Slider x:Name="NavOpacity" Minimum="0.1" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="180" ValueChanged="SettingsChanged"/>
    </StackPanel>
   </ui:SettingsCard>
   <controls:LabeledSettingsCard x:Name="NavShadow" Header="{x:Static p:WordStrings.NavigationShadow}" Toggled="SettingsChanged" Margin="0,0,0,4"/>
   <ui:SettingsCard Header="{x:Static p:WordStrings.ShadowSize}" Margin="0,0,0,4">
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="{Binding Value, ElementName=ShadowSize, StringFormat={}{0:F0}}" Width="48" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/>
     <Slider x:Name="ShadowSize" Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Width="180" ValueChanged="SettingsChanged"/>
    </StackPanel>
   </ui:SettingsCard>
   </StackPanel>
   <Button Content="{x:Static p:WordStrings.ResetNavigation}" Click="ResetNavigationClick" HorizontalAlignment="Left" Margin="0,12,0,16"/>
   <TextBlock Text="{x:Static p:WordStrings.ScopeHint}" TextWrapping="Wrap" Margin="0,4,0,12"/>
   <TextBlock Text="{x:Static p:WordStrings.StorageHint}" TextWrapping="Wrap"/>
  </StackPanel>
 </ScrollViewer>
</ui:Page>
