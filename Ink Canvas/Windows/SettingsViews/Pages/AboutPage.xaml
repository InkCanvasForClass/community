<?xml version="1.0" encoding="utf-8"?><Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls" xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta" xmlns:sys="clr-namespace:System;assembly=mscorlib" mc:Ignorable="d" Title="{x:Static props:AboutStrings.Title}">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
                <!-- 展开卡内的「整宽行」样式已提升到 Resources/SettingsCardStyles.xaml -->
                <DataTemplate x:Key="DeveloperAvatarTemplate">
                    <vio:SimpleStackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="{Binding AvatarPath}" VerticalAlignment="Center" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Width="96" Height="96" Margin="0,0,0,6">
                            <Image.Clip>
                                <EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48" />
                            </Image.Clip>
                        </Image>
                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding Role}" HorizontalAlignment="Center" FontSize="12" TextElement.Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </vio:SimpleStackPanel>
                </DataTemplate>
                <DataTemplate x:Key="ContributorAvatarTemplate">
                    <vio:SimpleStackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="{Binding AvatarPath}" VerticalAlignment="Center" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Width="48" Height="48" Margin="0,0,0,4">
                            <Image.Clip>
                                <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24" />
                            </Image.Clip>
                        </Image>
                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="12" />
                    </vio:SimpleStackPanel>
                </DataTemplate>
            </FrameworkElement.Resources>
            <Grid>
                <vio:SimpleStackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:AboutStrings.Title}" />

                    <ui:CardControl Header="{x:Static props:AboutStrings.VersionLabel}">
                        <ui:CardControl.Icon>
                            <ui:SymbolIcon Symbol="Info24" />
                        </ui:CardControl.Icon>
                        <TextBlock x:Name="AppVersionTextBlock" Text="1.X.X.X" FontWeight="Bold" VerticalAlignment="Center" />
                    </ui:CardControl>

                    <ui:CardControl Header="{x:Static props:FeedbackStrings.About_FeedbackSection}">
                        <ui:CardControl.Icon>
                            <ui:SymbolIcon Symbol="Comment24" />
                        </ui:CardControl.Icon>
                        <Button x:Name="BtnReportIssue" Content="{x:Static props:FeedbackStrings.About_FeedbackButton}" Click="BtnReportIssue_Click" />
                    </ui:CardControl>

                    <ui:CardExpander ContentPadding="0" IsExpanded="True" d:Visibility="Visible" d:IsExpanded="True">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="{x:Static props:AboutStrings.DeviceInfo}" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <ui:CardExpander.Icon>
                            <ui:SymbolIcon Symbol="DeviceEq24" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <ui:CardControl Style="{StaticResource SettingsExpanderFirstRowStyle}" Header="{x:Static props:AboutStrings.DeviceIdLabel}">
                                <TextBlock x:Name="DeviceIdTextBlock" Text="{x:Static props:AboutStrings.DeviceInfo_Loading}" />
                            </ui:CardControl>
                            <ui:CardControl Style="{StaticResource SettingsExpanderRowStyle}" Header="{x:Static props:AboutStrings.UsageFrequencyLabel}">
                                <TextBlock x:Name="UsageFrequencyTextBlock" Text="{x:Static props:AboutStrings.DeviceInfo_Loading}" />
                            </ui:CardControl>
                            <ui:CardControl Style="{StaticResource SettingsExpanderRowStyle}" Header="{x:Static props:AboutStrings.UpdatePriorityLabel}">
                                <TextBlock x:Name="UpdatePriorityTextBlock" Text="{x:Static props:AboutStrings.DeviceInfo_Loading}" />
                            </ui:CardControl>
                            <ui:CardControl Style="{StaticResource SettingsExpanderRowStyle}" Header="{x:Static props:AboutStrings.LaunchCountLabel}">
                                <TextBlock x:Name="LaunchCountTextBlock" Text="{x:Static props:AboutStrings.DeviceInfo_Loading}" />
                            </ui:CardControl>
                            <ui:CardControl Style="{StaticResource SettingsExpanderRowStyle}" Header="{x:Static props:AboutStrings.TotalUsageLabel}">
                                <TextBlock x:Name="TotalUsageTextBlock" Text="{x:Static props:AboutStrings.DeviceInfo_Loading}" />
                            </ui:CardControl>
                            <ui:CardControl Style="{StaticResource SettingsExpanderRowStyle}" Header="">
                                <Button x:Name="RefreshDeviceInfoButton" Content="{x:Static props:AboutStrings.RefreshDeviceInfo}" Click="RefreshDeviceInfo_Click" />
                            </ui:CardControl>
                        </StackPanel>
                    </ui:CardExpander>

                    <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="4" BorderThickness="1" Padding="12,10" TextElement.FontSize="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8" TextElement.Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,3,0,0">
                                <ui:SymbolIcon Symbol="Info24" FontSize="24" />
                                <TextBlock FontSize="16" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Static props:AboutStrings.LicenseTitle}" />
                            </vio:SimpleStackPanel>

                            <vio:SimpleStackPanel Orientation="Vertical" Spacing="12" Grid.Row="1" Margin="5,10">
                                <FrameworkElement.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="LineHeight" Value="21" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </FrameworkElement.Resources>

                                <TextBlock Text="GNU General Public License v3.0" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="{x:Static props:AboutStrings.LicenseBody}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Separator Opacity="0.2" />
                            </vio:SimpleStackPanel>

                            <vio:SimpleStackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                                <ui:HyperlinkButton Content="ICC CE" NavigateUri="https://github.com/InkCanvasForClass/community/" />
                                <ui:HyperlinkButton Content="ICA" NavigateUri="https://github.com/ChangSakura/Ink-Canvas" />
                                <ui:HyperlinkButton Content="Ink Canvas" NavigateUri="https://github.com/WXRIW/Ink-Canvas" />
                            </vio:SimpleStackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:AboutStrings.DevelopersLabel}" />

                    <ItemsControl x:Name="DeveloperItemsControl" ItemTemplate="{StaticResource DeveloperAvatarTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemWidth="130" Margin="0,0,0,8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Separator Margin="0,8" />

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:AboutStrings.ThanksContributors}" />

                    <ItemsControl x:Name="ContributorItemsControl" ItemTemplate="{StaticResource ContributorAvatarTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemWidth="110" Margin="0,0,0,8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Separator Margin="0,8" />

                    <vio:SimpleStackPanel Spacing="3" Orientation="Vertical" Margin="0,0,0,24">
                        <TextBlock Text="{x:Static props:AboutStrings.Copyright}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Static props:AboutStrings.PhigrosCr}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Static props:AboutStrings.OpenSourceSlogan}" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </vio:SimpleStackPanel>

                    <Rectangle Height="48" />

                </vio:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
