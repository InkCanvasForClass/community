<?xml version="1.0" encoding="utf-8"?><Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.CanvasPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls" xmlns:c="clr-namespace:Ink_Canvas.Converter" xmlns:helpers="clr-namespace:Ink_Canvas.Windows.SettingsViews.Helpers" mc:Ignorable="d" Title="{x:Static props:CanvasStrings.Canvas_GroupTitle}">
    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <c:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                <Style x:Key="SettingsSectionHeaderTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>
            <Grid>
                <vio:SimpleStackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:CanvasStrings.Canvas_GroupTitle}" />

                    <!-- 画笔光标：开关 + 展开后选择系统/内置/自定义光标 -->
                    <ui:CardExpander x:Name="ExpanderShowPenCursor" IsExpanded="{Binding IsChecked, ElementName=ToggleSwitchShowCursor, Mode=OneWay}" d:Visibility="Visible" d:IsExpanded="True">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static props:CanvasStrings.Canvas_ShowPenCursor}" />
                                    <TextBlock Text="{x:Static props:CanvasStrings.Canvas_PenCursorTypeHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleSwitchShowCursor" helpers:SettingsBinder.PropertyPath="Canvas.IsShowCursor" helpers:SettingsBinder.SettingsChanged="OnIsShowCursorChanged" Grid.Column="1" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <ui:CardExpander.Icon>
                            <ui:SymbolIcon Symbol="HandRight24" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <ui:CardControl Header="{x:Static props:CanvasStrings.Canvas_PenCursorType}">
                                <ComboBox x:Name="ComboBoxPenCursorType" SelectedIndex="1" helpers:SettingsBinder.PropertyPath="Canvas.PenCursorType" helpers:SettingsBinder.SettingsChanged="OnPenCursorTypeChanged" SelectionChanged="ComboBoxPenCursorType_SelectionChanged">
                                    <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_PenCursorType_System}" />
                                    <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_PenCursorType_BuiltIn}" />
                                    <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_PenCursorType_Custom}" />
                                </ComboBox>
                            </ui:CardControl>
                            <ui:CardControl x:Name="CardCustomPenCursorPath" Visibility="Collapsed">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static props:CanvasStrings.Canvas_CustomPenCursorPath}" />
                                        <TextBlock Text="{x:Static props:CanvasStrings.Canvas_CustomPenCursorPathHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="CustomPenCursorPathText" VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                                    <Button Content="{x:Static props:CanvasStrings.Canvas_SelectCustomPenCursor}" Click="SelectCustomPenCursor_Click" />
                                </vio:SimpleStackPanel>
                            </ui:CardControl>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- 互斥开关：需要 code-behind 处理联动逻辑 -->
                    <controls:LabeledSettingsCard x:Name="CardEnablePressureTouchMode" Header="{x:Static props:CanvasStrings.Canvas_EnablePressureTouch}" Description="{x:Static props:CanvasStrings.Canvas_EnablePressureTouchHint}" Symbol="HandDraw24" SwitchName="ToggleSwitchEnablePressureTouchMode" Toggled="ToggleSwitchEnablePressureTouchMode_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardDisablePressure" Header="{x:Static props:CanvasStrings.Canvas_IgnorePressure}" Description="{x:Static props:CanvasStrings.Canvas_DisablePressureHint}" Symbol="HandDraw24" SwitchName="ToggleSwitchDisablePressure" Toggled="ToggleSwitchDisablePressure_Toggled" />

                    <!-- 实验性 WinRT 墨迹引擎：默认关闭，开启后由 MainWindow 挂载系统湿墨管线 -->
                    <controls:LabeledSettingsCard x:Name="CardUseWinRTInk" Header="{x:Static props:CanvasStrings.Canvas_UseWinRTInk}" Description="{x:Static props:CanvasStrings.Canvas_UseWinRTInkHint}" Symbol="Edit24" SwitchName="ToggleSwitchUseWinRTInk" Toggled="ToggleSwitchUseWinRTInk_Toggled" />

                    <!-- 简单下拉：声明式绑定 -->
                    <ui:CardControl>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{x:Static props:CanvasStrings.Canvas_EraserSize}" />
                                <TextBlock Text="{x:Static props:CanvasStrings.Canvas_EraserSizeHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:CardControl.Icon>
                            <ui:SymbolIcon Symbol="Eraser24" />
                        </ui:CardControl.Icon>
                        <ComboBox x:Name="ComboBoxEraserSize" SelectedIndex="1" helpers:SettingsBinder.PropertyPath="Canvas.EraserSize" helpers:SettingsBinder.SettingsChanged="OnEraserSizeChanged">
                            <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_EraserSize_VerySmall}" />
                            <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_EraserSize_Small}" />
                            <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_EraserSize_Medium}" />
                            <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_EraserSize_Large}" />
                            <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_EraserSize_VeryLarge}" />
                        </ComboBox>
                    </ui:CardControl>

                    <!-- 简单开关：声明式绑定 -->
                    <controls:LabeledSettingsCard Header="{x:Static props:CanvasStrings.Canvas_HideInkOnExit}" Description="{x:Static props:CanvasStrings.Canvas_HideStrokeWhenSelectingHint}" Symbol="EyeOff24" SwitchName="ToggleSwitchHideStrokeWhenSelecting" helpers:SettingsBinder.PropertyPath="Canvas.HideStrokeWhenSelecting" />

                    <controls:LabeledSettingsCard Header="{x:Static props:CanvasStrings.Canvas_ClearInkAlsoClearHistory}" Symbol="Delete24" SwitchName="ToggleSwitchClearCanvasAndClearTimeMachine" helpers:SettingsBinder.PropertyPath="Canvas.ClearCanvasAndClearTimeMachine" />

                    <controls:LabeledSettingsCard Header="{x:Static props:CanvasStrings.Canvas_ClearCanvasAlsoClearImages}" Symbol="Image24" SwitchName="ToggleSwitchClearCanvasAlsoClearImages" helpers:SettingsBinder.PropertyPath="Canvas.ClearCanvasAlsoClearImages" />

                    <!-- 长按撤销清屏：主开关 + 通知子开关。
                         主开关开启时自动展开显示子选项；子开关在总功能关闭时禁用（不可调节）。 -->
                    <ui:CardExpander x:Name="ExpanderLongPressUndoClear" IsExpanded="{Binding IsChecked, ElementName=ToggleSwitchLongPressUndoClear, Mode=OneWay}" d:Visibility="Visible" d:IsExpanded="True">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static props:CanvasStrings.Canvas_LongPressUndoClear}" />
                                    <TextBlock Text="{x:Static props:CanvasStrings.Canvas_LongPressUndoClearHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleSwitchLongPressUndoClear" helpers:SettingsBinder.PropertyPath="Canvas.EnableLongPressUndoClear" Grid.Column="1" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <ui:CardExpander.Icon>
                            <ui:SymbolIcon Symbol="ArrowUndo24" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <ui:CardControl IsEnabled="{Binding IsChecked, ElementName=ToggleSwitchLongPressUndoClear}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static props:CanvasStrings.Canvas_LongPressUndoClearNotify}" />
                                        <TextBlock Text="{x:Static props:CanvasStrings.Canvas_LongPressUndoClearNotifyHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch helpers:SettingsBinder.PropertyPath="Canvas.NotifyAfterLongPressUndoClear" />
                            </ui:CardControl>
                        </StackPanel>
                    </ui:CardExpander>

                    <controls:LabeledSettingsCard Header="{x:Static props:CanvasStrings.Canvas_CompressPicturesUploaded}" Symbol="ClearFormatting24" SwitchName="ToggleSwitchCompressPicturesUploaded" helpers:SettingsBinder.PropertyPath="Canvas.IsCompressPicturesUploaded" />

                    <controls:LabeledSettingsCard Header="{x:Static props:CanvasStrings.Canvas_LaunchSeewoVideoShowcaseForWhiteboardBooth}" Description="{x:Static props:CanvasStrings.Canvas_LaunchSeewoVideoShowcaseForWhiteboardBoothHint}" Symbol="Video24" SwitchName="ToggleSwitchLaunchSeewoVideoShowcaseForWhiteboardBooth" helpers:SettingsBinder.PropertyPath="Canvas.LaunchSeewoVideoShowcaseForWhiteboardBooth" />

                    <!-- 边缘扩展画布提示：主开关 + 白板限定子开关。
                         主开关开启时自动展开显示子选项；子开关在总功能关闭时禁用（不可调节）。 -->
                    <ui:CardExpander x:Name="ExpanderEdgeExpandHint" IsExpanded="{Binding IsChecked, ElementName=ToggleSwitchEdgeExpandHint, Mode=OneWay}" d:Visibility="Visible" d:IsExpanded="True">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static props:FloatingBarStrings.Canvas_EdgeExpandHint_Settings_Enable}" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleSwitchEdgeExpandHint" helpers:SettingsBinder.PropertyPath="Canvas.IsEnableEdgeExpandHint" Grid.Column="1" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <ui:CardExpander.Icon>
                            <ui:SymbolIcon Symbol="FullScreenMaximize24" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <ui:CardControl IsEnabled="{Binding IsChecked, ElementName=ToggleSwitchEdgeExpandHint}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static props:FloatingBarStrings.Canvas_EdgeExpandHint_Settings_WhiteboardOnly}" />
                                        <TextBlock Text="{x:Static props:FloatingBarStrings.Canvas_EdgeExpandHint_Settings_WhiteboardOnlyHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch helpers:SettingsBinder.PropertyPath="Canvas.IsEnableEdgeExpandHintWhiteboardOnly" />
                            </ui:CardControl>
                            <ui:CardControl IsEnabled="{Binding IsChecked, ElementName=ToggleSwitchEdgeExpandHint}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static props:FloatingBarStrings.Canvas_EdgeExpandHint_Settings_AutoHideDelay}" />
                                        <TextBlock Text="{x:Static props:FloatingBarStrings.Canvas_EdgeExpandHint_Settings_AutoHideDelayHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="EdgeExpandHintAutoHideDelayText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" />
                                    <Slider x:Name="EdgeExpandHintAutoHideDelaySlider" Width="200" Minimum="1" Maximum="30" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="EdgeExpandHintAutoHideDelaySlider_ValueChanged" />
                                </vio:SimpleStackPanel>
                            </ui:CardControl>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- 批注状态点提示：主开关 + 可展开详细配置。
                         主开关开启时自动展开显示子选项。 -->
                    <ui:CardExpander x:Name="ExpanderAnnotationDotHint">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static props:FloatingBarStrings.Canvas_AnnotationDotHint_Settings_Enable}" />
                                    <TextBlock Text="{x:Static props:FloatingBarStrings.Canvas_AnnotationDotHint_Settings_EnableHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleSwitchAnnotationDotHint" helpers:SettingsBinder.PropertyPath="Canvas.IsEnableAnnotationDotHint" Grid.Column="1" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <ui:CardExpander.Icon>
                            <ui:SymbolIcon Symbol="Info24" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <ui:CardControl IsEnabled="{Binding IsChecked, ElementName=ToggleSwitchAnnotationDotHint}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static props:FloatingBarStrings.Canvas_AnnotationDotHint_Settings_ClusterRadius}" />
                                        <TextBlock Text="连续点击位置在此半径范围内时触发提示" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="AnnotationDotHintClusterRadiusText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40" />
                                    <Slider x:Name="AnnotationDotHintClusterRadiusSlider" Width="200" Minimum="10" Maximum="200" Value="50" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="AnnotationDotHintClusterRadiusSlider_ValueChanged" />
                                </vio:SimpleStackPanel>
                            </ui:CardControl>
                            <ui:CardControl IsEnabled="{Binding IsChecked, ElementName=ToggleSwitchAnnotationDotHint}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static props:FloatingBarStrings.Canvas_AnnotationDotHint_Settings_StrokeLength}" />
                                        <TextBlock Text="笔迹包围盒最大边长小于此值视为点击" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="AnnotationDotHintStrokeLengthText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40" />
                                    <Slider x:Name="AnnotationDotHintStrokeLengthSlider" Width="200" Minimum="3" Maximum="30" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AnnotationDotHintStrokeLengthSlider_ValueChanged" />
                                </vio:SimpleStackPanel>
                            </ui:CardControl>
                            <ui:CardControl IsEnabled="{Binding IsChecked, ElementName=ToggleSwitchAnnotationDotHint}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static props:FloatingBarStrings.Canvas_AnnotationDotHint_Settings_ClickCount}" />
                                        <TextBlock Text="连续点击达到此次数时触发提示" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="AnnotationDotHintClickCountText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40" />
                                    <Slider x:Name="AnnotationDotHintClickCountSlider" Width="200" Minimum="2" Maximum="10" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AnnotationDotHintClickCountSlider_ValueChanged" />
                                </vio:SimpleStackPanel>
                            </ui:CardControl>
                            <ui:CardControl IsEnabled="{Binding IsChecked, ElementName=ToggleSwitchAnnotationDotHint}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static props:FloatingBarStrings.Canvas_AnnotationDotHint_Settings_DisplayDuration}" />
                                        <TextBlock Text="提示显示多少秒后自动隐藏" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="AnnotationDotHintDisplayDurationText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40" />
                                    <Slider x:Name="AnnotationDotHintDisplayDurationSlider" Width="200" Minimum="1" Maximum="30" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AnnotationDotHintDisplayDurationSlider_ValueChanged" />
                                </vio:SimpleStackPanel>
                            </ui:CardControl>
                            <ui:CardControl IsEnabled="{Binding IsChecked, ElementName=ToggleSwitchAnnotationDotHint}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static props:FloatingBarStrings.Canvas_AnnotationDotHint_Settings_Preview}" />
                                        <TextBlock Text="{x:Static props:FloatingBarStrings.Canvas_AnnotationDotHint_Settings_PreviewHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <Border x:Name="AnnotationDotHintPreviewBoard" Width="300" Height="180" Background="#10000000" BorderBrush="#30000000" BorderThickness="1" CornerRadius="6" ClipToBounds="True" Cursor="Pen" PreviewMouseLeftButtonDown="AnnotationDotHintPreviewBoard_MouseLeftButtonDown" PreviewMouseLeftButtonUp="AnnotationDotHintPreviewBoard_MouseLeftButtonUp">
                                    <Grid>
                                        <Ellipse x:Name="AnnotationDotHintPreviewZone" Stroke="#802563EB" StrokeThickness="2" StrokeDashArray="4,2" Fill="#102563EB" HorizontalAlignment="Center" VerticalAlignment="Center" Width="60" Height="60" />
                                        <Canvas x:Name="AnnotationDotHintPreviewCanvas" Background="Transparent" />
                                        <TextBlock x:Name="AnnotationDotHintPreviewLabel" Text="{x:Static props:FloatingBarStrings.Canvas_AnnotationDotHint_Settings_PreviewPlaceholder}" Foreground="#60000000" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </ui:CardControl>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- 简单下拉：声明式绑定 -->
                    <ui:CardControl>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{x:Static props:CanvasStrings.Canvas_KeepAsymptote}" />
                                <TextBlock Text="{x:Static props:CanvasStrings.Canvas_HyperbolaAsymptoteHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:CardControl.Icon>
                            <ui:SymbolIcon Symbol="ChartMultiple24" />
                        </ui:CardControl.Icon>
                        <ComboBox helpers:SettingsBinder.PropertyPath="Canvas.HyperbolaAsymptoteOption" SelectedIndex="0">
                            <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_Yes}" />
                            <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_No}" />
                            <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_AskEachTime}" />
                        </ComboBox>
                    </ui:CardControl>

                    <controls:LabeledSettingsCard Header="{x:Static props:CanvasStrings.Canvas_MergeInkSmoothingWithUndo}" Description="{x:Static props:CanvasStrings.Canvas_MergeInkSmoothingWithUndoHint}" Symbol="ArrowUndo24" SwitchName="ToggleSwitchMergeInkSmoothingWithUndo" helpers:SettingsBinder.PropertyPath="Canvas.MergeInkSmoothingWithUndo" />

                    <controls:LabeledSettingsCard Header="{x:Static props:CanvasStrings.Canvas_ShowCircleCenter}" Symbol="Circle24" SwitchName="ToggleSwitchShowCircleCenter" helpers:SettingsBinder.PropertyPath="Canvas.ShowCircleCenter" />

                    <controls:LabeledSettingsCard Header="{x:Static props:CanvasStrings.Canvas_ShowCoordinateUnitMarks}" Description="{x:Static props:CanvasStrings.Canvas_ShowCoordinateUnitMarksHint}" Symbol="Calculator24" SwitchName="ToggleSwitchShowCoordinateUnitMarks" helpers:SettingsBinder.PropertyPath="Canvas.ShowCoordinateUnitMarks" />

                    <!-- 复杂下拉：映射到两个设置属性，需要 code-behind -->
                    <ui:CardControl Header="{x:Static props:CanvasStrings.Canvas_CurveSmoothingMode}">
                        <ui:CardControl.Icon>
                            <ui:SymbolIcon Symbol="Pen24" />
                        </ui:CardControl.Icon>
                        <ComboBox x:Name="ComboBoxCurveSmoothingMode" SelectedIndex="2" SelectionChanged="ComboBoxCurveSmoothingMode_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_CurveSmoothing_Off}" Tag="0" />
                            <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_WPFBezier}" Tag="1" />
                            <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_AdvancedSmoothing}" Tag="2" />
                        </ComboBox>
                    </ui:CardControl>

                    <!-- Expander + ToggleSwitch：ToggleSwitch 用声明式，Expander.IsExpanded 由 XAML Binding 驱动 -->
                    <ui:CardExpander x:Name="ExpanderBrushAutoRestore" IsExpanded="{Binding IsChecked, ElementName=ToggleSwitchBrushAutoRestore, Mode=OneWay}" d:Visibility="Visible" d:IsExpanded="True">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static props:CanvasStrings.Canvas_BrushAutoRestore}" />
                                    <TextBlock Text="{x:Static props:CanvasStrings.Canvas_BrushAutoRestoreHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleSwitchBrushAutoRestore" helpers:SettingsBinder.PropertyPath="Canvas.EnableBrushAutoRestore" Grid.Column="1" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <ui:CardExpander.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <!-- TextBox：暂不支持声明式，保留 code-behind -->
                            <ui:CardControl Header="{x:Static props:CanvasStrings.Canvas_AutoRestoreTimePoints}">
                                <TextBox x:Name="BrushAutoRestoreTimesTextBox" Width="260" TextChanged="BrushAutoRestoreTimesTextBox_TextChanged" />
                            </ui:CardControl>
                            <!-- ComboBox by Tag：暂不支持声明式，保留 code-behind -->
                            <ui:CardControl Header="{x:Static props:CanvasStrings.Canvas_RestoreColor}">
                                <ComboBox x:Name="ComboBoxBrushAutoRestoreColor" SelectionChanged="ComboBoxBrushAutoRestoreColor_SelectionChanged">
                                    <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_Color_Default}" Tag="#FFFF0000" />
                                    <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_Color_Black}" Tag="#FF000000" />
                                    <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_Color_White}" Tag="#FFFFFFFF" />
                                    <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_Color_Red}" Tag="#FFFF0000" />
                                    <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_Color_Yellow}" Tag="#FFFFFF00" />
                                    <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_Color_Blue}" Tag="#FF2563EB" />
                                    <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_Color_Green}" Tag="#FF16A34A" />
                                    <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_Color_Orange}" Tag="#FFFB9650" />
                                    <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_Color_Purple}" Tag="#FF9333EA" />
                                </ComboBox>
                            </ui:CardControl>
                            <!-- Slider：声明式绑定 -->
                            <ui:CardControl Header="{x:Static props:CanvasStrings.Canvas_RestoreWidth}">
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="BrushAutoRestoreWidthText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" />
                                    <Slider x:Name="BrushAutoRestoreWidthSlider" Width="200" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="5" helpers:SettingsBinder.PropertyPath="Canvas.BrushAutoRestoreWidth" helpers:SettingsBinder.ValueRounding="2" helpers:SettingsBinder.FormatString="{}{0:F2}" helpers:SettingsBinder.TargetTextBlock="{Binding ElementName=BrushAutoRestoreWidthText}" />
                                </vio:SimpleStackPanel>
                            </ui:CardControl>
                            <ui:CardControl Header="{x:Static props:CanvasStrings.Canvas_RestoreOpacity}">
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="BrushAutoRestoreAlphaText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" />
                                    <Slider x:Name="BrushAutoRestoreAlphaSlider" Width="200" Minimum="0" Maximum="255" TickFrequency="5" IsSnapToTickEnabled="True" helpers:SettingsBinder.PropertyPath="Canvas.BrushAutoRestoreAlpha" helpers:SettingsBinder.ValueRounding="0" helpers:SettingsBinder.FormatString="{}{0:0}" helpers:SettingsBinder.TargetTextBlock="{Binding ElementName=BrushAutoRestoreAlphaText}" />
                                </vio:SimpleStackPanel>
                            </ui:CardControl>
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander x:Name="ExpanderEnableEraserAutoSwitchBack" IsExpanded="{Binding IsChecked, ElementName=ToggleSwitchEnableEraserAutoSwitchBack, Mode=OneWay}" d:Visibility="Visible" d:IsExpanded="True">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static props:CanvasStrings.Canvas_SwitchBackAfterEraser}" />
                                    <TextBlock Text="{x:Static props:CanvasStrings.Canvas_SwitchBackAfterEraserHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleSwitchEnableEraserAutoSwitchBack" helpers:SettingsBinder.PropertyPath="Canvas.EnableEraserAutoSwitchBack" Grid.Column="1" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <ui:CardExpander.Icon>
                            <ui:SymbolIcon Symbol="ArrowSwap24" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <ui:CardControl>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static props:CanvasStrings.Canvas_SwitchBackDelay}" />
                                        <TextBlock Text="{x:Static props:CanvasStrings.Canvas_SwitchBackDelayHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="EraserAutoSwitchBackDelayText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" />
                                    <Slider x:Name="EraserAutoSwitchBackDelaySlider" Width="200" Minimum="1" Maximum="60" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" helpers:SettingsBinder.PropertyPath="Canvas.EraserAutoSwitchBackDelaySeconds" helpers:SettingsBinder.ValueRounding="0" helpers:SettingsBinder.FormatString="{x:Static props:CanvasStrings.Canvas_SecondsFormat}" helpers:SettingsBinder.TargetTextBlock="{Binding ElementName=EraserAutoSwitchBackDelayText}" />
                                </vio:SimpleStackPanel>
                            </ui:CardControl>
                        </StackPanel>
                    </ui:CardExpander>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:GestureStrings.Gesture_Title}" />

                    <controls:LabeledSettingsCard Header="{x:Static props:GestureStrings.Gesture_AllowRotateScale}" Description="{x:Static props:GestureStrings.Gesture_AllowRotateScaleHint}" Symbol="ArrowRotateClockwise24" SwitchName="ToggleSwitchEnableTwoFingerRotationOnSelection" helpers:SettingsBinder.PropertyPath="Gesture.IsEnableTwoFingerRotationOnSelection" />

                    <ui:CardExpander x:Name="ExpanderEnablePalmEraser" IsExpanded="{Binding IsChecked, ElementName=ToggleSwitchEnablePalmEraser, Mode=OneWay}" d:Visibility="Visible" d:IsExpanded="True">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static props:GestureStrings.Gesture_EnablePalmEraser}" />
                                    <TextBlock Text="{x:Static props:GestureStrings.Gesture_PalmHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleSwitchEnablePalmEraser" helpers:SettingsBinder.PropertyPath="Canvas.EnablePalmEraser" Grid.Column="1" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <ui:CardExpander.Icon>
                            <ui:SymbolIcon Symbol="Eraser24" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <ui:CardControl Header="{x:Static props:GestureStrings.Gesture_PalmSensitivity}">
                                <ComboBox helpers:SettingsBinder.PropertyPath="Canvas.PalmEraserSensitivity">
                                    <ComboBoxItem Content="{x:Static props:GestureStrings.Gesture_PalmSensitivityLow}" />
                                    <ComboBoxItem Content="{x:Static props:GestureStrings.Gesture_PalmSensitivityMedium}" />
                                    <ComboBoxItem Content="{x:Static props:GestureStrings.Gesture_PalmSensitivityHigh}" />
                                </ComboBox>
                            </ui:CardControl>
                        </StackPanel>
                    </ui:CardExpander>

                    <Rectangle Height="48" />

                </vio:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
