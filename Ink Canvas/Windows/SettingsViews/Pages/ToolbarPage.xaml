<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.ToolbarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:dd="urn:gong-wpf-dragdrop"
      xmlns:toolbar="clr-namespace:Ink_Canvas.Controls.Toolbar.FloatingToolbar"
      mc:Ignorable="d"
      Title="工具栏">

    <Page.Resources>
        <local:IdToDisplayNameConverter x:Key="IdToNameConverter"/>
        <local:ConditionIdToNameConverter x:Key="ConditionIdToNameConverter"/>
        <local:StateToBrushConverter x:Key="StateToBrushConverter"/>
        <local:LogicalModeToIntConverter x:Key="LogicalModeToIntConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <DataTemplate x:Key="AddedItemTemplate" DataType="{x:Type toolbar:ToolbarComponentEntry}">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6" Padding="10,6" Margin="2"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE76F;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.45"/>
                    <TextBlock Text="{Binding Id, Converter={StaticResource IdToNameConverter}}"
                               VerticalAlignment="Center" FontSize="13"/>
                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Click="RemoveItem_Click" Margin="8,0,0,0"
                            Background="Transparent" BorderThickness="0"
                            Padding="4,2" VerticalAlignment="Center"
                            Cursor="Hand"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GroupChildItemTemplate" DataType="{x:Type toolbar:ToolbarComponentEntry}">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6" Padding="8,4" Margin="2"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE76F;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.45"/>
                    <TextBlock Text="{Binding Id, Converter={StaticResource IdToNameConverter}}"
                               VerticalAlignment="Center" FontSize="12"/>
                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                            Click="RemoveGroupChildItem_Click" Margin="6,0,0,0"
                            Background="Transparent" BorderThickness="0"
                            Padding="3,1" VerticalAlignment="Center"
                            Cursor="Hand"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LibraryItemTemplate">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6" Padding="10,8" Margin="3" Width="200"
                    Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" FontSize="13"/>
                        <TextBlock Text="{Binding Description}" Opacity="0.65" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Click="AddLibraryItem_Click"
                            Background="Transparent" BorderThickness="0"
                            Padding="6,4" VerticalAlignment="Center"
                            ToolTip="{x:Static props:FloatingBarStrings.ToolbarPage_AddToAdded}"
                            Cursor="Hand"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="DragDropListBoxStyle" TargetType="ListBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="dd:DragDrop.IsDragSource" Value="True"/>
            <Setter Property="dd:DragDrop.IsDropTarget" Value="True"/>
            <Setter Property="dd:DragDrop.UseDefaultEffectDataTemplate" Value="False"/>
            <Setter Property="dd:DragDrop.DropTargetAdornerBrush" Value="#2563eb"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="PageScrollViewer" PanningMode="VerticalFirst">
        <ikw:SimpleStackPanel Spacing="4" Margin="24,0,24,0">

            <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_ConfigProfiles}" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,6"/>
            <DockPanel Margin="0,0,0,4">
                <ComboBox x:Name="ComboBoxConfigFile" SelectionChanged="ComboBoxConfigFile_SelectionChanged"
                          DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="{x:Static props:FloatingBarStrings.ToolbarPage_NewProfile}" Click="ButtonNewConfig_Click" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="{x:Static props:FloatingBarStrings.ToolbarPage_DuplicateProfile}" Click="ButtonDuplicateConfig_Click" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="{x:Static props:FloatingBarStrings.ToolbarPage_DeleteProfile}" Click="ButtonDeleteConfig_Click" Padding="12,6"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_AddedComponentsHint}"
                       Opacity="0.65" FontSize="13" Margin="0,8,0,12" TextWrapping="Wrap"/>

            <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_AddedComponents}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="6"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    MinHeight="64">
                <ListBox x:Name="AddedList"
                         ItemsSource="{Binding AddedComponents}"
                         ItemTemplate="{StaticResource AddedItemTemplate}"
                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                         Style="{StaticResource DragDropListBoxStyle}"
                         dd:DragDrop.DropHandler="{Binding}"
                         MinHeight="48">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>

            <!-- 分组内组件 -->
            <StackPanel x:Name="GroupChildrenPanel" Margin="0,8,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedEntry.IsGroup}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_GroupChildren}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_GroupChildrenHint}"
                           Opacity="0.65" FontSize="12" Margin="0,0,0,6"/>
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="4"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        MinHeight="40">
                    <ListBox x:Name="GroupChildrenListBox"
                             ItemsSource="{Binding GroupChildren}"
                             ItemTemplate="{StaticResource GroupChildItemTemplate}"
                             SelectedItem="{Binding SelectedGroupChild, Mode=TwoWay}"
                             Style="{StaticResource DragDropListBoxStyle}"
                             dd:DragDrop.DropHandler="{Binding GroupDropHandler}"
                             MinHeight="32">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Border>
            </StackPanel>

            <!-- TabControl: 组件库 / 组件设置 / 高级设置 -->
            <TabControl x:Name="SettingsTabControl" Margin="0,12,0,0"
                        Style="{StaticResource {x:Static ui:ThemeKeys.TabControlPivotStyleKey}}"
                        SelectedIndex="{Binding SettingsTabIndex}">

                <!-- ===== Tab 1: 组件库 ===== -->
                <TabItem Header="{x:Static props:FloatingBarStrings.ToolbarPage_ComponentLibrary}">
                    <ScrollViewer PanningMode="VerticalFirst" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="NestedScrollViewer_PreviewMouseWheel">
                        <ikw:SimpleStackPanel Spacing="4" Margin="0,8,0,0">
                            <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_ComponentLibraryHint}"
                                       Opacity="0.65" FontSize="12" Margin="0,0,0,8"/>
                            <ListBox ItemsSource="{Binding AvailableItems}"
                                     ItemTemplate="{StaticResource LibraryItemTemplate}"
                                     dd:DragDrop.IsDragSource="True"
                                     Background="Transparent" BorderThickness="0"
                                     SelectionMode="Single">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </ikw:SimpleStackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 2: 组件设置 ===== -->
                <TabItem Header="{x:Static props:FloatingBarStrings.ToolbarPage_ComponentSettings}">
                    <TabItem.Visibility>
                        <Binding Path="SelectedEntry" Converter="{StaticResource NullToVisibilityConverter}"/>
                    </TabItem.Visibility>
                    <ScrollViewer PanningMode="VerticalFirst" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="NestedScrollViewer_PreviewMouseWheel">
                        <ikw:SimpleStackPanel Spacing="4" Margin="0,8,0,0">

                            <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_ComponentProperties}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ui:SettingsCard Header="{x:Static props:FloatingBarStrings.ToolbarPage_SeparateBorder}" Description="{x:Static props:FloatingBarStrings.ToolbarPage_SeparateBorderDesc}">
                                <CheckBox x:Name="CheckBoxShowSeparateBorder"
                                          Checked="CheckBoxShowSeparateBorder_Changed"
                                          Unchecked="CheckBoxShowSeparateBorder_Changed"/>
                            </ui:SettingsCard>

                            <ui:SettingsCard Header="{x:Static props:FloatingBarStrings.ToolbarPage_RedStyle}" Description="{x:Static props:FloatingBarStrings.ToolbarPage_RedStyleDesc}">
                                <CheckBox x:Name="CheckBoxUseRedStyle"
                                          Checked="CheckBoxUseRedStyle_Changed"
                                          Unchecked="CheckBoxUseRedStyle_Changed"/>
                            </ui:SettingsCard>

                            <StackPanel x:Name="PanelQuickColorPaletteDisplayMode" Visibility="Collapsed">
                                <ui:SettingsCard Header="{x:Static props:FloatingBarStrings.ToolbarPage_DisplayMode}" Description="{x:Static props:FloatingBarStrings.ToolbarPage_QuickPaletteDisplayModeDesc}">
                                    <ComboBox x:Name="ComboBoxDisplayMode"
                                              SelectionChanged="ComboBoxDisplayMode_SelectionChanged">
                                        <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_QuickPalette_DoubleRow}" Tag="1"/>
                                        <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_QuickPalette_SingleRow}" Tag="0"/>
                                    </ComboBox>
                                </ui:SettingsCard>
                            </StackPanel>

                            <!-- 插件自定义设置面板（动态生成） -->
                            <StackPanel x:Name="PanelPluginCustomSettings" Visibility="Collapsed">
                            </StackPanel>

                            <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_Size}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                                    <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_FixedWidth}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TextBoxFixedWidth" Width="80" HorizontalAlignment="Left"
                                             TextChanged="ComponentSetting_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                                    <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_FixedHeight}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TextBoxFixedHeight" Width="80" HorizontalAlignment="Left"
                                             TextChanged="ComponentSetting_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,4">
                                    <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_MinWidth}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TextBoxMinWidth" Width="80" HorizontalAlignment="Left"
                                             TextChanged="ComponentSetting_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,4">
                                    <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_MaxWidth}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TextBoxMaxWidth" Width="80" HorizontalAlignment="Left"
                                             TextChanged="ComponentSetting_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_MinHeight}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TextBoxMinHeight" Width="80" HorizontalAlignment="Left"
                                             TextChanged="ComponentSetting_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_MaxHeight}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TextBoxMaxHeight" Width="80" HorizontalAlignment="Left"
                                             TextChanged="ComponentSetting_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_Alignment}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_HorizontalAlignment}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="ComboBoxHAlign" HorizontalAlignment="Left"
                                              SelectionChanged="ComponentAlignment_Changed">
                                        <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_Color_Default}" Tag=""/>
                                        <ComboBoxItem Content="{x:Static props:FloatingBarStrings.ToolbarPage_Left}" Tag="Left"/>
                                        <ComboBoxItem Content="{x:Static props:FloatingBarStrings.ToolbarPage_Center}" Tag="Center"/>
                                        <ComboBoxItem Content="{x:Static props:FloatingBarStrings.ToolbarPage_Right}" Tag="Right"/>
                                        <ComboBoxItem Content="{x:Static props:FloatingBarStrings.ToolbarPage_Stretch}" Tag="Stretch"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_VerticalAlignment}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="ComboBoxVAlign" HorizontalAlignment="Left"
                                              SelectionChanged="ComponentAlignment_Changed">
                                        <ComboBoxItem Content="{x:Static props:CanvasStrings.Canvas_Color_Default}" Tag=""/>
                                        <ComboBoxItem Content="{x:Static props:FloatingBarStrings.ToolbarPage_Top}" Tag="Top"/>
                                        <ComboBoxItem Content="{x:Static props:FloatingBarStrings.ToolbarPage_Center}" Tag="Center"/>
                                        <ComboBoxItem Content="{x:Static props:FloatingBarStrings.ToolbarPage_Bottom}" Tag="Bottom"/>
                                        <ComboBoxItem Content="{x:Static props:FloatingBarStrings.ToolbarPage_Stretch}" Tag="Stretch"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_Appearance}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_FontSize}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TextBoxFontSize" Width="60" HorizontalAlignment="Left"
                                             TextChanged="ComponentSetting_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_IconSize}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TextBoxIconSize" Width="60" HorizontalAlignment="Left"
                                             TextChanged="ComponentSetting_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_Opacity}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TextBoxOpacity" Width="60" HorizontalAlignment="Left"
                                             TextChanged="ComponentSetting_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_Margin}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_MarginHint}" FontSize="12" Opacity="0.65" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TextBoxMarginLeft" Grid.Column="0" Margin="0,0,2,0"
                                         TextChanged="ComponentSetting_TextChanged"/>
                                <TextBox x:Name="TextBoxMarginTop" Grid.Column="1" Margin="2,0,2,0"
                                         TextChanged="ComponentSetting_TextChanged"/>
                                <TextBox x:Name="TextBoxMarginRight" Grid.Column="2" Margin="2,0,2,0"
                                         TextChanged="ComponentSetting_TextChanged"/>
                                <TextBox x:Name="TextBoxMarginBottom" Grid.Column="3" Margin="2,0,0,0"
                                         TextChanged="ComponentSetting_TextChanged"/>
                            </Grid>

                            <Button Content="{x:Static props:FloatingBarStrings.ToolbarPage_ResetComponentSettings}" Click="ButtonResetComponentSettings_Click"
                                    Padding="12,6" HorizontalAlignment="Left" Margin="0,8,0,0"/>

                        </ikw:SimpleStackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tab 3: 高级设置 ===== -->
                <TabItem Header="{x:Static props:NavStrings.Nav_Advanced_Settings}">
                    <TabItem.Visibility>
                        <Binding Path="SelectedEntry" Converter="{StaticResource NullToVisibilityConverter}"/>
                    </TabItem.Visibility>
                    <ScrollViewer PanningMode="VerticalFirst" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="NestedScrollViewer_PreviewMouseWheel">
                        <ikw:SimpleStackPanel Spacing="4" Margin="0,8,0,0">

                            <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_HideByRules}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_HideByRulesDesc}"
                                       Opacity="0.65" FontSize="12" Margin="0,0,0,8"/>

                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                <StackPanel>
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <ComboBox x:Name="ComboBoxRulesetMode"
                                                  SelectionChanged="ComboBoxRulesetMode_SelectionChanged">
                                            <ComboBoxItem Content="{x:Static props:FloatingBarStrings.ToolbarPage_AnyConditionGroupMet}"/>
                                            <ComboBoxItem Content="{x:Static props:FloatingBarStrings.ToolbarPage_AllConditionGroupsMet}"/>
                                        </ComboBox>
                                        <CheckBox Content="{x:Static props:FloatingBarStrings.ToolbarPage_Reverse}" x:Name="CheckBoxRulesetReversed"
                                                  Checked="CheckBoxRulesetReversed_Changed"
                                                  Unchecked="CheckBoxRulesetReversed_Changed"
                                                  Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <Button Content="{x:Static props:FloatingBarStrings.ToolbarPage_AddGroup}" Click="ButtonAddGroup_Click"
                                                Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseRulesetState" Width="10" Height="10"
                                                 Margin="8,0,0,0" VerticalAlignment="Center"
                                                 Fill="{Binding State, Converter={StaticResource StateToBrushConverter}}"/>
                                    </WrapPanel>

                                    <ItemsControl x:Name="ItemsControlGroups">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="8"
                                                        Margin="0,4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                                    <StackPanel>
                                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <ComboBox SelectedIndex="{Binding Mode, Converter={StaticResource LogicalModeToIntConverter}, Mode=OneWay}"
                                                                      SelectionChanged="ComboBoxGroupMode_SelectionChanged"
                                                                      Tag="{Binding}">
                                                                <ComboBoxItem Content="{x:Static props:FloatingBarStrings.ToolbarPage_AnyConditionMet}"/>
                                                                <ComboBoxItem Content="{x:Static props:FloatingBarStrings.ToolbarPage_AllConditionsMet}"/>
                                                            </ComboBox>
                                                            <CheckBox Content="{x:Static props:FloatingBarStrings.ToolbarPage_Reverse}" IsChecked="{Binding IsReversed}"
                                                                      Checked="CheckBoxGroupReversed_Changed"
                                                                      Unchecked="CheckBoxGroupReversed_Changed"
                                                                      Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                            <Button Content="{x:Static props:FloatingBarStrings.ToolbarPage_Rule}" Click="ButtonAddRule_Click"
                                                                    Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                    Tag="{Binding}"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                                                <Ellipse Width="8" Height="8" Margin="0,0,4,0"
                                                                         Fill="{Binding State, Converter={StaticResource StateToBrushConverter}}"/>
                                                                <ui:ToggleSwitch IsOn="{Binding IsEnabled}"
                                                                                  Toggled="CheckBoxGroupEnabled_Changed"
                                                                                  ToolTip="{x:Static props:FloatingBarStrings.ToolbarPage_EnableConditionGroup}" Margin="0,0,4,0"/>
                                                                <Button Content="{x:Static props:FloatingBarStrings.ToolbarPage_Duplicate}" Click="ButtonDuplicateGroup_Click"
                                                                        Padding="4,2" Margin="0,0,4,0" Tag="{Binding}"/>
                                                                <Button Content="{x:Static props:FloatingBarStrings.ToolbarPage_DeleteProfile}" Click="ButtonDeleteGroup_Click"
                                                                        Padding="4,2" Tag="{Binding}"/>
                                                            </StackPanel>
                                                        </WrapPanel>

                                                        <ItemsControl ItemsSource="{Binding Rules}" Margin="4,0,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Button Grid.Column="0" Content="✕" FontSize="10"
                                                                                Click="ButtonDeleteRule_Click"
                                                                                Padding="4,1" Margin="0,0,4,0"
                                                                                Tag="{Binding}"/>
                                                                        <Ellipse Grid.Column="1" Width="8" Height="8"
                                                                                 Margin="0,0,4,0" VerticalAlignment="Center"
                                                                                 Fill="{Binding State, Converter={StaticResource StateToBrushConverter}}"/>
                                                                        <CheckBox Grid.Column="2" Content="{x:Static props:FloatingBarStrings.ToolbarPage_Reverse}"
                                                                                  IsChecked="{Binding IsReversed}"
                                                                                  Checked="CheckBoxRuleReversed_Changed"
                                                                                  Unchecked="CheckBoxRuleReversed_Changed"
                                                                                  Margin="0,0,4,0"/>
                                                                        <ComboBox Grid.Column="3"
                                                                                  SelectedValue="{Binding ConditionId}"
                                                                                  SelectedValuePath="Key"
                                                                                  DisplayMemberPath="Value"
                                                                                  SelectionChanged="ComboBoxRuleCondition_SelectionChanged"
                                                                                  ItemsSource="{x:Static toolbar:ToolbarRegistry.AvailableConditions}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
