<Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.ExperimentalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
      mc:Ignorable="d"

      Title="{x:Static props:AdvancedStrings.Experimental}">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
            <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
            <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                TargetType="TextBlock">
                <Style.Setters>
                    <Setter Property="Margin" Value="1,30,0,6" />
                </Style.Setters>
            </Style>
        </FrameworkElement.Resources>
            <Grid>
                <vio:SimpleStackPanel MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

                    <controls:LabeledSettingsCard x:Name="CardFullScreenHelper"
                            Header="{x:Static props:AdvancedStrings.FullScreenHelper}"
                            Description="{x:Static props:AdvancedStrings.FullScreenHelperHint}"
                            Symbol="FullScreenMaximize24"
                            SwitchName="ToggleSwitchFullScreenHelper"
                            Toggled="ToggleSwitchFullScreenHelper_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardEdgeGestureUtil"
                            Header="{x:Static props:AdvancedStrings.EdgeGestureUtil}"
                            Description="{x:Static props:AdvancedStrings.EdgeGestureUtilHint_Part1}"
                            Symbol="AlignLeft24"
                            SwitchName="ToggleSwitchEdgeGestureUtil"
                            Toggled="ToggleSwitchEdgeGestureUtil_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardForceFullScreen"
                            Header="{x:Static props:AdvancedStrings.ForceFullScreen}"
                            Description="{x:Static props:AdvancedStrings.ForceFullScreenHint}"
                            Symbol="Video24"
                            SwitchName="ToggleSwitchForceFullScreen"
                            Toggled="ToggleSwitchForceFullScreen_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardDPIChangeDetection"
                            Header="{x:Static props:AdvancedStrings.DPIChangeDetection}"
                            Description="{x:Static props:AdvancedStrings.DPIChangeDetectionHint}"
                            Symbol="Eye24"
                            SwitchName="ToggleSwitchDPIChangeDetection"
                            Toggled="ToggleSwitchDPIChangeDetection_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardResolutionChangeDetection"
                            Header="{x:Static props:AdvancedStrings.ResolutionChangeDetection}"
                            Description="{x:Static props:AdvancedStrings.ResolutionChangeDetectionHint}"
                            Symbol="Checkmark24"
                            SwitchName="ToggleSwitchResolutionChangeDetection"
                            Toggled="ToggleSwitchResolutionChangeDetection_Toggled" />

                    <Rectangle Height="48" />

                </vio:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
