<ui:Page x:Class="Ink_Canvas.Windows.SettingsViews.Pages.CloudStoragePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d"
      Title="云存储与自动上传">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                    BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                    TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>

            <ikw:SimpleStackPanel MaxWidth="1000"
                HorizontalAlignment="Stretch"
                Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="云存储与自动上传" />

                <ui:SettingsExpander Header="通用上传设置"
                                     Description="管理所有上传提供者的启用状态和统一上传延迟。">
                    <ui:SettingsExpander.HeaderIcon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Upload}"/>
                    </ui:SettingsExpander.HeaderIcon>
                    <ui:SettingsExpander.Items>
                        <ui:SettingsCard Header="上传延迟时间"
                                         Description="设置自动上传前等待的时间（0-60 分钟），所有上传提供者都会遵循此设置。">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBox x:Name="TxtUniversalUploadDelayMinutes"
                                         Width="80"
                                         TextChanged="TxtUniversalUploadDelayMinutes_TextChanged"
                                         PreviewTextInput="TxtUniversalUploadDelayMinutes_PreviewTextInput" />
                                <TextBlock Text="分钟" VerticalAlignment="Center" />
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="上传提供者"
                                         Description="选择保存截图和墨迹文件后自动上传到哪些云存储服务。"
                                         ContentAlignment="Stretch">
                            <ItemsControl x:Name="LstUploadProviders">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <ui:ToggleSwitch Grid.Column="1"
                                                             IsOn="{Binding IsEnabled, Mode=OneWay}"
                                                             OnContent="启用"
                                                             OffContent="关闭"
                                                             Toggled="ToggleProviderEnabled_Toggled" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>

                <ui:SettingsExpander x:Name="DlassSettingsExpander"
                                     Header="Dlass"
                                     Description="管理 Dlass Token、连接状态、班级选择和自动上传笔记。">
                    <ui:SettingsExpander.HeaderIcon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Cloud}"/>
                    </ui:SettingsExpander.HeaderIcon>
                    <ui:SettingsExpander.Items>
                        <ui:SettingsCard Header="用户 Token"
                                         Description="设置用于访问 Dlass 服务端功能的用户 Token。"
                                         ContentAlignment="Stretch">
                            <ikw:SimpleStackPanel Spacing="8">
                                <ComboBox x:Name="CmbSavedTokens"
                                          SelectionChanged="CmbSavedTokens_SelectionChanged" />
                                <TextBox x:Name="TxtNewToken" />
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BtnSaveToken" Content="保存 Token" Click="BtnSaveToken_Click" />
                                    <Button x:Name="BtnClearToken" Content="清除 Token" Click="BtnClearToken_Click" />
                                    <Button x:Name="BtnTestToken" Content="测试连接" Click="BtnTestToken_Click" />
                                </ikw:SimpleStackPanel>
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Token 状态：" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtTokenStatus" Text="" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </ikw:SimpleStackPanel>
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="连接状态：" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtConnectionStatus" Text="未连接" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </ikw:SimpleStackPanel>
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="班级选择"
                                         Description="连接成功后会自动加载可用班级列表。">
                            <ComboBox x:Name="CmbClassSelection"
                                      MinWidth="260"
                                      SelectionChanged="CmbClassSelection_SelectionChanged" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="自动上传笔记"
                                         Description="启用后，保存的 PNG 截图和 ICSTK 墨迹文件会自动上传到所选班级的白板。">
                            <ui:ToggleSwitch x:Name="ToggleSwitchAutoUploadNotes"
                                             OnContent="启用"
                                             OffContent="关闭"
                                             Toggled="ToggleSwitchAutoUploadNotes_Toggled" />
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>

                <ui:SettingsExpander Header="WebDav"
                                     Description="管理 WebDav 服务器连接参数（Beta）。">
                    <ui:SettingsExpander.HeaderIcon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Cloud}"/>
                    </ui:SettingsExpander.HeaderIcon>
                    <ui:SettingsExpander.Items>
                        <ui:SettingsCard Header="WebDav 地址"
                                         Description="设置 WebDav 服务器地址。">
                            <TextBox x:Name="TxtWebDavUrl" MinWidth="280" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="用户名"
                                         Description="设置 WebDav 用户名。">
                            <TextBox x:Name="TxtWebDavUsername" MinWidth="220" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="密码"
                                         Description="设置 WebDav 密码。">
                            <PasswordBox x:Name="TxtWebDavPassword" MinWidth="220" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="根目录"
                                         Description="设置 WebDav 根目录路径。">
                            <TextBox x:Name="TxtWebDavRootDirectory" MinWidth="220" />
                        </ui:SettingsCard>
                        <ui:SettingsCard ContentAlignment="Right">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="保存 WebDav 设置" Click="BtnSaveWebDav_Click" />
                                <Button Content="取消" Click="BtnCancelWebDav_Click" />
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>

                <Rectangle Height="48" />

            </ikw:SimpleStackPanel>
        </Grid>
    </ScrollViewer>
</ui:Page>
