                                        Toggled="ToggleSwitchIntelligentClassFloating_Toggled"/>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>

                    <TextBlock Text="文件关联" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                    <ui:SettingsExpander Header="检查关联状态"
                                         Description="查看 .icstk 文件是否已关联到 Ink Canvas">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Link}"/>
                        </ui:SettingsExpander.HeaderIcon>
                        <ui:SettingsExpander.Content>
                            <ikw:SimpleStackPanel Orientation="Horizontal"
                                                  Spacing="8"
                                                  VerticalAlignment="Center">
                                <TextBlock x:Name="TextBlockFileAssociationStatus"
                                           Text="未检查"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>
                                <Button x:Name="BtnCheckFileAssociation"
                                        Content="检查关联状态"
                                        Click="BtnCheckFileAssociation_Click"/>
                            </ikw:SimpleStackPanel>
                        </ui:SettingsExpander.Content>
                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard Header="注册文件关联"
                                             Description="将 .icstk 文件关联到 Ink Canvas">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Add}"/>
                                </ui:SettingsCard.HeaderIcon>
                                <Button x:Name="BtnRegisterFileAssociation"
                                        Content="注册文件关联"
                                        Click="BtnRegisterFileAssociation_Click"/>
                            </ui:SettingsCard>
                            <ui:SettingsCard Header="取消文件关联"
                                             Description="移除 .icstk 文件与 Ink Canvas 的关联">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Cancel}"/>
                                </ui:SettingsCard.HeaderIcon>
                                <Button x:Name="BtnUnregisterFileAssociation"
                                        Content="取消文件关联"
                                        Click="BtnUnregisterFileAssociation_Click"/>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>

                    <Rectangle Height="48" />
                </ikw:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</ui:Page>
