                            <ui:SettingsCard Header="畅言智慧课堂">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:ImageIcon Source="/Resources/Icons-png/畅言智慧课堂.png"/>
                                </ui:SettingsCard.HeaderIcon>
                                <ui:ToggleSwitch x:Name="ToggleSwitchChangYanFloating"
                                        OnContent="{DynamicResource Common_On}"
