                            <ui:SettingsCard Header="鸿合屏幕书写">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:ImageIcon Source="/Resources/Icons-png/HiteAnnotation.png"/>
                                </ui:SettingsCard.HeaderIcon>
