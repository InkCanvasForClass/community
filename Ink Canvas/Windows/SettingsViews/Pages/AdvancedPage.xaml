<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.AdvancedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
      mc:Ignorable="d"
      Title="{x:Static props:AdvancedStrings.Title}">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                    BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                    TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>
            <Grid>
                <ikw:SimpleStackPanel MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:AdvancedStrings.Title}" />

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchIsSpecialScreen"
                        Header="{x:Static props:AdvancedStrings.SpecialScreenMode}"
                        Icon="{x:Static ui:SegoeFluentIcons.Settings}"
                        IsOn="True"
                        Toggled="ToggleSwitchIsSpecialScreen_OnToggled"/>

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchDisableHardwareAcceleration"
                        Header="{x:Static props:CanvasStrings.Canvas_DisableHardwareAcceleration}"
                        Description="{x:Static props:CanvasStrings.Canvas_DisableHardwareAccelerationHint}"
                        Icon="{x:Static ui:SegoeFluentIcons.Settings}"
                        IsOn="False"
                        Toggled="ToggleSwitchDisableHardwareAcceleration_Toggled"/>

                    <ui:SettingsExpander x:Name="CardTouchMultiplier"
                                         Header="{x:Static props:AdvancedStrings.TouchMultiplier}"
                                         Description="{x:Static props:AdvancedStrings.TouchMultiplierHint}"
                                         IsExpanded="True">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Touch}" />
                        </ui:SettingsExpander.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="TouchMultiplierText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="TouchMultiplierSlider"
                                    Minimum="0" Maximum="2"
                                    Width="200"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="0.01" TickPlacement="None"
                                    ValueChanged="TouchMultiplierSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard Header="{x:Static props:AdvancedStrings.TouchMultiplierCalibrateHint}"
                                             ContentAlignment="Left">
                                <ikw:SimpleStackPanel Spacing="8" Margin="0,4,0,4">
                                    <TextBlock Text="{x:Static props:AdvancedStrings.TouchMultiplierValueHint}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="420" />
                                    <Border Margin="0,0,20,0" CornerRadius="4" Height="48" Background="Transparent"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="2"
                                            TouchDown="BorderCalculateMultiplier_TouchDown" />
                                    <TextBlock x:Name="TextBlockShowCalculatedMultiplier" FontSize="14" />
                                    <TextBlock x:Name="TextBlockShowRawValue" FontSize="14"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </ikw:SimpleStackPanel>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchEraserBindTouchMultiplier"
                        Header="{x:Static props:AdvancedStrings.EraserBindTouchMultiplier}"
                        Description="{x:Static props:AdvancedStrings.EraserBindTouchHint}"
                        Icon="{x:Static ui:SegoeFluentIcons.EraseTool}"
                        IsOn="True"
                        Toggled="ToggleSwitchEraserBindTouchMultiplier_Toggled"/>

                    <ui:SettingsCard Header="{x:Static props:AdvancedStrings.NibModeBoundsWidthHeader}">
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="NibModeBoundsWidthText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="NibModeBoundsWidthSlider"
                                    Minimum="1" Maximum="50" Width="200"
                                    IsSnapToTickEnabled="True" TickFrequency="1" Value="5"
                                    TickPlacement="None"
                                    ValueChanged="NibModeBoundsWidthSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:AdvancedStrings.FingerModeBoundsWidthHeader}">
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="FingerModeBoundsWidthText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="FingerModeBoundsWidthSlider"
                                    Minimum="1" Maximum="50" Width="200"
                                    IsSnapToTickEnabled="True" TickFrequency="1" Value="20"
                                    TickPlacement="None"
                                    ValueChanged="FingerModeBoundsWidthSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchIsQuadIR"
                        Header="{x:Static props:AdvancedStrings.QuadIRMode}"
                        Icon="{x:Static ui:SegoeFluentIcons.FullScreen}"
                        IsOn="True"
                        Toggled="ToggleSwitchIsQuadIR_Toggled"/>

                    <ui:SettingsExpander x:Name="CardAutoCalibrate"
                                         Header="自动校准触摸参数"
                                         Description="通过三次触摸自动计算合适的笔尖/手指阈值和触摸倍率"
                                         IsExpanded="False">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.EaseOfAccess}" />
                        </ui:SettingsExpander.HeaderIcon>
                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard Header="校准步骤" ContentAlignment="Left">
                                <ikw:SimpleStackPanel Spacing="8" Margin="0,4,0,4">
                                    <TextBlock Text="点击&quot;开始校准&quot;按钮，然后依次在下方区域用："
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="420" />
                                    <ikw:SimpleStackPanel Orientation="Vertical" Spacing="4" Margin="8,0,0,0">
                                        <TextBlock Text="1. 笔尖（触控笔）" />
                                        <TextBlock Text="2. 手指" />
                                        <TextBlock Text="3. 手掌（模拟误触）" />
                                    </ikw:SimpleStackPanel>
                                    <Button x:Name="BtnStartCalibrate" Content="开始校准" Click="BtnStartCalibrate_Click" MinWidth="120" />
                                    <Border x:Name="BorderCalibrate" Margin="0,0,20,0" CornerRadius="4" Height="64" 
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="2"
                                            TouchDown="BorderCalibrate_TouchDown" IsEnabled="False">
                                        <TextBlock x:Name="TextCalibrateHint" 
                                                   Text="点击上面的按钮开始" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Border>
                                    <ikw:SimpleStackPanel Orientation="Vertical" Spacing="4" Margin="8,0,0,0">
                                        <TextBlock x:Name="TextNibCalibrated" Text="笔尖值: 未校准" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="TextFingerCalibrated" Text="手指值: 未校准" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="TextPalmCalibrated" Text="手掌值: 未校准" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="TextCalibrateResult" Text="" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                    </ikw:SimpleStackPanel>
                                </ikw:SimpleStackPanel>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:FloatingBarStrings.FloatingBar_MiniWhiteboard}" />

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchMiniWhiteboardEnabled"
                        Header="{x:Static props:FloatingBarStrings.MiniWhiteboard_Settings_Enable}"
                        Icon="{x:Static ui:SegoeFluentIcons.Edit}"
                        IsOn="True"
                        Toggled="ToggleSwitchMiniWhiteboardEnabled_Toggled" />

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchMiniWhiteboardSyncPPT"
                        Header="{x:Static props:FloatingBarStrings.MiniWhiteboard_Settings_SyncPPT}"
                        Icon="{x:Static ui:SegoeFluentIcons.Slideshow}"
                        IsOn="True"
                        Toggled="ToggleSwitchMiniWhiteboardSyncPPT_Toggled" />

                    <ui:SettingsCard Header="{x:Static props:FloatingBarStrings.MiniWhiteboard_Settings_DefaultSize}">
                        <ikw:SimpleStackPanel Orientation="Vertical" Spacing="8">
                            <TextBlock x:Name="MiniWhiteboardSizeText"
                                       VerticalAlignment="Center" FontFamily="Consolas" />
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="W" Width="16" VerticalAlignment="Center" />
                                <Slider x:Name="MiniWhiteboardWidthSlider"
                                        Minimum="200" Maximum="1200" Width="200"
                                        IsSnapToTickEnabled="True" TickFrequency="10"
                                        TickPlacement="None"
                                        ValueChanged="MiniWhiteboardWidthSlider_ValueChanged" />
                            </ikw:SimpleStackPanel>
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="H" Width="16" VerticalAlignment="Center" />
                                <Slider x:Name="MiniWhiteboardHeightSlider"
                                        Minimum="150" Maximum="900" Width="200"
                                        IsSnapToTickEnabled="True" TickFrequency="10"
                                        TickPlacement="None"
                                        ValueChanged="MiniWhiteboardHeightSlider_ValueChanged" />
                            </ikw:SimpleStackPanel>
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:FloatingBarStrings.MiniWhiteboard_Settings_Opacity}">
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="MiniWhiteboardOpacityText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" />
                            <Slider x:Name="MiniWhiteboardOpacitySlider"
                                    Minimum="0.3" Maximum="1"
                                    Width="200"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="0.05" TickPlacement="None"
                                    ValueChanged="MiniWhiteboardOpacitySlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:AdvancedStrings.Logging}" />

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchIsLogEnabled"
                        Header="{x:Static props:AdvancedStrings.Logging}"
                        Icon="{x:Static ui:SegoeFluentIcons.OpenFile}"
                        IsOn="True"
                        Toggled="ToggleSwitchIsLogEnabled_Toggled"/>

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchIsSaveLogByDate"
                        Header="{x:Static props:AdvancedStrings.LogByDate}"
                        Description="{x:Static props:AdvancedStrings.LogRotateHint}"
                        IsOn="True"
                        Toggled="ToggleSwitchIsSaveLogByDate_Toggled"/>

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchIsSecondConfimeWhenShutdownApp"
                        Header="{x:Static props:AdvancedStrings.ConfirmExit}"
                        Icon="{x:Static ui:SegoeFluentIcons.SignOut}"
                        IsOn="True"
                        Toggled="ToggleSwitchIsSecondConfimeWhenShutdownApp_Toggled"/>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:ConfigStrings.Title}" />

                    <TextBlock Text="{x:Static props:ConfigStrings.Desc}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="1,0,0,4" />

                    <ui:SettingsCard Header="{x:Static props:ConfigStrings.Label}">
                        <ComboBox x:Name="ComboBoxConfigProfile"
                                  SelectionChanged="ComboBoxConfigProfile_SelectionChanged" />
                    </ui:SettingsCard>

                    <ui:SettingsCard ContentAlignment="Left">
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnDeleteConfigProfile" Content="{x:Static props:ConfigStrings.Delete}" Click="BtnDeleteConfigProfile_Click" />
                            <Button x:Name="BtnSaveAsConfigProfile" Content="{x:Static props:ConfigStrings.SaveAs}" Click="BtnSaveAsConfigProfile_Click" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <Rectangle Height="48" />

                </ikw:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</ui:Page>
