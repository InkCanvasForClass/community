<?xml version="1.0" encoding="utf-8"?><Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.StoragePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls" xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta" xmlns:sys="clr-namespace:System;assembly=mscorlib" mc:Ignorable="d" Title="{x:Static props:StorageStrings.Storage_Title}">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>

            <vio:SimpleStackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:StorageStrings.Storage_Title}" />

                <!-- 概览卡片 -->
                <Border Background="{DynamicResource {DynamicResource LayerFillColorDefaultBrush}}" BorderBrush="{DynamicResource {DynamicResource CardStrokeColorDefaultBrush}}" CornerRadius="4" BorderThickness="1" Padding="20,16">
                    <vio:SimpleStackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <vio:SimpleStackPanel Orientation="Vertical" Spacing="2">
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_TotalUsage}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TotalSizeTextBlock" Text="—" FontSize="28" FontWeight="SemiBold" />
                            </vio:SimpleStackPanel>
                            <vio:SimpleStackPanel Grid.Column="1" Orientation="Vertical" Spacing="2" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_DiskPercent}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                <TextBlock x:Name="DiskPercentTextBlock" Text="—" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </vio:SimpleStackPanel>
                        </Grid>

                        <!-- 横向占比柱状图 -->
                        <Border x:Name="UsageBarBorder" Height="14" CornerRadius="2" Background="{DynamicResource ControlStrokeColorDefaultBrush}" ClipToBounds="True">
                            <Border.OpacityMask>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Border Background="Black" CornerRadius="2" Width="{Binding ActualWidth, ElementName=UsageBarBorder}" Height="{Binding ActualHeight, ElementName=UsageBarBorder}" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.OpacityMask>
                            <Grid x:Name="UsageStackedBar">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="BarCoreCol" Width="0*" />
                                    <ColumnDefinition x:Name="BarLogsCol" Width="0*" />
                                    <ColumnDefinition x:Name="BarInkCol" Width="0*" />
                                    <ColumnDefinition x:Name="BarBackupsCol" Width="0*" />
                                    <ColumnDefinition x:Name="BarCustomCol" Width="0*" />
                                    <ColumnDefinition x:Name="BarPluginsCol" Width="0*" />
                                    <ColumnDefinition x:Name="BarUpdateCol" Width="0*" />
                                    <ColumnDefinition x:Name="BarThemeCol" Width="0*" />
                                    <ColumnDefinition x:Name="BarOtherCol" Width="0*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="#3B82F6" />
                                <Rectangle Grid.Column="1" Fill="#10B981" />
                                <Rectangle Grid.Column="2" Fill="#F59E0B" />
                                <Rectangle Grid.Column="3" Fill="#8B5CF6" />
                                <Rectangle Grid.Column="4" Fill="#EC4899" />
                                <Rectangle Grid.Column="5" Fill="#06B6D4" />
                                <Rectangle Grid.Column="6" Fill="#EF4444" />
                                <Rectangle Grid.Column="7" Fill="#A855F7" />
                                <Rectangle Grid.Column="8" Fill="#6B7280" />
                            </Grid>
                        </Border>

                        <!-- 图例 -->
                        <vio:SimpleStackPanel Orientation="Horizontal" Spacing="14">
                            <vio:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="2" Background="#3B82F6" />
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Legend_Core}" FontSize="12" />
                            </vio:SimpleStackPanel>
                            <vio:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="2" Background="#10B981" />
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Logs_Header}" FontSize="12" />
                            </vio:SimpleStackPanel>
                            <vio:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="2" Background="#F59E0B" />
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Legend_Ink}" FontSize="12" />
                            </vio:SimpleStackPanel>
                            <vio:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="2" Background="#8B5CF6" />
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Legend_Backups}" FontSize="12" />
                            </vio:SimpleStackPanel>
                            <vio:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="2" Background="#EC4899" />
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Legend_Custom}" FontSize="12" />
                            </vio:SimpleStackPanel>
                            <vio:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="2" Background="#06B6D4" />
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Plugins_Header}" FontSize="12" />
                            </vio:SimpleStackPanel>
                            <vio:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="2" Background="#EF4444" />
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Legend_Update}" FontSize="12" />
                            </vio:SimpleStackPanel>
                            <vio:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="2" Background="#A855F7" />
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Legend_Theme}" FontSize="12" />
                            </vio:SimpleStackPanel>
                            <vio:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="2" Background="#6B7280" />
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Legend_Other}" FontSize="12" />
                            </vio:SimpleStackPanel>
                        </vio:SimpleStackPanel>
                    </vio:SimpleStackPanel>
                </Border>

                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="BtnRefresh" Content="{x:Static props:StorageStrings.Storage_Refresh}" Click="BtnRefresh_Click" />
                    <Button x:Name="BtnOpenAppFolder" Content="{x:Static props:StorageStrings.Storage_OpenAppFolder}" Click="BtnOpenAppFolder_Click" />
                </vio:SimpleStackPanel>

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:StorageStrings.Storage_CategoryDetails}" />

                <!-- 核心文件 -->
                <ui:CardExpander x:Name="CoreExpander" IsExpanded="True">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Legend_Core}" />
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Core_Desc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="CoreSizeText" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="1" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:CardExpander.Icon>
                    <StackPanel>
                        <ui:CardControl>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{x:Static props:StorageStrings.Storage_Core_NotCleanable}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </ui:CardControl.Header></ui:CardControl>
                    </StackPanel>
                </ui:CardExpander>

                <!-- 日志 -->
                <ui:CardControl x:Name="LogsExpander">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static props:StorageStrings.Storage_Logs_Header}" />
                            <TextBlock Text="{x:Static props:StorageStrings.Storage_Logs_Desc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                    </ui:CardControl.Icon>
                    <vio:SimpleStackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="LogsSizeText" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="BtnCleanLogs" Content="{x:Static props:StorageStrings.Storage_Clean}" Click="BtnCleanLogs_Click" />
                    </vio:SimpleStackPanel>
                </ui:CardControl>

                <!-- 墨迹 -->
                <ui:CardControl x:Name="InkExpander">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static props:StorageStrings.Storage_Legend_Ink}" />
                            <TextBlock Text="{x:Static props:StorageStrings.Storage_Ink_Desc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Edit24" />
                    </ui:CardControl.Icon>
                    <vio:SimpleStackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="InkSizeText" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="BtnCleanInk" Content="{x:Static props:StorageStrings.Storage_Clean}" Click="BtnCleanInk_Click" />
                    </vio:SimpleStackPanel>
                </ui:CardControl>

                <!-- 备份 -->
                <ui:CardControl x:Name="BackupsExpander">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static props:StorageStrings.Storage_Legend_Backups}" />
                            <TextBlock Text="{x:Static props:StorageStrings.Storage_Backups_Desc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Cloud24" />
                    </ui:CardControl.Icon>
                    <vio:SimpleStackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="BackupsSizeText" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="BtnCleanBackups" Content="{x:Static props:StorageStrings.Storage_Clean}" Click="BtnCleanBackups_Click" />
                    </vio:SimpleStackPanel>
                </ui:CardControl>

                <!-- 自定义文件 -->
                <ui:CardExpander x:Name="CustomExpander" IsExpanded="True">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Legend_Custom}" />
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Custom_Desc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="CustomSizeText" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="1" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon Symbol="Image24" />
                    </ui:CardExpander.Icon>
                    <StackPanel>
                        <ui:CardControl>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{x:Static props:StorageStrings.Storage_Custom_Hint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </ui:CardControl.Header></ui:CardControl>
                    </StackPanel>
                </ui:CardExpander>

                <!-- 插件 -->
                <ui:CardExpander x:Name="PluginsExpander" IsExpanded="True">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Legend_Plugins}" />
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Plugins_Desc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="PluginsSizeText" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="1" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon Symbol="PuzzlePiece24" />
                    </ui:CardExpander.Icon>
                    <StackPanel>
                        <ui:CardControl>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{x:Static props:StorageStrings.Storage_Plugins_Hint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </ui:CardControl.Header></ui:CardControl>
                    </StackPanel>
                </ui:CardExpander>

                <!-- 自动更新 -->
                <ui:CardControl x:Name="UpdateExpander">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static props:StorageStrings.Storage_Legend_Update}" />
                            <TextBlock Text="{x:Static props:StorageStrings.Storage_Update_Desc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync24" />
                    </ui:CardControl.Icon>
                    <vio:SimpleStackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateSizeText" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="BtnCleanUpdate" Content="{x:Static props:StorageStrings.Storage_Clean}" Click="BtnCleanUpdate_Click" />
                    </vio:SimpleStackPanel>
                </ui:CardControl>

                <!-- 主题 -->
                <ui:CardExpander x:Name="ThemeExpander" IsExpanded="True">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Legend_Theme}" />
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_Theme_Desc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="ThemeSizeText" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="1" />
                        </Grid>
                    </ui:CardExpander.Header>
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon Symbol="Color24" />
                    </ui:CardExpander.Icon>
                    <StackPanel>
                        <ui:CardControl>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{x:Static props:StorageStrings.Storage_Theme_Hint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <Button x:Name="BtnCleanTheme" Content="{x:Static props:StorageStrings.Storage_Clean}" Click="BtnCleanTheme_Click" />
                        </ui:CardControl>
                    </StackPanel>
                </ui:CardExpander>

                <!-- 其他 -->
                <ui:CardControl x:Name="OtherExpander">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static props:StorageStrings.Storage_Legend_Other}" />
                            <TextBlock Text="{x:Static props:StorageStrings.Storage_Other_Desc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="MoreHorizontal24" />
                    </ui:CardControl.Icon>
                    <TextBlock x:Name="OtherSizeText" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" />
                </ui:CardControl>

                <Rectangle Height="48" />

            </vio:SimpleStackPanel>
        </Grid>
    </ScrollViewer>
</Page>
