<?xml version="1.0" encoding="utf-8"?><Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.DebugPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls" mc:Ignorable="d" Title="{x:Static props:AdvancedStrings.Debug_PageTitle}">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>

            <vio:SimpleStackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:AdvancedStrings.Debug_PageHeader}" />

                <controls:LabeledSettingsCard x:Name="ToggleSwitchDebugConsole" Header="{x:Static props:AdvancedStrings.Debug_ShowConsole_Header}" Description="{x:Static props:AdvancedStrings.Debug_ShowConsole_Desc}" Symbol="WindowDevTools24" IsOn="False" Toggled="ToggleSwitchDebugConsole_Toggled" />

                <controls:LabeledSettingsCard x:Name="ToggleSwitchPPTComDebugProbe" Header="{x:Static props:AdvancedStrings.Debug_PPTComProbe_Header}" Description="{x:Static props:AdvancedStrings.Debug_PPTComProbe_Desc}" Symbol="Bug24" IsOn="False" Toggled="ToggleSwitchPPTComDebugProbe_Toggled" />

                <controls:LabeledSettingsCard x:Name="ToggleSwitchPPTPageFlipPreview" Header="{x:Static props:AdvancedStrings.Debug_PPTPreviewVisible_Header}" Description="{x:Static props:AdvancedStrings.Debug_PPTPreviewVisible_Desc}" Symbol="Eye24" IsOn="False" d:IsOn="True" Toggled="ToggleSwitchPPTPageFlipPreview_Toggled" />

                <controls:LabeledSettingsCard x:Name="ToggleSwitchRealtimeInkDebugLog" Header="{x:Static props:AdvancedStrings.Debug_RealtimeInkLog_Header}" Description="{x:Static props:AdvancedStrings.Debug_RealtimeInkLog_Desc}" Symbol="Gauge24" IsOn="False" Toggled="ToggleSwitchRealtimeInkDebugLog_Toggled" />

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:AdvancedStrings.Debug_CrashTest_Section}" />

                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static props:AdvancedStrings.Debug_SimulateCrash_Header}" />
                            <TextBlock Text="{x:Static props:AdvancedStrings.Debug_SimulateCrash_Desc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="ErrorCircle24" />
                    </ui:CardControl.Icon>
                    <ui:Button Content="{x:Static props:AdvancedStrings.Debug_SimulateCrash_Button}" Click="BtnTestCrash_Click" Padding="14,6" Appearance="Primary" />
                </ui:CardControl>

                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static props:AdvancedStrings.Debug_SimulateHeartbeatTimeout_Header}" />
                            <TextBlock Text="{x:Static props:AdvancedStrings.Debug_SimulateHeartbeatTimeout_Desc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Timer24" />
                    </ui:CardControl.Icon>
                    <Button Content="{x:Static props:AdvancedStrings.Debug_SimulateHeartbeatTimeout_Button}" Click="BtnTestHeartbeatTimeout_Click" Padding="14,6" />
                </ui:CardControl>

                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static props:AdvancedStrings.Debug_ResetStartupCount_Header}" />
                            <TextBlock Text="{x:Static props:AdvancedStrings.Debug_ResetStartupCount_Desc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync24" />
                    </ui:CardControl.Icon>
                    <Button Content="{x:Static props:AdvancedStrings.Debug_ResetStartupCount_Button}" Click="BtnResetStartupCount_Click" Padding="14,6" />
                </ui:CardControl>

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:AdvancedStrings.Debug_MemoryBreakdownSection}" />

                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static props:AdvancedStrings.Debug_MemoryBreakdownDump_Header}" />
                            <TextBlock Text="{x:Static props:AdvancedStrings.Debug_MemoryBreakdownDump_Desc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Save24" />
                    </ui:CardControl.Icon>
                    <Button x:Name="BtnDumpMemory" Content="{x:Static props:AdvancedStrings.Debug_MemoryBreakdownDump_Button}" Click="BtnDumpMemory_Click" Padding="14,6" />
                </ui:CardControl>

                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static props:AdvancedStrings.Debug_MemoryBreakdownForceGC_Header}" />
                            <TextBlock Text="{x:Static props:AdvancedStrings.Debug_MemoryBreakdownForceGC_Desc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Broom24" />
                    </ui:CardControl.Icon>
                    <Button x:Name="BtnForceGC" Content="{x:Static props:AdvancedStrings.Debug_MemoryBreakdownForceGC_Button}" Click="BtnForceGC_Click" Padding="14,6" />
                </ui:CardControl>

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:AdvancedStrings.Debug_IconSettings}" />

                <ui:CardExpander IsEnabled="True" IsExpanded="True" d:Visibility="Visible" d:IsExpanded="True">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static props:AdvancedStrings.Debug_SettingsExpanderExample}" />
                            </StackPanel>
                            <controls:CopyButton Text="{x:Static props:AdvancedStrings.Debug_SettingsExpanderExample_Desc}" Grid.Column="1" />
                        </Grid>
                    </ui:CardExpander.Header>

                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon Glyph="" />
                    </ui:CardExpander.Icon>

                    <StackPanel>
                        <ui:CardControl>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{x:Static props:AdvancedStrings.Debug_SettingsExpanderExample_Header}" />
                                    <TextBlock Text="{x:Static props:AdvancedStrings.Debug_SettingsExpanderExample_Desc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:CardControl.Resources>
                                <sys:Double x:Key="SettingsCardLeftIndention">0</sys:Double>
                            </ui:CardControl.Resources>
                        </ui:CardControl>
                    </StackPanel>
                </ui:CardExpander>

                <Rectangle Height="48" />
            </vio:SimpleStackPanel>
        </Grid>
    </ScrollViewer>
</Page>