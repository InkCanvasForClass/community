<?xml version="1.0" encoding="utf-8"?><Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.ToolbarAppearancePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls" xmlns:c="clr-namespace:Ink_Canvas.Converter" mc:Ignorable="d" Title="ToolbarAppearancePage">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <c:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>
            <Grid>
                <vio:SimpleStackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">

                    <controls:LabeledSettingsCard x:Name="CardUseLegacyFloatingBarUI" Header="{x:Static props:ThemeStrings.Theme_UseLegacyFloatingBarUI}" Symbol="History24" SwitchName="ToggleSwitchUseLegacyFloatingBarUI" Toggled="ToggleSwitchUseLegacyFloatingBarUI_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardShowPenColorOnFloatingBarIcon" Header="{x:Static props:ThemeStrings.Theme_ShowPenColorOnFloatingBarIcon}" Symbol="DrawImage24" SwitchName="ToggleSwitchShowPenColorOnFloatingBarIcon" Toggled="ToggleSwitchShowPenColorOnFloatingBarIcon_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardColorfulFloatingBar" Header="{x:Static props:ThemeStrings.Theme_ColorfulFloatingBar}" Description="{x:Static props:ThemeStrings.Theme_ColorfulFloatingBarHint}" Symbol="Color24" SwitchName="ToggleSwitchColorfulFloatingBar" Toggled="ToggleSwitchColorfulFloatingBar_Toggled" />

                    <ui:CardExpander x:Name="ExpanderCompactFloatingBar" IsExpanded="False">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static props:ThemeStrings.Theme_CompactFloatingBar}" />
                                    <TextBlock Text="{x:Static props:ThemeStrings.Theme_CompactFloatingBarHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleSwitchCompactFloatingBar" Checked="ToggleSwitchCompactFloatingBar_Toggled" Unchecked="ToggleSwitchCompactFloatingBar_Toggled" Grid.Column="1" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <ui:CardExpander.Icon>
                            <ui:SymbolIcon Symbol="PageFit24" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <ui:CardControl x:Name="CardHideFloatingBarBorder">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static props:ThemeStrings.Theme_HideFloatingBarBorder}" />
                                        <TextBlock Text="{x:Static props:ThemeStrings.Theme_HideFloatingBarBorderHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="ToggleSwitchHideFloatingBarBorder" Checked="ToggleSwitchHideFloatingBarBorder_Toggled" Unchecked="ToggleSwitchHideFloatingBarBorder_Toggled" />
                            </ui:CardControl>
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander x:Name="ExpanderIdleMiniBar" IsExpanded="False">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static props:ThemeStrings.Theme_IdleMiniBar}" />
                                    <TextBlock Text="{x:Static props:ThemeStrings.Theme_IdleMiniBarHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleSwitchEnableIdleMiniBar" Checked="ToggleSwitchEnableIdleMiniBar_Toggled" Unchecked="ToggleSwitchEnableIdleMiniBar_Toggled" Grid.Column="1" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <ui:CardExpander.Icon>
                            <ui:SymbolIcon Symbol="PageFit24" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <ui:CardControl Header="{x:Static props:ThemeStrings.Theme_IdleMiniBarOpacity}">
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="IdleMiniBarOpacityText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" />
                                    <Slider x:Name="IdleMiniBarOpacitySlider" Minimum="0.1" Maximum="1" Width="200" IsSnapToTickEnabled="True" Value="0.5" TickFrequency="0.05" TickPlacement="None" AutoToolTipPlacement="None" ValueChanged="IdleMiniBarOpacitySlider_ValueChanged" />
                                </vio:SimpleStackPanel>
                            </ui:CardControl>
                            <ui:CardControl Header="{x:Static props:ThemeStrings.Theme_IdleMiniBarAutoRestore}">
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="IdleMiniBarAutoRestoreText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" />
                                    <Slider x:Name="IdleMiniBarAutoRestoreSlider" Minimum="0" Maximum="180" Width="200" IsSnapToTickEnabled="True" Value="60" TickFrequency="5" TickPlacement="None" AutoToolTipPlacement="None" ValueChanged="IdleMiniBarAutoRestoreSlider_ValueChanged" />
                                </vio:SimpleStackPanel>
                            </ui:CardControl>
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander x:Name="ExpanderLiquidGlassBar" IsExpanded="False">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static props:ThemeStrings.Theme_LiquidGlassBar}" />
                                    <TextBlock Text="{x:Static props:ThemeStrings.Theme_LiquidGlassBarHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleSwitchEnableLiquidGlassBar" Checked="ToggleSwitchEnableLiquidGlassBar_Toggled" Unchecked="ToggleSwitchEnableLiquidGlassBar_Toggled" Grid.Column="1" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <ui:CardExpander.Icon>
                            <ui:SymbolIcon Symbol="ArrowDown24" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <ui:CardControl Header="{x:Static props:ThemeStrings.Theme_LiquidGlassBarOpacity}">
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="LiquidGlassBarOpacityText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" />
                                    <Slider x:Name="LiquidGlassBarOpacitySlider" Minimum="0.2" Maximum="1" Width="200" IsSnapToTickEnabled="True" Value="0.95" TickFrequency="0.05" TickPlacement="None" AutoToolTipPlacement="None" ValueChanged="LiquidGlassBarOpacitySlider_ValueChanged" />
                                </vio:SimpleStackPanel>
                            </ui:CardControl>
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardControl x:Name="CardFloatingBarBorderColor">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{x:Static props:ThemeStrings.Theme_FloatingBarBorderColor}" />
                                <TextBlock Text="{x:Static props:ThemeStrings.Theme_FloatingBarBorderColorHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:CardControl.Icon>
                            <ui:SymbolIcon Symbol="Edit24" />
                        </ui:CardControl.Icon>
                        <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox x:Name="ComboBoxFloatingBarBorderColorMode" MinWidth="160" SelectedIndex="0" SelectionChanged="ComboBoxFloatingBarBorderColorMode_SelectionChanged">
                                <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingBarBorderColor_Default}" />
                                <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingBarBorderColor_FollowBackground}" />
                                <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingBarBorderColor_Custom}" />
                            </ComboBox>
                            <Button x:Name="ButtonFloatingBarBorderColor" Width="40" Height="28" Padding="0" Visibility="Collapsed" Click="ButtonFloatingBarBorderColor_Click" ToolTip="{x:Static props:ThemeStrings.Theme_FloatingBarBorderColor_Custom}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border Background="{TemplateBinding Background}" BorderBrush="#888888" BorderThickness="1" CornerRadius="3" />
                                            <Border x:Name="HoverOverlay" Background="Transparent" BorderThickness="0" CornerRadius="3" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HoverOverlay" Property="Background" Value="#22000000" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HoverOverlay" Property="Background" Value="#44000000" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </vio:SimpleStackPanel>
                    </ui:CardControl>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:ThemeStrings.Theme_FloatingBarIcon}" />

                    <ui:CardControl Header="{x:Static props:ThemeStrings.Theme_FloatingBarIcon}">
                        <ui:CardControl.Icon>
                            <ui:SymbolIcon Symbol="Image24" />
                        </ui:CardControl.Icon>
                        <ComboBox x:Name="ComboBoxFloatingBarImg" SelectedIndex="0" SelectionChanged="ComboBoxFloatingBarImg_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_IccDefault}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_IccNoShadow}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_IccDark}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_IccDarkBreath}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_IccWhiteTransparent}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_IccBlackTransparent}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_CoolapkCrossEye}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_CoolapkAbused}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_CoolapkSmile}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_CoolapkUnderwear}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_CoolapkGreenHatDoge}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_TiebaEmoji}" />
                        </ComboBox>
                    </ui:CardControl>

                    <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button x:Name="ButtonAddCustomIcon" Content="{x:Static props:ThemeStrings.Theme_Upload}" Click="ButtonAddCustomIcon_Click" Padding="10,3" />
                        <Button x:Name="ButtonManageCustomIcons" Content="{x:Static props:ThemeStrings.Theme_Manage}" Click="ButtonManageCustomIcons_Click" Padding="10,3" />
                    </vio:SimpleStackPanel>

                    <Rectangle Height="16" />
                    <ui:CardControl>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="工具栏位置" />
                                <TextBlock Text="设置工具栏相对于拖动图标的显示位置" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="ToolbarPositionComboBox" MinWidth="200" SelectionChanged="ToolbarPositionComboBox_SelectionChanged">
                                <ComboBoxItem Tag="Right" Content="右侧" />
                                <ComboBoxItem Tag="Left" Content="左侧" />
                                <ComboBoxItem Tag="Top" Content="上方" />
                                <ComboBoxItem Tag="Bottom" Content="下方" />
                            </ComboBox>
                        </vio:SimpleStackPanel>
                    </ui:CardControl>
                    <Rectangle Height="16" />
                    <controls:LabeledSettingsCard x:Name="CardReverseToolbarContent" Header="翻转组件内容" Description="翻转组件内容的方向，更改后建议重启应用" SwitchName="ToggleSwitchReverseToolbarContent" Toggled="ReverseToolbarContentToggleSwitch_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardDisableToolbarAnimation" Header="禁止工具栏动画" Description="开启后非选定工具栏按钮不会自动下沉居中" SwitchName="ToggleSwitchDisableToolbarAnimation" Toggled="DisableToolbarAnimationToggleSwitch_Toggled" />

                    <ui:CardExpander x:Name="ExpanderAutoFlipWhenSpaceInsufficient" d:IsExpanded="True" IsExpanded="{Binding IsChecked, ElementName=ToggleSwitchAutoFlipWhenSpaceInsufficient, Mode=OneWay}">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="空间不足时自动翻转" />
                                    <TextBlock Text="拖动工具栏到屏幕边缘空间不足时自动翻转方向，更改后建议重启应用" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ToggleSwitchAutoFlipWhenSpaceInsufficient" Checked="AutoFlipWhenSpaceInsufficientToggleSwitch_Toggled" Unchecked="AutoFlipWhenSpaceInsufficientToggleSwitch_Toggled" Grid.Column="1" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <ui:CardExpander.Icon>
                            <ui:SymbolIcon Symbol="ArrowSwap24" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <ui:CardControl x:Name="CardFlipContentOnAutoFlip">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="自动翻转后翻转组件内容" />
                                        <TextBlock Text="开启后自动翻转时仅移动拖动图标位置，组件内容保持原顺序，更改后建议重启应用" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="ToggleSwitchFlipContentOnAutoFlip" Checked="FlipContentOnAutoFlipToggleSwitch_Toggled" Unchecked="FlipContentOnAutoFlipToggleSwitch_Toggled" />
                            </ui:CardControl>
                        </StackPanel>
                    </ui:CardExpander>
                    <Rectangle Height="16" />
                    <ui:CardControl Header="{x:Static props:ThemeStrings.Theme_FloatingBarScale}">
                        <ui:CardControl.Icon>
                            <ui:SymbolIcon Symbol="Pin24" />
                        </ui:CardControl.Icon>
                        <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="ViewboxFloatingBarActualScaleText" Text="1.00x" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" />
                            <TextBlock Text=" (" VerticalAlignment="Center" FontSize="11" Foreground="Gray" />
                            <TextBlock x:Name="ViewboxFloatingBarScaleSliderText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" />
                            <TextBlock Text=")" VerticalAlignment="Center" FontSize="11" Foreground="Gray" />
                            <Slider x:Name="ViewboxFloatingBarScaleTransformValueSlider" Minimum="0.5" Maximum="1.25" Width="200" IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05" TickPlacement="None" AutoToolTipPlacement="None" ValueChanged="ViewboxFloatingBarScaleTransformValueSlider_ValueChanged" />
                        </vio:SimpleStackPanel>
                    </ui:CardControl>
                    <Rectangle Height="16" />
                    <ui:CardExpander IsExpanded="True">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Text="{x:Static props:ThemeStrings.Theme_FloatingBarOpacity}" />
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <ui:CardExpander.Icon>
                            <ui:SymbolIcon Symbol="Accessibility24" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <ui:CardControl Header="{x:Static props:ThemeStrings.Theme_FloatingBarOpacity}">
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="ViewboxFloatingBarOpacityText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" />
                                    <Slider x:Name="ViewboxFloatingBarOpacityValueSlider" Minimum="0.3" Maximum="1" Width="200" IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05" TickPlacement="None" AutoToolTipPlacement="None" ValueChanged="ViewboxFloatingBarOpacityValueSlider_ValueChanged" />
                                </vio:SimpleStackPanel>
                            </ui:CardControl>
                            <ui:CardControl>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static props:ThemeStrings.Theme_FloatingBarOpacityInPPT}" />
                                        <TextBlock Text="{x:Static props:ThemeStrings.Theme_FloatingBarOpacityInPPTHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="Play24" />
                                </ui:CardControl.Icon>
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="ViewboxFloatingBarOpacityInPPTText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" />
                                    <Slider x:Name="ViewboxFloatingBarOpacityInPPTValueSlider" Minimum="0.3" Maximum="1" Width="200" IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05" TickPlacement="None" AutoToolTipPlacement="None" ValueChanged="ViewboxFloatingBarOpacityInPPTValueSlider_ValueChanged" />
                                </vio:SimpleStackPanel>
                            </ui:CardControl>
                        </StackPanel>
                    </ui:CardExpander>

                    <Rectangle Height="16" />
                    <ui:CardExpander IsExpanded="True">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Text="{x:Static props:ThemeStrings.Theme_FloatingBarMenuOpacity}" />
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <ui:CardExpander.Icon>
                            <ui:SymbolIcon Symbol="Open24" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <ui:CardControl Header="{x:Static props:ThemeStrings.Theme_FloatingBarMenuOpacity}">
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="FloatingBarMenuOpacityText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" />
                                    <Slider x:Name="FloatingBarMenuOpacitySlider" Minimum="0.3" Maximum="1" Width="200" IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05" TickPlacement="None" AutoToolTipPlacement="None" ValueChanged="FloatingBarMenuOpacitySlider_ValueChanged" />
                                </vio:SimpleStackPanel>
                            </ui:CardControl>
                            <ui:CardControl Header="{x:Static props:ThemeStrings.Theme_FloatingBarMenuOpacityInPPT}">
                                <ui:CardControl.Icon>
                                    <ui:SymbolIcon Symbol="Play24" />
                                </ui:CardControl.Icon>
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="FloatingBarMenuOpacityInPPTText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" />
                                    <Slider x:Name="FloatingBarMenuOpacityInPPTSlider" Minimum="0.3" Maximum="1" Width="200" IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05" TickPlacement="None" AutoToolTipPlacement="None" ValueChanged="FloatingBarMenuOpacityInPPTSlider_ValueChanged" />
                                </vio:SimpleStackPanel>
                            </ui:CardControl>
                        </StackPanel>
                    </ui:CardExpander>

                    <Rectangle Height="48" />
                </vio:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
