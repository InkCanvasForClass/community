<Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.PerformancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
      mc:Ignorable="d"
      Title="{x:Static props:PerformanceStrings.Title}">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                    BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                    TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
                <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="FontFamily" Value="Consolas" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>
            <Grid>
                <vio:SimpleStackPanel MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

                    <!-- 性能监测开关 -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:PerformanceStrings.Title}" />

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchEnableMonitoring"
                        Header="{x:Static props:PerformanceStrings.EnableMonitoring}"
                        Description="{x:Static props:PerformanceStrings.EnableMonitoringHint}"
                        Symbol="Gauge24"
                        IsOn="False"
                        Toggled="ToggleSwitchEnableMonitoring_Toggled"/>

                    <!-- 当前运行状态 -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:PerformanceStrings.CurrentSession}" />

                    <controls:SettingsCard x:Name="CardCurrentStatus"
                        Header="{x:Static props:PerformanceStrings.MonitoringInactive}"
                        Description=""
                        ContentAlignment="Left">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Open24" />
                        </controls:SettingsCard.Icon>
                        <vio:SimpleStackPanel x:Name="PanelCurrentMetrics" Spacing="12"
                            Orientation="Horizontal" Visibility="Collapsed">
                            <vio:SimpleStackPanel Spacing="2">
                                <TextBlock Text="{x:Static props:PerformanceStrings.CpuUsage}"
                                    FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TextCurrentCpu"
                                    Style="{StaticResource MetricValueStyle}" Text="-- %" />
                            </vio:SimpleStackPanel>
                            <Rectangle Width="1" Height="36"
                                Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <vio:SimpleStackPanel Spacing="2">
                                <TextBlock Text="{x:Static props:PerformanceStrings.MemoryUsage}"
                                    FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TextCurrentMemory"
                                    Style="{StaticResource MetricValueStyle}" Text="-- MB" />
                            </vio:SimpleStackPanel>
                            <Rectangle Width="1" Height="36"
                                Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <vio:SimpleStackPanel Spacing="2">
                                <TextBlock Text="{x:Static props:PerformanceStrings.SystemCpuUsage}"
                                    FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TextSystemCpu"
                                    Style="{StaticResource MetricValueStyle}" Text="-- %" />
                            </vio:SimpleStackPanel>
                        </vio:SimpleStackPanel>
                    </controls:SettingsCard>

                    <!-- 历史记录 -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:PerformanceStrings.HistorySection}" />

                    <controls:SettingsCard x:Name="CardHistory"
                        Header="{x:Static props:PerformanceStrings.HistoryHint}"
                        ContentAlignment="Left">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="ChartMultiple24" />
                        </controls:SettingsCard.Icon>
                        <vio:SimpleStackPanel Spacing="8">
                            <TextBlock x:Name="TextHistorySummary"
                                Text="{x:Static props:PerformanceStrings.NoHistory}"
                                FontSize="14" />
                            <vio:SimpleStackPanel x:Name="PanelHistoryStats" Spacing="16"
                                Orientation="Horizontal" Visibility="Collapsed">
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.AvgCpuLabel}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextHistoryAvgCpu"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.PeakCpuLabel}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextHistoryPeakCpu"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.AvgMemoryLabel}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextHistoryAvgMem"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.PeakMemoryLabel}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextHistoryPeakMem"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                            </vio:SimpleStackPanel>
                        </vio:SimpleStackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CardHistorySmoothing"
                        Header="{x:Static props:PerformanceStrings.InkSmoothingSection}"
                        Description="{x:Static props:PerformanceStrings.HistoryHint}"
                        ContentAlignment="Left">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="DrawImage24" />
                        </controls:SettingsCard.Icon>
                        <vio:SimpleStackPanel Spacing="8">
                            <TextBlock x:Name="TextSmoothingHistorySummary"
                                Text="{x:Static props:PerformanceStrings.NoHistory}"
                                FontSize="14" />
                            <vio:SimpleStackPanel x:Name="PanelSmoothingHistoryStats" Spacing="16"
                                Orientation="Horizontal" Visibility="Collapsed">
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.InkSmoothingAvgTotal}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextSmoothingHistoryAvgTotal"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.InkSmoothingMaxTotal}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextSmoothingHistoryMaxTotal"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.InkSmoothingAvgBezier}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextSmoothingHistoryAvgBezier"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.InkSmoothingAvgResample}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextSmoothingHistoryAvgResample"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                            </vio:SimpleStackPanel>
                            <vio:SimpleStackPanel x:Name="PanelSmoothingHistoryPointStats" Spacing="16"
                                Orientation="Horizontal" Visibility="Collapsed">
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.InkSmoothingAvgInputPoints}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextSmoothingHistoryAvgInput"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.InkSmoothingAvgOutputPoints}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextSmoothingHistoryAvgOutput"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.InkSmoothingSampleCount}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextSmoothingHistorySampleCount"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                            </vio:SimpleStackPanel>
                        </vio:SimpleStackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CardClearHistory"
                        Header="{x:Static props:PerformanceStrings.HistorySection}"
                        Description="{x:Static props:PerformanceStrings.ClearHistory}">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </controls:SettingsCard.Icon>
                        <Button Content="{x:Static props:PerformanceStrings.ClearHistory}"
                                Click="CardClearHistory_Click" />
                    </controls:SettingsCard>

                    <!-- 设备性能评估 -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:PerformanceStrings.DeviceScoreSection}" />

                    <controls:SettingsCard x:Name="CardDeviceScore"
                        Header="{x:Static props:PerformanceStrings.DeviceScoreHint}"
                        ContentAlignment="Left">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Heart24" />
                        </controls:SettingsCard.Icon>
                        <vio:SimpleStackPanel Spacing="12">
                            <vio:SimpleStackPanel x:Name="PanelDeviceScoreResult" Spacing="8"
                                Visibility="Collapsed">
                                <vio:SimpleStackPanel Orientation="Horizontal" Spacing="16">
                                    <vio:SimpleStackPanel Spacing="2">
                                        <TextBlock Text="{x:Static props:PerformanceStrings.DeviceScoreResult}"
                                            FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="TextOverallScore"
                                            FontSize="28" FontWeight="SemiBold" />
                                    </vio:SimpleStackPanel>
                                    <Rectangle Width="1" Height="48"
                                        Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <vio:SimpleStackPanel Spacing="2">
                                        <TextBlock Text="{x:Static props:PerformanceStrings.CpuScore}"
                                            FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="TextCpuScore"
                                            Style="{StaticResource MetricValueStyle}" />
                                    </vio:SimpleStackPanel>
                                    <vio:SimpleStackPanel Spacing="2">
                                        <TextBlock Text="{x:Static props:PerformanceStrings.MemoryScore}"
                                            FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="TextMemoryScore"
                                            Style="{StaticResource MetricValueStyle}" />
                                    </vio:SimpleStackPanel>
                                    <vio:SimpleStackPanel Spacing="2">
                                        <TextBlock Text="{x:Static props:PerformanceStrings.DiskScore}"
                                            FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="TextDiskScore"
                                            Style="{StaticResource MetricValueStyle}" />
                                    </vio:SimpleStackPanel>
                                </vio:SimpleStackPanel>
                                <TextBlock x:Name="TextScoreDescription"
                                    FontSize="14" TextWrapping="Wrap" />
                                <TextBlock x:Name="TextLastTestTime"
                                    FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </vio:SimpleStackPanel>
                            <TextBlock x:Name="TextDeviceScorePlaceholder"
                                Text="{x:Static props:PerformanceStrings.DeviceScoreUnknown}"
                                FontSize="14"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </vio:SimpleStackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CardRunDeviceTest"
                        Header="{x:Static props:PerformanceStrings.DeviceScoreSection}"
                        Description="{x:Static props:PerformanceStrings.DeviceScoreHint}">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Play24" />
                        </controls:SettingsCard.Icon>
                        <Button x:Name="BtnRunDeviceTest"
                                Content="{x:Static props:PerformanceStrings.RunDeviceTest}"
                                Click="CardRunDeviceTest_Click" />
                    </controls:SettingsCard>

                    <!-- 墨迹纠正耗时 -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:PerformanceStrings.InkSmoothingSection}" />

                    <controls:SettingsCard x:Name="CardInkSmoothing"
                        Header="{x:Static props:PerformanceStrings.InkSmoothingHint}"
                        ContentAlignment="Left">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="DrawImage24" />
                        </controls:SettingsCard.Icon>
                        <vio:SimpleStackPanel Spacing="12">
                            <TextBlock x:Name="TextInkSmoothingInactive"
                                Text="{x:Static props:PerformanceStrings.InkSmoothingInactive}"
                                FontSize="14"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <vio:SimpleStackPanel x:Name="PanelInkSmoothingStats" Spacing="16"
                                Orientation="Horizontal" Visibility="Collapsed">
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.InkSmoothingAvgTotal}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextSmoothingAvgTotal"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.InkSmoothingMaxTotal}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextSmoothingMaxTotal"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.InkSmoothingAvgBezier}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextSmoothingAvgBezier"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.InkSmoothingAvgResample}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextSmoothingAvgResample"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                            </vio:SimpleStackPanel>
                            <vio:SimpleStackPanel x:Name="PanelInkSmoothingPointStats" Spacing="16"
                                Orientation="Horizontal" Visibility="Collapsed">
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.InkSmoothingAvgInputPoints}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextSmoothingAvgInput"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.InkSmoothingAvgOutputPoints}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextSmoothingAvgOutput"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                                <vio:SimpleStackPanel Spacing="2">
                                    <TextBlock Text="{x:Static props:PerformanceStrings.InkSmoothingSampleCount}"
                                        FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TextSmoothingSampleCount"
                                        Style="{StaticResource MetricValueStyle}" />
                                </vio:SimpleStackPanel>
                            </vio:SimpleStackPanel>
                        </vio:SimpleStackPanel>
                    </controls:SettingsCard>

                    <Rectangle Height="48" />
                </vio:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
