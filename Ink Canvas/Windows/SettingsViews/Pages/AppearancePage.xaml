<ui:Page x:Class="Ink_Canvas.Windows.SettingsViews.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
      mc:Ignorable="d"
      Title="个性化">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                    BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                    TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>
            <Grid>
                <ikw:SimpleStackPanel MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="主题" />

                    <ui:SettingsCard Header="主题">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Pinned}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxTheme"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxTheme_SelectionChanged">
                            <ComboBoxItem Content="浅色主题" />
                            <ComboBoxItem Content="深色主题" />
                            <ComboBoxItem Content="跟随系统" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="窗口背景样式">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.FullScreen}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxWindowBackdrop"
                                  SelectionChanged="ComboBoxWindowBackdrop_SelectionChanged">
                            <ComboBoxItem Content="无背景效果" Tag="None" />
                            <ComboBoxItem Content="云母" Tag="Mica" />
                            <ComboBoxItem Content="亚克力" Tag="Acrylic" />
                            <ComboBoxItem Content="Tabbed" Tag="Tabbed" />
                            <ComboBoxItem Content="Transient" Tag="Transient" />
                            <ComboBoxItem Content="亚克力 10" Tag="Acrylic10" />
                            <ComboBoxItem Content="亚克力 11" Tag="Acrylic11" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="界面语言"
                            Description="更改界面语言后需要重启应用程序才能完全生效。">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Globe}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxLanguage"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxLanguage_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="简体中文" />
                            <ComboBoxItem Content="English" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="启用启动动画" />

                    <controls:LabeledSettingsCard x:Name="CardEnableSplashScreen"
                            Header="启用启动动画"
                            Icon="{x:Static ui:SegoeFluentIcons.Photo}"
                            SwitchName="ToggleSwitchEnableSplashScreen"
                            Toggled="ToggleSwitchEnableSplashScreen_Toggled" />

                    <ui:SettingsCard Header="启动动画样式">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Brightness}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxSplashScreenStyle"
                                  SelectedIndex="1"
                                  SelectionChanged="ComboBoxSplashScreenStyle_SelectionChanged">
                            <ComboBoxItem Content="随机" />
                            <ComboBoxItem Content="跟随四季" />
                            <ComboBoxItem Content="春季" />
                            <ComboBoxItem Content="夏季" />
                            <ComboBoxItem Content="秋季" />
                            <ComboBoxItem Content="冬季" />
                            <ComboBoxItem Content="马年限定" />
                            <ComboBoxItem Content="自定义" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <ui:SettingsCard x:Name="CardCustomSplashImage" Header="自定义启动图片"
                                     Description="选择自定义图片作为启动动画背景（支持JPG、PNG、BMP等格式）"
                                     Visibility="Collapsed">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Photo}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="TextBlockCustomSplashPath"
                                       Text="未选择自定义图片"
                                       VerticalAlignment="Center"
                                       MaxWidth="200"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="Gray"/>
                            <Button x:Name="ButtonBrowseCustomSplash"
                                    Content="浏览"
                                    Padding="10,3"
                                    Click="ButtonBrowseCustomSplash_Click"/>
                            <Button x:Name="ButtonClearCustomSplash"
                                    Content="清除"
                                    Padding="10,3"
                                    Click="ButtonClearCustomSplash_Click"/>
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard x:Name="CardCustomSplashTextPosition" Header="文字显示位置"
                                     Description="设置启动时加载文字和进度条的位置"
                                     Visibility="Collapsed">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.AlignCenter}" />
                        </ui:SettingsCard.HeaderIcon>
                        <Border CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="#30808080"
                                Background="Transparent"
                                Width="110"
                                Height="32">
                            <Grid ClipToBounds="True">
                                <!-- 滑动选择指示器 -->
                                <Border x:Name="SelectionIndicator"
                                        CornerRadius="3"
                                        Background="#200078D7"
                                        BorderBrush="#800078D7"
                                        BorderThickness="1"
                                        Width="34"
                                        Height="28"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="1,1,0,1"
                                        Panel.ZIndex="1">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="IndicatorTranslateTransform" X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                                <!-- 按钮层 -->
                                <ikw:SimpleStackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border x:Name="BorderTextAlignLeft"
                                            Width="36" Height="30"
                                            PreviewMouseLeftButtonDown="BorderTextAlign_Click"
                                            Tag="0"
                                            Cursor="Hand"
                                            Panel.ZIndex="2">
                                        <Canvas>
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.AlignLeft}" FontSize="14"
                                                         Canvas.Left="11" Canvas.Top="8"
                                                         Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                        </Canvas>
                                    </Border>
                                    <Border x:Name="BorderTextAlignCenter"
                                            Width="36" Height="30"
                                            PreviewMouseLeftButtonDown="BorderTextAlign_Click"
                                            Tag="1"
                                            Cursor="Hand"
                                            Panel.ZIndex="2">
                                        <Canvas>
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.AlignCenter}" FontSize="14"
                                                         Canvas.Left="11" Canvas.Top="8"
                                                         Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                        </Canvas>
                                    </Border>
                                    <Border x:Name="BorderTextAlignRight"
                                            Width="36" Height="30"
                                            PreviewMouseLeftButtonDown="BorderTextAlign_Click"
                                            Tag="2"
                                            Cursor="Hand"
                                            Panel.ZIndex="2">
                                        <Canvas>
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.AlignRight}" FontSize="14"
                                                         Canvas.Left="11" Canvas.Top="8"
                                                         Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                        </Canvas>
                                    </Border>
                                </ikw:SimpleStackPanel>
                            </Grid>
                        </Border>
                    </ui:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="浮动工具栏图标" />

                    <ui:SettingsCard Header="浮动工具栏图标">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Photo}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxFloatingBarImg"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxFloatingBarImg_SelectionChanged">
                            <ComboBoxItem Content="「ICC-CE」默认" />
                            <ComboBoxItem Content="「ICC-CE」无阴影" />
                            <ComboBoxItem Content="「ICC-CE」深色" />
                            <ComboBoxItem Content="「ICC-CE」深色呼吸版" />
                            <ComboBoxItem Content="「ICC-CE」白色透明版" />
                            <ComboBoxItem Content="「ICC-CE」黑色透明版" />
                            <ComboBoxItem Content="酷安斗鸡眼滑稽" />
                            <ComboBoxItem Content="酷安受虐滑稽" />
                            <ComboBoxItem Content="酷安呲牙笑" />
                            <ComboBoxItem Content="酷安头戴内裤滑稽" />
                            <ComboBoxItem Content="酷安绿帽Doge" />
                            <ComboBoxItem Content="贴吧滑稽" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button x:Name="ButtonAddCustomIcon" Content="上传"
                                Click="ButtonAddCustomIcon_Click" Padding="10,3"/>
                        <Button x:Name="ButtonManageCustomIcons" Content="管理"
                                Click="ButtonManageCustomIcons_Click" Padding="10,3"/>
                    </ikw:SimpleStackPanel>

                    <ui:SettingsCard Header="浮动工具栏缩放倍数">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Pinned}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="ViewboxFloatingBarActualScaleText"
                                       Text="1.00x"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <TextBlock Text=" (" VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="ViewboxFloatingBarScaleSliderText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <TextBlock Text=")" VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>
                            <Slider x:Name="ViewboxFloatingBarScaleTransformValueSlider" Minimum="0.5"
                                    Maximum="1.25" Width="200"
                                    IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05"
                                    TickPlacement="None" AutoToolTipPlacement="None"
                                    ValueChanged="ViewboxFloatingBarScaleTransformValueSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="浮动工具栏透明度">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.EaseOfAccess}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="ViewboxFloatingBarOpacityText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="ViewboxFloatingBarOpacityValueSlider" Minimum="0.3"
                                    Maximum="1" Width="200"
                                    IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05"
                                    TickPlacement="None" AutoToolTipPlacement="None"
                                    ValueChanged="ViewboxFloatingBarOpacityValueSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="浮栏在 PPT 下透明度"
                            Description="重新进入 PPT 放映后生效">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Play}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="ViewboxFloatingBarOpacityInPPTText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="ViewboxFloatingBarOpacityInPPTValueSlider" Minimum="0.3"
                                    Maximum="1" Width="200"
                                    IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05"
                                    TickPlacement="None" AutoToolTipPlacement="None"
                                    ValueChanged="ViewboxFloatingBarOpacityInPPTValueSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="白板 UI 缩放倍数">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.BackToWindow}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="ViewboxBlackBoardScaleText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="ViewboxBlackBoardScaleTransformValueSlider" Minimum="0.5"
                                    Maximum="1.5" Width="200"
                                    IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05"
                                    TickPlacement="None" AutoToolTipPlacement="None"
                                    ValueChanged="ViewboxBlackBoardScaleTransformValueSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <controls:LabeledSettingsCard x:Name="CardEnableTimeDisplayInWhiteboardMode"
                            Header="在白板中显示当前时间和日期"
                            Icon="{x:Static ui:SegoeFluentIcons.Pinned}"
                            SwitchName="ToggleSwitchEnableTimeDisplayInWhiteboardMode"
                            Toggled="ToggleSwitchEnableTimeDisplayInWhiteboardMode_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardUse24HourTimeFormat"
                            Header="使用24小时制显示时间"
                            Toggled="ToggleSwitchUse24HourTimeFormat_Toggled">
                        <controls:LabeledSettingsCard.HeaderIcon>
                            <ui:FontIcon Glyph="&#xE917;" />
                        </controls:LabeledSettingsCard.HeaderIcon>
                    </controls:LabeledSettingsCard>

                    <controls:LabeledSettingsCard x:Name="CardEnableChickenSoupInWhiteboardMode"
                            Header="在白板中显示信仰の源 1（好喝的/毒的鸡汤）"
                            Icon="{x:Static ui:SegoeFluentIcons.Message}"
                            SwitchName="ToggleSwitchEnableChickenSoupInWhiteboardMode"
                            Toggled="ToggleSwitchEnableChickenSoupInWhiteboardMode_Toggled" />

                    <ui:SettingsCard Header="信仰の源出自 Where？">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Heart}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="ComboBoxChickenSoupSource"
                                      SelectionChanged="ComboBoxChickenSoupSource_SelectionChanged">
                                <ComboBoxItem Content="osu!玩家语录" />
                                <ComboBoxItem Content="励志立志的名言警句" />
                                <ComboBoxItem Content="高考祝福语" />
                                <ComboBoxItem Content="一言（Hitokoto API）" />
                                <ComboBoxItem Content="Phigros Tips" />
                            </ComboBox>
                            <Button x:Name="BtnHitokotoCustomize" Content="自定义"
                                    Padding="14,4" MinWidth="65" VerticalAlignment="Center"
                                    Click="BtnHitokotoCustomize_Click"
                                    Visibility="Collapsed" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <controls:LabeledSettingsCard x:Name="CardEnableQuickPanel"
                            Header="在收纳模式下启用快速面板"
                            Icon="{x:Static ui:SegoeFluentIcons.Pinned}"
                            SwitchName="ToggleSwitchEnableQuickPanel"
                            Toggled="ToggleSwitchEnableQuickPanel_Toggled" />

                    <ui:SettingsCard Header="快捷面板垂直偏移">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronDown}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="QuickPanelBottomOffsetText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="QuickPanelBottomOffsetSlider" Minimum="-500"
                                    Maximum="0" Width="200"
                                    IsSnapToTickEnabled="True" Value="-150" TickFrequency="10"
                                    TickPlacement="None" AutoToolTipPlacement="None"
                                    ValueChanged="QuickPanelBottomOffsetSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="取消收纳按钮图标">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronRight}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxUnFoldBtnImg"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxUnFoldBtnImg_SelectionChanged">
                            <ComboBoxItem Content="箭头" />
                            <ComboBoxItem Content="笔" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="浮动栏按钮显示" />

                    <controls:LabeledSettingsCard x:Name="CardUseLegacyFloatingBarUI"
                            Header="使用老版浮动栏按钮 UI"
                            Icon="{x:Static ui:SegoeFluentIcons.History}"
                            SwitchName="ToggleSwitchUseLegacyFloatingBarUI"
                            Toggled="ToggleSwitchUseLegacyFloatingBarUI_Toggled" />

                    <ui:SettingsCard Header="浮动栏按钮显示"
                            Description="请前往「工具栏」设置页面管理浮动工具栏的组件显示与排序。"
                            IsClickEnabled="True"
                            Click="CardFloatingBarButtons_Click">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ViewAll}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="任务栏托盘图标" />

                    <controls:LabeledSettingsCard x:Name="CardEnableTrayIcon"
                            Header="启用托盘图标"
                            Icon="{x:Static ui:SegoeFluentIcons.Pin}"
                            SwitchName="ToggleSwitchEnableTrayIcon"
                            Toggled="ToggleSwitchEnableTrayIcon_Toggled" />

                    <ui:SettingsCard Header="托盘左键点击">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronLeft}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxTrayLeftClickAction"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxTrayLeftClickAction_SelectionChanged">
                            <ComboBoxItem Content="打开菜单" />
                            <ComboBoxItem Content="隐藏/显示主窗口" />
                            <ComboBoxItem Content="临时显示主窗口" />
                            <ComboBoxItem Content="打开设置" />
                            <ComboBoxItem Content="禁用/启用所有快捷键" />
                            <ComboBoxItem Content="强制全屏化" />
                            <ComboBoxItem Content="切换浮动栏收纳模式" />
                            <ComboBoxItem Content="重置工具栏位置" />
                            <ComboBoxItem Content="重启软件" />
                            <ComboBoxItem Content="退出软件" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="托盘右键点击">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronRight}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxTrayRightClickAction"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxTrayRightClickAction_SelectionChanged">
                            <ComboBoxItem Content="打开菜单" />
                            <ComboBoxItem Content="隐藏/显示主窗口" />
                            <ComboBoxItem Content="临时显示主窗口" />
                            <ComboBoxItem Content="打开设置" />
                            <ComboBoxItem Content="禁用/启用所有快捷键" />
                            <ComboBoxItem Content="强制全屏化" />
                            <ComboBoxItem Content="切换浮动栏收纳模式" />
                            <ComboBoxItem Content="重置工具栏位置" />
                            <ComboBoxItem Content="重启软件" />
                            <ComboBoxItem Content="退出软件" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <Rectangle Height="48" />
                </ikw:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</ui:Page>
