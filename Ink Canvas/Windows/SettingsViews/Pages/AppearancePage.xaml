<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
      mc:Ignorable="d"
      Title="{x:Static props:ThemeStrings.Theme_GroupTitle}">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                    BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                    TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>
            <Grid>
                <ikw:SimpleStackPanel MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:ThemeStrings.Theme_Label}" />

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_Label}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Pinned}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxTheme"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxTheme_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Light}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Dark}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_System}" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_WindowBackdrop}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.FullScreen}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxWindowBackdrop"
                                  SelectionChanged="ComboBoxWindowBackdrop_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_None}" Tag="None" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Mica}" Tag="Mica" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Acrylic}" Tag="Acrylic" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Tabbed}" Tag="Tabbed" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Transient}" Tag="Transient" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Acrylic10}" Tag="Acrylic10" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Acrylic11}" Tag="Acrylic11" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_LanguageLabel}"
                            Description="{x:Static props:ThemeStrings.Theme_Language_RestartHint}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Globe}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxLanguage"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxLanguage_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_System}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Language_ChineseSimplified}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Language_English}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Language_MemeChinese}" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:ThemeStrings.Theme_EnableSplash}" />

                    <controls:LabeledSettingsCard x:Name="CardEnableSplashScreen"
                            Header="{x:Static props:ThemeStrings.Theme_EnableSplash}"
                            Icon="{x:Static ui:SegoeFluentIcons.Photo}"
                            SwitchName="ToggleSwitchEnableSplashScreen"
                            Toggled="ToggleSwitchEnableSplashScreen_Toggled" />

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_SplashStyle}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Brightness}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxSplashScreenStyle"
                                  SelectedIndex="1"
                                  SelectionChanged="ComboBoxSplashScreenStyle_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Splash_Random}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Splash_Seasonal}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Splash_Spring}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Splash_Summer}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Splash_Autumn}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Splash_Winter}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Splash_Horse}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Splash_Custom}" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <ui:SettingsCard x:Name="CardCustomSplashImage" Header="{x:Static props:ThemeStrings.Theme_CustomSplashImage}"
                                     Description="{x:Static props:ThemeStrings.Theme_CustomSplashImage_Desc}"
                                     Visibility="Collapsed">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Photo}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="TextBlockCustomSplashPath"
                                       Text="{x:Static props:ThemeStrings.Theme_CustomSplash_NotSelected}"
                                       VerticalAlignment="Center"
                                       MaxWidth="200"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="Gray"/>
                            <Button x:Name="ButtonBrowseCustomSplash"
                                    Content="{x:Static props:StorageStrings.Storage_PathBrowse}"
                                    Padding="10,3"
                                    Click="ButtonBrowseCustomSplash_Click"/>
                            <Button x:Name="ButtonClearCustomSplash"
                                    Content="{x:Static props:ThemeStrings.Theme_Clear}"
                                    Padding="10,3"
                                    Click="ButtonClearCustomSplash_Click"/>
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard x:Name="CardCustomSplashTextPosition" Header="{x:Static props:ThemeStrings.Theme_CustomSplashTextPosition}"
                                     Description="{x:Static props:ThemeStrings.Theme_CustomSplashTextPosition_Desc}"
                                     Visibility="Collapsed">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.AlignCenter}" />
                        </ui:SettingsCard.HeaderIcon>
                        <Border CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="#30808080"
                                Background="Transparent"
                                Width="110"
                                Height="32">
                            <Grid ClipToBounds="True">
                                <!-- 滑动选择指示器 -->
                                <Border x:Name="SelectionIndicator"
                                        CornerRadius="3"
                                        Background="#200078D7"
                                        BorderBrush="#800078D7"
                                        BorderThickness="1"
                                        Width="34"
                                        Height="28"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="1,1,0,1"
                                        Panel.ZIndex="1">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="IndicatorTranslateTransform" X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                                <!-- 按钮层 -->
                                <ikw:SimpleStackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border x:Name="BorderTextAlignLeft"
                                            Width="36" Height="30"
                                            PreviewMouseLeftButtonDown="BorderTextAlign_Click"
                                            Tag="0"
                                            Cursor="Hand"
                                            Panel.ZIndex="2">
                                        <Canvas>
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.AlignLeft}" FontSize="14"
                                                         Canvas.Left="11" Canvas.Top="8"
                                                         Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                        </Canvas>
                                    </Border>
                                    <Border x:Name="BorderTextAlignCenter"
                                            Width="36" Height="30"
                                            PreviewMouseLeftButtonDown="BorderTextAlign_Click"
                                            Tag="1"
                                            Cursor="Hand"
                                            Panel.ZIndex="2">
                                        <Canvas>
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.AlignCenter}" FontSize="14"
                                                         Canvas.Left="11" Canvas.Top="8"
                                                         Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                        </Canvas>
                                    </Border>
                                    <Border x:Name="BorderTextAlignRight"
                                            Width="36" Height="30"
                                            PreviewMouseLeftButtonDown="BorderTextAlign_Click"
                                            Tag="2"
                                            Cursor="Hand"
                                            Panel.ZIndex="2">
                                        <Canvas>
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.AlignRight}" FontSize="14"
                                                         Canvas.Left="11" Canvas.Top="8"
                                                         Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                        </Canvas>
                                    </Border>
                                </ikw:SimpleStackPanel>
                            </Grid>
                        </Border>
                    </ui:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:ThemeStrings.Theme_FloatingBarIcon}" />

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_FloatingBarIcon}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Photo}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxFloatingBarImg"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxFloatingBarImg_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_IccDefault}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_IccNoShadow}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_IccDark}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_IccDarkBreath}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_IccWhiteTransparent}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_IccBlackTransparent}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_CoolapkCrossEye}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_CoolapkAbused}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_CoolapkSmile}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_CoolapkUnderwear}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_CoolapkGreenHatDoge}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_FloatingIcon_TiebaEmoji}" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button x:Name="ButtonAddCustomIcon" Content="{x:Static props:ThemeStrings.Theme_Upload}"
                                Click="ButtonAddCustomIcon_Click" Padding="10,3"/>
                        <Button x:Name="ButtonManageCustomIcons" Content="{x:Static props:ThemeStrings.Theme_Manage}"
                                Click="ButtonManageCustomIcons_Click" Padding="10,3"/>
                    </ikw:SimpleStackPanel>

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_FloatingBarScale}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Pinned}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="ViewboxFloatingBarActualScaleText"
                                       Text="1.00x"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <TextBlock Text=" (" VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="ViewboxFloatingBarScaleSliderText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <TextBlock Text=")" VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>
                            <Slider x:Name="ViewboxFloatingBarScaleTransformValueSlider" Minimum="0.5"
                                    Maximum="1.25" Width="200"
                                    IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05"
                                    TickPlacement="None" AutoToolTipPlacement="None"
                                    ValueChanged="ViewboxFloatingBarScaleTransformValueSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_FloatingBarOpacity}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.EaseOfAccess}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="ViewboxFloatingBarOpacityText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="ViewboxFloatingBarOpacityValueSlider" Minimum="0.3"
                                    Maximum="1" Width="200"
                                    IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05"
                                    TickPlacement="None" AutoToolTipPlacement="None"
                                    ValueChanged="ViewboxFloatingBarOpacityValueSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_FloatingBarOpacityInPPT}"
                            Description="{x:Static props:ThemeStrings.Theme_FloatingBarOpacityInPPTHint}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Play}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="ViewboxFloatingBarOpacityInPPTText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="ViewboxFloatingBarOpacityInPPTValueSlider" Minimum="0.3"
                                    Maximum="1" Width="200"
                                    IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05"
                                    TickPlacement="None" AutoToolTipPlacement="None"
                                    ValueChanged="ViewboxFloatingBarOpacityInPPTValueSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_BlackboardScale80}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.BackToWindow}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="ViewboxBlackBoardScaleText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="ViewboxBlackBoardScaleTransformValueSlider" Minimum="0.5"
                                    Maximum="1.5" Width="200"
                                    IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05"
                                    TickPlacement="None" AutoToolTipPlacement="None"
                                    ValueChanged="ViewboxBlackBoardScaleTransformValueSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <controls:LabeledSettingsCard x:Name="CardEnableTimeDisplayInWhiteboardMode"
                            Header="{x:Static props:ThemeStrings.Theme_ShowTimeInWhiteboard}"
                            Icon="{x:Static ui:SegoeFluentIcons.Pinned}"
                            SwitchName="ToggleSwitchEnableTimeDisplayInWhiteboardMode"
                            Toggled="ToggleSwitchEnableTimeDisplayInWhiteboardMode_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardUse24HourTimeFormat"
                            Header="{x:Static props:ThemeStrings.AppearancePanel_24HourTimeFormat}"
                            Toggled="ToggleSwitchUse24HourTimeFormat_Toggled">
                        <controls:LabeledSettingsCard.HeaderIcon>
                            <ui:FontIcon Glyph="&#xE917;" />
                        </controls:LabeledSettingsCard.HeaderIcon>
                    </controls:LabeledSettingsCard>

                    <controls:LabeledSettingsCard x:Name="CardEnableChickenSoupInWhiteboardMode"
                            Header="{x:Static props:ThemeStrings.Theme_ShowQuoteInWhiteboard}"
                            Icon="{x:Static ui:SegoeFluentIcons.Message}"
                            SwitchName="ToggleSwitchEnableChickenSoupInWhiteboardMode"
                            Toggled="ToggleSwitchEnableChickenSoupInWhiteboardMode_Toggled" />

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_QuoteSource}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Heart}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="ComboBoxChickenSoupSource"
                                      SelectionChanged="ComboBoxChickenSoupSource_SelectionChanged">
                                <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_QuoteSource_OsuQuotes}" />
                                <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_QuoteSource_Mottos}" />
                                <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_QuoteSource_GaokaoBless}" />
                                <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_QuoteSource_Hitokoto}" />
                                <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_QuoteSource_PhigrosTips}" />
                            </ComboBox>
                            <Button x:Name="BtnHitokotoCustomize" Content="{x:Static props:ThemeStrings.Theme_Splash_Custom}"
                                    Padding="14,4" MinWidth="65" VerticalAlignment="Center"
                                    Click="BtnHitokotoCustomize_Click"
                                    Visibility="Collapsed" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <controls:LabeledSettingsCard x:Name="CardEnableQuickPanel"
                            Header="{x:Static props:ThemeStrings.Theme_EnableQuickPanel}"
                            Icon="{x:Static ui:SegoeFluentIcons.Pinned}"
                            SwitchName="ToggleSwitchEnableQuickPanel"
                            Toggled="ToggleSwitchEnableQuickPanel_Toggled" />

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_QuickPanelBottomOffset}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronDown}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="QuickPanelBottomOffsetText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="QuickPanelBottomOffsetSlider" Minimum="-500"
                                    Maximum="0" Width="200"
                                    IsSnapToTickEnabled="True" Value="-150" TickFrequency="10"
                                    TickPlacement="None" AutoToolTipPlacement="None"
                                    ValueChanged="QuickPanelBottomOffsetSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_UnfoldButtonIcon}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronRight}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxUnFoldBtnImg"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxUnFoldBtnImg_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_UnfoldIcon_Arrow}" />
                            <ComboBoxItem Content="{x:Static props:FloatingBarStrings.Board_Pen}" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:ThemeStrings.Theme_FloatingBarButtonsTitle}" />

                    <controls:LabeledSettingsCard x:Name="CardUseLegacyFloatingBarUI"
                            Header="{x:Static props:ThemeStrings.Theme_UseLegacyFloatingBarUI}"
                            Icon="{x:Static ui:SegoeFluentIcons.History}"
                            SwitchName="ToggleSwitchUseLegacyFloatingBarUI"
                            Toggled="ToggleSwitchUseLegacyFloatingBarUI_Toggled" />

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_FloatingBarButtonsTitle}"
                            Description="{x:Static props:ThemeStrings.Theme_FloatingBarButtonsDescription}"
                            IsClickEnabled="True"
                            Click="CardFloatingBarButtons_Click">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ViewAll}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:WindowStrings.Tray_GroupTitle}" />

                    <controls:LabeledSettingsCard x:Name="CardEnableTrayIcon"
                            Header="{x:Static props:WindowStrings.Tray_EnableTrayIcon}"
                            Icon="{x:Static ui:SegoeFluentIcons.Pin}"
                            SwitchName="ToggleSwitchEnableTrayIcon"
                            Toggled="ToggleSwitchEnableTrayIcon_Toggled" />

                    <ui:SettingsCard Header="{x:Static props:WindowStrings.Tray_LeftClickAction}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronLeft}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxTrayLeftClickAction"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxTrayLeftClickAction_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_ShowMenu}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_HideShowMainWindow}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_TempShowMainWindow}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_OpenSettings}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_DisableAllHotkeys}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_ForceFullScreen}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_ToggleFoldFloatingBar}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_ResetFloatingBarPosition}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_RestartApp}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_CloseApp}" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:WindowStrings.Tray_RightClickAction}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronRight}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxTrayRightClickAction"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxTrayRightClickAction_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_ShowMenu}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_HideShowMainWindow}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_TempShowMainWindow}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_OpenSettings}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_DisableAllHotkeys}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_ForceFullScreen}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_ToggleFoldFloatingBar}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_ResetFloatingBarPosition}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_RestartApp}" />
                            <ComboBoxItem Content="{x:Static props:WindowStrings.Tray_ClickAction_CloseApp}" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <Rectangle Height="48" />
                </ikw:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</ui:Page>
