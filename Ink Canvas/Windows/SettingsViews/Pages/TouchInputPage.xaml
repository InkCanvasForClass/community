<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.TouchInputPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d"
      Title="{x:Static props:AdvancedStrings.TouchInput_Title}">
    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                       BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                       TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>
            <Grid>
                <ikw:SimpleStackPanel MaxWidth="1000" HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:AdvancedStrings.TouchInput_Title}" />

                    <ui:SettingsCard Header="{x:Static props:AdvancedStrings.TouchInput_TouchWritingTitle}"
                                     Description="{x:Static props:AdvancedStrings.TouchInput_TouchWritingHint}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Touch}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="CmbTouchWriting" Width="240"
                                  SelectionChanged="CmbTouchWriting_SelectionChanged" />
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:AdvancedStrings.TouchInput_PalmEraserTitle}"
                                     Description="{x:Static props:AdvancedStrings.TouchInput_PalmEraserHint}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.EraseTool}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="CmbPalmEraser" Width="240"
                                  SelectionChanged="CmbPalmEraser_SelectionChanged" />
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:AdvancedStrings.TouchInput_MouseWritingTitle}"
                                     Description="{x:Static props:AdvancedStrings.TouchInput_MouseWritingHint}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Mouse}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="CmbMouseWriting" Width="240"
                                  SelectionChanged="CmbMouseWriting_SelectionChanged" />
                    </ui:SettingsCard>

                    <ui:InfoBar x:Name="BarStatus" IsClosable="False"
                                Severity="Informational" />

                    <ui:InfoBar IsClosable="False" IsOpen="True" Severity="Informational"
                                Message="{x:Static props:AdvancedStrings.TouchInput_CalibrationHint}" />

                    <Rectangle Height="48" />
                </ikw:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</ui:Page>
