                    <ui:SettingsExpander Visibility="{Binding IsOn, ElementName=CardShowPPTButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                            IsExpanded="{Binding IsOn, ElementName=CardShowPPTButton, Mode=OneWay}">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.CaretSolidDown}"/>
                        </ui:SettingsExpander.HeaderIcon>
                        <ui:SettingsExpander.Header>
                            <Grid HorizontalAlignment="Stretch" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ui:SettingsExpander}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{i18n:I18n Key=PPT_Position_LeftBottom}" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                                <ui:ToggleSwitch Grid.Column="1" x:Name="CheckboxEnableLBPPTButton" Toggled="CheckboxEnableLBPPTButton_IsCheckChanged" Margin="8,0,0,0" IsOn="True" OnContent="" OffContent=""/>
