                    <ui:SettingsExpander Visibility="{Binding IsOn, ElementName=CardShowPPTButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                            IsExpanded="{Binding IsOn, ElementName=CardShowPPTButton, Mode=OneWay}">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.CaretSolidLeft}"/>
                        </ui:SettingsExpander.HeaderIcon>
                        <ui:SettingsExpander.Header>
                            <Grid HorizontalAlignment="Stretch" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ui:SettingsExpander}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{i18n:I18n Key=PPT_Position_Left}" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                                <ui:ToggleSwitch Grid.Column="1" x:Name="CheckboxEnableLSPPTButton" Toggled="CheckboxEnableLSPPTButton_IsCheckChanged" Margin="8,0,0,0" IsOn="True" OnContent="" OffContent=""/>
                            </Grid>
                        </ui:SettingsExpander.Header>
                        <ui:SettingsExpander.Content>
                            <CheckBox Visibility="Collapsed"/>
                        </ui:SettingsExpander.Content>
                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard Header="{i18n:I18n Key=PPT_LeftOffset}">
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="PPTButtonLeftPositionText"
                                               VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                                    <Slider x:Name="PPTButtonLeftPositionValueSlider" Minimum="-500" Maximum="500" Width="160" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="PPTButtonLeftPositionValueSlider_ValueChanged"/>
                                    <Button Padding="4,2" Click="ResetLeftOffset_Click">
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Refresh}" FontSize="12"/>
                                    </Button>
                                </ikw:SimpleStackPanel>
                            </ui:SettingsCard>
                            <ui:SettingsCard Header="{i18n:I18n Key=PPT_LeftOpacity}" Visibility="{Binding IsChecked, ElementName=CheckboxSPPTHalfOpacity, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="PPTLSButtonOpacityText"
                                               VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                                    <Slider x:Name="PPTLSButtonOpacityValueSlider" Minimum="0.1" Maximum="1.0" Width="160" ValueChanged="PPTLSButtonOpacityValueSlider_ValueChanged"/>
                                    <Button Padding="4,2" Click="ResetLeftOpacity_Click">
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Refresh}" FontSize="12"/>
                                    </Button>
                                </ikw:SimpleStackPanel>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>

                    <ui:SettingsExpander Visibility="{Binding IsOn, ElementName=CardShowPPTButton, Converter={StaticResource BooleanToVisibilityConverter}}"
