                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.16"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="50" Height="50" Background="Transparent" CornerRadius="5 5 0 0">
                                            <Path Fill="#27272a" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
