<Window x:Class="Ink_Canvas.Windows.SettingsViews.Pages.BoardToolbarComponentPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择组件" Width="300" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="ListBoxComponents" DisplayMemberPath="DisplayName"
                 FontSize="13"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Click="ButtonOK_Click" Padding="16,6" FontSize="12" Margin="0,0,8,0"/>
            <Button Content="取消" Click="ButtonCancel_Click" Padding="16,6" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
