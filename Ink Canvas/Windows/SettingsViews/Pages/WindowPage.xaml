<?xml version="1.0" encoding="utf-8"?><Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.WindowPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages" xmlns:helpers="clr-namespace:Ink_Canvas.Windows.SettingsViews.Helpers" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls" xmlns:c="clr-namespace:Ink_Canvas.Converter" mc:Ignorable="d" Title="{x:Static props:WindowStrings.Title}">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
            <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
            <c:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style TargetType="ui:FontIcon">
                <Setter Property="FontSize" Value="24" />
            </Style>
            <Style x:Key="SettingsSectionHeaderTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Style.Setters>
                    <Setter Property="Margin" Value="1,30,0,6" />
                </Style.Setters>
            </Style>
            <helpers:TopMostModeTemplateSelector x:Key="TopMostModeSelector">
                <helpers:TopMostModeTemplateSelector.SelectionTemplate>
                    <DataTemplate>
                        <ui:CardControl Header="{x:Static props:StartupStrings.TopMostMode}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{x:Static props:StartupStrings.TopMostMode_Normal}" GroupName="TopMostMode" Checked="RadioTopMostNormal_Checked" Loaded="RadioTopMostNormal_Loaded" Margin="0,0,16,0" />
                                <RadioButton Content="{x:Static props:StartupStrings.TopMostMode_UIA}" GroupName="TopMostMode" Checked="RadioTopMostUIA_Checked" Loaded="RadioTopMostUIA_Loaded" />
                            </StackPanel>
                        </ui:CardControl>
                    </DataTemplate>
                </helpers:TopMostModeTemplateSelector.SelectionTemplate>
                <helpers:TopMostModeTemplateSelector.ButtonTemplate>
                    <DataTemplate>
                        <ui:CardControl Header="{Binding ButtonHeader}">
                            <Button Content="{Binding ButtonContent}" Click="BtnRestart_Click" Tag="{Binding RestartAsAdmin}" />
                        </ui:CardControl>
                    </DataTemplate>
                </helpers:TopMostModeTemplateSelector.ButtonTemplate>
            </helpers:TopMostModeTemplateSelector>
        </FrameworkElement.Resources>
            <Grid>
                <vio:SimpleStackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Static props:WindowStrings.WindowSettings}" />

                    <controls:LabeledSettingsCard x:Name="CardNoFocusMode" Header="{x:Static props:StartupStrings.NoFocusMode}" Description="{x:Static props:StartupStrings.NoFocusModeHint}" Symbol="Eye24" SwitchName="ToggleSwitchNoFocusMode" Toggled="ToggleSwitchNoFocusMode_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardWindowMode" Header="{x:Static props:StartupStrings.NoBorderMode}" Description="{x:Static props:StartupStrings.NoBorderModeHint}" Symbol="FullScreenMaximize24" SwitchName="ToggleSwitchWindowMode" Toggled="ToggleSwitchWindowMode_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardWindowChromeRendering" Header="{x:Static props:WindowStrings.Window_WindowChromeRendering}" Description="{x:Static props:WindowStrings.Window_WindowChromeRenderingHint}" Symbol="Gauge24" SwitchName="ToggleSwitchWindowChromeRendering" Toggled="ToggleSwitchWindowChromeRendering_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardAvoidFullScreen" Header="{x:Static props:AdvancedStrings.AvoidFullScreenHelper}" Description="{x:Static props:AdvancedStrings.AvoidFullScreenHelperHint}" Symbol="Dismiss24" SwitchName="ToggleSwitchAvoidFullScreen" Toggled="ToggleSwitchAvoidFullScreen_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardMultiScreenSupport" Header="{x:Static props:WindowStrings.MultiScreenSupport}" Description="{x:Static props:WindowStrings.MultiScreenSupportHint}" SwitchName="ToggleSwitchMultiScreenSupport" Toggled="ToggleSwitchMultiScreenSupport_Toggled">
                        <controls:LabeledSettingsCard.HeaderIcon>
                            <ui:SymbolIcon Symbol="Desktop24" />
                        </controls:LabeledSettingsCard.HeaderIcon>
                    </controls:LabeledSettingsCard>

                    <controls:LabeledSettingsCard x:Name="CardFollowMouseScreen" Header="{x:Static props:WindowStrings.FollowMouseScreen}" Description="{x:Static props:WindowStrings.FollowMouseScreenHint}" Visibility="{Binding IsOn, ElementName=CardMultiScreenSupport, Converter={StaticResource BooleanToVisibilityConverter}}" SwitchName="ToggleSwitchFollowMouseScreen" Toggled="ToggleSwitchFollowMouseScreen_Toggled">
                        <controls:LabeledSettingsCard.HeaderIcon>
                            <ui:SymbolIcon Symbol="Desktop24" />
                        </controls:LabeledSettingsCard.HeaderIcon>
                    </controls:LabeledSettingsCard>

                    <ui:CardExpander x:Name="ExpanderAlwaysOnTop" IsExpanded="{Binding IsChecked, ElementName=ToggleSwitchAlwaysOnTop, Mode=OneWay}" d:Visibility="Visible" d:IsExpanded="True">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="{x:Static props:StartupStrings.TopMost}" Grid.Row="0" Grid.Column="0" FontTypography="Body" />
                                <ui:TextBlock Text="{x:Static props:StartupStrings.TopMostHint}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Grid.Row="1" Grid.Column="0" />
                                <ui:ToggleSwitch x:Name="ToggleSwitchAlwaysOnTop" Checked="ToggleSwitchAlwaysOnTop_Toggled" Unchecked="ToggleSwitchAlwaysOnTop_Toggled" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" Margin="0,0,16,0" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <ui:CardExpander.Icon>
                            <ui:SymbolIcon Symbol="Pin24" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <ContentControl x:Name="AlwaysOnTopSelectionHost" HorizontalContentAlignment="Stretch" ContentTemplateSelector="{StaticResource TopMostModeSelector}" />
                            <ContentControl x:Name="AlwaysOnTopButtonHost" HorizontalContentAlignment="Stretch" ContentTemplateSelector="{StaticResource TopMostModeSelector}" />
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardControl x:Name="CardUIAMode" Visibility="Collapsed" Margin="0,-2,0,0">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{x:Static props:StartupStrings.UIAMode_Label}" />
                                <TextBlock Text="{x:Static props:StartupStrings.UIAMode_Description}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:CardControl.Icon>
                            <ui:SymbolIcon Symbol="Person24" />
                        </ui:CardControl.Icon>
                        <ComboBox x:Name="ComboBoxUIAMode" SelectionChanged="ComboBoxUIAMode_SelectionChanged" MinWidth="180" />
                    </ui:CardControl>

                    <Rectangle Height="48" />

                </vio:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
