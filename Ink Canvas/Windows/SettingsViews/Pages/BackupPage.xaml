<Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.BackupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
      mc:Ignorable="d"
      Title="{x:Static props:StorageStrings.Backup_Title}">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                    BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                    TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>
            <Grid>
                <vio:SimpleStackPanel MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchIsAutoBackupBeforeUpdate"
                        Header="{x:Static props:StorageStrings.Backup_AutoBeforeUpdate}"
                        IsOn="True"
                        Toggled="ToggleSwitchIsAutoBackupBeforeUpdate_Toggled"/>

                    <controls:SettingsExpander x:Name="ExpanderAutoBackup"
                                         Header="{x:Static props:StorageStrings.Backup_AutoPeriodic}"
                                         IsExpanded="{Binding IsOn, ElementName=ToggleSwitchIsAutoBackupEnabled, Mode=OneWay}">
                        <StackPanel>
                            <ui:ToggleSwitch x:Name="ToggleSwitchIsAutoBackupEnabled"
                                             Checked="ToggleSwitchIsAutoBackupEnabled_Toggled"
 Unchecked="ToggleSwitchIsAutoBackupEnabled_Toggled"/>
                            <controls:SettingsCard Header="{x:Static props:StorageStrings.Backup_Interval}"
                                             Description="{x:Static props:StorageStrings.Backup_Interval_DefaultHint}">
                                <ComboBox x:Name="ComboBoxAutoBackupInterval"
                                          SelectionChanged="ComboBoxAutoBackupInterval_SelectionChanged">
                                    <ComboBoxItem Content="{x:Static props:StorageStrings.Backup_Interval_1Day}" Tag="1" />
                                    <ComboBoxItem Content="{x:Static props:StorageStrings.Backup_Interval_3Days}" Tag="3" />
                                    <ComboBoxItem Content="{x:Static props:StorageStrings.Backup_Interval_7Days}" Tag="7" IsSelected="True" />
                                    <ComboBoxItem Content="{x:Static props:StorageStrings.Backup_Interval_14Days}" Tag="14" />
                                    <ComboBoxItem Content="{x:Static props:StorageStrings.Backup_Interval_30Days}" Tag="30" />
                                </ComboBox>
                            </controls:SettingsCard>
                        </StackPanel>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="{x:Static props:StorageStrings.Backup_Manual}"
                                         IsExpanded="True">
                        <StackPanel>
                            <controls:SettingsCard Header="{x:Static props:StorageStrings.Backup_Manual}"
                                             IsClickEnabled="True" Click="BtnManualBackup_Click">
                                <controls:SettingsCard.HeaderIcon>
                                    <ui:SymbolIcon Symbol="ArrowSync24" />
                                </controls:SettingsCard.HeaderIcon>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="{x:Static props:StorageStrings.Backup_Restore}"
                                             IsClickEnabled="True" Click="BtnRestoreBackup_Click">
                                <controls:SettingsCard.HeaderIcon>
                                    <ui:SymbolIcon Symbol="History24" />
                                </controls:SettingsCard.HeaderIcon>
                            </controls:SettingsCard>
                        </StackPanel>
                    </controls:SettingsExpander>

                    <Rectangle Height="48" />

                </vio:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
