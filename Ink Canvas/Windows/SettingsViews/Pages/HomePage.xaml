<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d"

      Title="{x:Static props:HomeStrings.Home_Title}">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                    BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                    TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>
            <Grid>
                <ikw:SimpleStackPanel MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:NotificationStrings.ActionsTitle}" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SettingsCard Header="{x:Static props:BtnStrings.Restart}" Description="{x:Static props:HomeStrings.Home_RestartApp}"
                        IsClickEnabled="True" Click="BtnRestart_Click" Grid.Column="0" Margin="0,0,4,0">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Refresh}" />
                            </ui:SettingsCard.HeaderIcon>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{x:Static props:TimerStrings.Timer_Reset}" Description="{x:Static props:HomeStrings.Home_ResetSettings}"
                        IsClickEnabled="True" Click="BtnResetToSuggestion_Click" Grid.Column="1" Margin="0,0,4,0">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Clear}" />
                            </ui:SettingsCard.HeaderIcon>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{x:Static props:FloatingBarStrings.OldUI_Exit}" Description="{x:Static props:HomeStrings.Home_ExitApp}"
                        IsClickEnabled="True" Click="BtnExit_Click" Grid.Column="2">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Cancel}" />
                            </ui:SettingsCard.HeaderIcon>
                        </ui:SettingsCard>
                    </Grid>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:HomeStrings.Home_Basic}" />

                    <ui:SettingsCard Header="{x:Static props:StartupStrings.Start}" Description="{x:Static props:NavStrings.Nav_Startup}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="StartupPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Play}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:HomeStrings.Home_Privacy}" Description="{x:Static props:HomeStrings.Home_PrivacySettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="PrivacyPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Shield}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:NavStrings.Settings_Nav_Security}" Description="{x:Static props:NavStrings.Settings_Nav_Security_Tooltip}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="SecurityPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Permissions}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>
                    
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:HomeStrings.Home_MainUI}" />
                    <ui:SettingsCard Header="{x:Static props:HomeStrings.Home_Window}" Description="{x:Static props:HomeStrings.Home_WindowSettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="WindowPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Pinned}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_GroupTitle}" Description="{x:Static props:NavStrings.Nav_Theme_Settings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="AppearancePage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Personalize}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:NavStrings.Nav_Shortcuts}" Description="{x:Static props:NavStrings.Settings_Nav_Hotkey_Tooltip}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="HotkeyPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.KeyboardStandard}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:HomeStrings.Home_Toolbar}" Description="{x:Static props:HomeStrings.Home_ToolbarSettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="ToolbarPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Rename}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>
                    
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:CanvasStrings.Canvas_GroupTitle}" />
                    <ui:SettingsCard Header="{x:Static props:CanvasStrings.Canvas_GroupTitle}" Description="{x:Static props:HomeStrings.Home_CanvasSettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="CanvasPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Edit}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:CanvasStrings.InkRecog_Title}" Description="{x:Static props:HomeStrings.Home_InkRecognitionSettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="InkRecognitionPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Draw}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:PPTStrings.GroupTitle}" />
                    <ui:SettingsCard Header="{x:Static props:PPTStrings.GroupTitle}" Description="{x:Static props:HomeStrings.Home_PPTSettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="PowerPointPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Slideshow}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:NotificationStrings.Type_Update}" Description="{x:Static props:HomeStrings.Home_UpdateSettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="UpdatePage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Sync}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:NotificationStrings.DefaultTitle}" />
                    <ui:SettingsCard Header="{x:Static props:NotificationStrings.DefaultTitle}" Description="{x:Static props:NotificationStrings.NavTooltip}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="NotificationPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Message}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:AnnouncementStrings.CenterTitle}" Description="{x:Static props:AnnouncementStrings.CenterHint}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="AnnouncementCenterPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.BulletedList}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:NotificationStrings.Type_Other}" />
                    <ui:SettingsCard Header="{x:Static props:AdvancedStrings.Experimental}" Description="{x:Static props:AdvancedStrings.Experimental}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="ExperimentalPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.DeveloperTools}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:NavStrings.Nav_Advanced}" Description="{x:Static props:NavStrings.Nav_Advanced_Settings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="AdvancedPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Settings}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:StorageStrings.Storage_Title}" Description="{x:Static props:StorageStrings.Storage_NavTooltip}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="StoragePage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.HardDrive}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:CloudStorageStrings.CloudStorage_Manage}" Description="{x:Static props:HomeStrings.Home_CloudStorageSettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="CloudStoragePage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Cloud}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:AutomationStrings.Automation_Title}" Description="{x:Static props:NavStrings.Nav_Automation_Settings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="AutomationPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Sync}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:RandomStrings.Random_Title}" Description="{x:Static props:HomeStrings.Home_RandomAndTimer}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="RandomDrawPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.People}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="Debug" Description="Debug"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="DebugPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.DeveloperTools}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:HomeStrings.Home_PluginSettings}" />
                    <ui:SettingsCard Header="{x:Static props:NavStrings.Nav_Plugins}" Description="{x:Static props:NavStrings.Settings_Plugins}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="PluginPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Puzzle}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:AboutStrings.Title}" Description="{x:Static props:HomeStrings.Home_AboutApp}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="AboutPage">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Info}" />
                        </ui:SettingsCard.HeaderIcon>
                    </ui:SettingsCard>

                    <Rectangle Height="48" />

                </ikw:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</ui:Page>
