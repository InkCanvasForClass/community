<Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
      xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d"

      Title="{x:Static props:HomeStrings.Home_Title}">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                    BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                    TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>
            <Grid>
                <vio:SimpleStackPanel MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:NotificationStrings.ActionsTitle}" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:SettingsCard Header="{x:Static props:BtnStrings.Restart}" Description="{x:Static props:HomeStrings.Home_RestartApp}"
                        IsClickEnabled="True" Click="BtnRestart_Click" Grid.Column="0" Margin="0,0,4,0">
                            <controls:SettingsCard.Icon>
                                <ui:SymbolIcon Symbol="ArrowClockwise24" />
                            </controls:SettingsCard.Icon>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Static props:HomeStrings.Home_Reset}" Description="{x:Static props:HomeStrings.Home_ResetSettings}"
                        IsClickEnabled="True" Click="BtnResetToSuggestion_Click" Grid.Column="1" Margin="0,0,4,0">
                            <controls:SettingsCard.Icon>
                                <ui:SymbolIcon Symbol="ClearFormatting24" />
                            </controls:SettingsCard.Icon>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Static props:FloatingBarStrings.OldUI_Exit}" Description="{x:Static props:HomeStrings.Home_ExitApp}"
                        IsClickEnabled="True" Click="BtnExit_Click" Grid.Column="2">
                            <controls:SettingsCard.Icon>
                                <ui:SymbolIcon Symbol="Dismiss24" />
                            </controls:SettingsCard.Icon>
                        </controls:SettingsCard>
                    </Grid>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:HomeStrings.Home_Basic}" />

                    <controls:SettingsCard Header="{x:Static props:StartupStrings.Start}" Description="{x:Static props:NavStrings.Nav_Startup_Tooltip}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="StartupPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Play24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:NavStrings.Nav_Clock}" Description="{x:Static props:HomeStrings.Home_ClockSettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="ClockPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Timer24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:HomeStrings.Home_Privacy}" Description="{x:Static props:HomeStrings.Home_PrivacySettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="PrivacyPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Shield24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:NavStrings.Settings_Nav_Security}" Description="{x:Static props:NavStrings.Settings_Nav_Security_Tooltip}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="SecurityPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="ShieldTask24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:NavStrings.Nav_Advanced}" Description="{x:Static props:NavStrings.Nav_Advanced_Settings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="AdvancedPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:NavStrings.Nav_Performance}" Description="{x:Static props:HomeStrings.Home_PerformanceSettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="PerformancePage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Gauge24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>
                    
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:HomeStrings.Home_MainUI}" />
                    <controls:SettingsCard Header="{x:Static props:HomeStrings.Home_Window}" Description="{x:Static props:HomeStrings.Home_WindowSettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="WindowPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Pin24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:ThemeStrings.Theme_GroupTitle}" Description="{x:Static props:NavStrings.Nav_Theme_Settings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="AppearancePage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="PaintBrush24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:NavStrings.Nav_Shortcuts}" Description="{x:Static props:NavStrings.Settings_Nav_Hotkey_Tooltip}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="HotkeyPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Keyboard24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:NavStrings.Nav_ToolbarComponents}" Description="{x:Static props:NavStrings.Nav_ToolbarComponents_Tooltip}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="ToolbarPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Rename24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:NavStrings.Nav_ToolbarAppearance}" Description="{x:Static props:NavStrings.Nav_ToolbarAppearance_Tooltip}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="ToolbarAppearancePage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="PaintBrush24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:NavStrings.Nav_ToolbarMenu}" Description="{x:Static props:NavStrings.Nav_ToolbarMenu_Tooltip}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="ToolbarMenuPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="TextBulletListLtr24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>
                    
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:CanvasStrings.Canvas_GroupTitle}" />
                    <controls:SettingsCard Header="{x:Static props:CanvasStrings.Canvas_GroupTitle}" Description="{x:Static props:HomeStrings.Home_CanvasSettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="CanvasPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Edit24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:CanvasStrings.InkRecog_Title}" Description="{x:Static props:HomeStrings.Home_InkRecognitionSettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="InkRecognitionPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="DrawImage24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:PPTStrings.GroupTitle}" />
                    <controls:SettingsCard Header="{x:Static props:PPTStrings.GroupTitle}" Description="{x:Static props:HomeStrings.Home_PPTSettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="PowerPointPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="SlideTransition24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:NotificationStrings.Type_Update}" />
                    <controls:SettingsCard Header="{x:Static props:NotificationStrings.Type_Update}" Description="{x:Static props:HomeStrings.Home_UpdateSettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="UpdatePage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:NotificationStrings.DefaultTitle}" />
                    <controls:SettingsCard Header="{x:Static props:NotificationStrings.DefaultTitle}" Description="{x:Static props:NotificationStrings.NavTooltip}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="NotificationPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="ChatMultiple24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:AnnouncementStrings.CenterTitle}" Description="{x:Static props:AnnouncementStrings.CenterHint}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="AnnouncementCenterPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="TextBulletListLtr24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:NotificationStrings.Type_Other}" />
                    <controls:SettingsCard Header="{x:Static props:AdvancedStrings.Experimental}" Description="{x:Static props:AdvancedStrings.Experimental}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="ExperimentalPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="WindowDevTools24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:StorageStrings.Storage_Title}" Description="{x:Static props:StorageStrings.Storage_NavTooltip}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="StoragePage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="HardDrive24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:StorageStrings.Backup_Title}" Description="{x:Static props:HomeStrings.Home_BackupSettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="BackupPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:CloudStorageStrings.CloudStorage_Manage}" Description="{x:Static props:HomeStrings.Home_CloudStorageSettings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="CloudStoragePage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Cloud24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:NavStrings.Nav_Board}" />
                    <controls:SettingsCard Header="{x:Static props:NavStrings.Nav_BoardComponents}" Description="{x:Static props:NavStrings.Nav_BoardComponents_Tooltip}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="BoardToolbarPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Rename24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:NavStrings.Nav_BoardAppearance}" Description="{x:Static props:NavStrings.Nav_BoardAppearance_Tooltip}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="BoardAppearancePage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="PaintBrush24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:NavStrings.Nav_BoardMenu}" Description="{x:Static props:NavStrings.Nav_BoardMenu_Tooltip}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="BoardMenuPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="TextBulletListLtr24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:AutomationStrings.Automation_Title}" Description="{x:Static props:NavStrings.Nav_Automation_Settings}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="AutomationWorkflowPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:RandomStrings.Random_Title}" Description="{x:Static props:HomeStrings.Home_RandomAndTimer}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="RandomDrawPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="People24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Debug" Description="Debug"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="DebugPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="WindowDevTools24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:HomeStrings.Home_PluginSettings}" />
                    <controls:SettingsCard Header="{x:Static props:NavStrings.Nav_Plugins}" Description="{x:Static props:NavStrings.Settings_Plugins}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="PluginPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="PuzzlePiece24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:NavStrings.Nav_FriendlyLinks}" />
                    <controls:SettingsCard Header="{x:Static props:NavStrings.Nav_FriendlyLinks}" Description="{x:Static props:HomeStrings.Home_FriendlyLinks}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="FriendlyLinksPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Link24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="{x:Static props:AboutStrings.Title}" Description="{x:Static props:HomeStrings.Home_AboutApp}"
                        IsClickEnabled="True" Click="QuickNavCard_Click" Tag="AboutPage">
                        <controls:SettingsCard.Icon>
                            <ui:SymbolIcon Symbol="Info24" />
                        </controls:SettingsCard.Icon>
                    </controls:SettingsCard>

                    <Rectangle Height="48" />

                </vio:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
