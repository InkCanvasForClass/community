<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
      mc:Ignorable="d"

      Title="{x:Static props:StartupStrings.Start}">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
            <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
            <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                TargetType="TextBlock">
                <Style.Setters>
                    <Setter Property="Margin" Value="1,30,0,6" />
                </Style.Setters>
            </Style>
        </FrameworkElement.Resources>
            <Grid>
                <ikw:SimpleStackPanel MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">
                
                    <!-- 启动设置 -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:NavStrings.Nav_Startup}" />
                
                    <!-- 开机时运行 -->
                    <controls:LabeledSettingsCard x:Name="CardRunAtStartup"
                            Header="{x:Static props:StartupStrings.RunAtStartup}"
                            Description="{x:Static props:StartupStrings.RunAtStartupHint}"
                            Icon="{x:Static ui:SegoeFluentIcons.Settings}"
                            SwitchName="ToggleSwitchRunAtStartup"
                            Toggled="ToggleSwitchRunAtStartup_Toggled" />
                
                    <!-- 开机运行后收纳到侧边栏 -->
                    <controls:LabeledSettingsCard x:Name="CardFoldAtStartup"
                            Header="{x:Static props:StartupStrings.FoldAtStartup}"
                            Description="{x:Static props:StartupStrings.FoldAtStartupHint}"
                            Icon="{x:Static ui:SegoeFluentIcons.ChevronLeft}"
                            SwitchName="ToggleSwitchFoldAtStartup"
                            Toggled="ToggleSwitchFoldAtStartup_Toggled" />

                    <!-- 外部协议调用 -->
                    <controls:LabeledSettingsCard x:Name="CardExternalProtocol"
                            Header="{x:Static props:StartupStrings.ExternalProtocol}"
                            Description="{x:Static props:StartupStrings.ExternalProtocolHint}"
                            Icon="{x:Static ui:SegoeFluentIcons.Link}"
                            SwitchName="ToggleSwitchExternalProtocol"
                            Toggled="ToggleSwitchExternalProtocol_Toggled" />

                    <!-- 运行模式 -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:NavStrings.Settings_ModeDesc_1}" />

                    <controls:LabeledSettingsCard x:Name="CardPPTOnlyMode"
                            Header="{x:Static props:CommonStrings.Mode_PPTOnly}"
                            Description="{x:Static props:NavStrings.Settings_ModeDesc}"
                            Icon="{x:Static ui:SegoeFluentIcons.Settings}"
                            SwitchName="ToggleSwitchPPTOnlyMode"
                            Toggled="ToggleSwitchPPTOnlyMode_Toggled" />

                    <!-- 笔尖模式 -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:StartupStrings.EnableNibMode}" />

                    <controls:LabeledSettingsCard x:Name="CardEnableNibMode"
                            Header="{x:Static props:StartupStrings.EnableNibMode}"
                            Description="{x:Static props:StartupStrings.EnableNibModeHint}"
                            Icon="{x:Static ui:SegoeFluentIcons.TouchPointer}"
                            SwitchName="ToggleSwitchEnableNibMode"
                            Toggled="ToggleSwitchEnableNibMode_Toggled" />

                    <!-- 崩溃后操作 -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:CrashStrings.Crash_Title}" />

                    <ui:SettingsCard Header="{x:Static props:CrashStrings.Crash_Title}"
                            Description="{x:Static props:CrashStrings.Crash_Desc}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Warning}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxCrashAction"
                                  SelectionChanged="ComboBoxCrashAction_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:CrashStrings.Crash_SilentRestart}" Tag="0" />
                            <ComboBoxItem Content="{x:Static props:CrashStrings.Crash_NoAction}" Tag="1" />
                            <ComboBoxItem Content="{x:Static props:CrashStrings.Crash_ShowCrashWindow}" Tag="2" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <!-- 底部空白 -->
                    <Rectangle Height="48" />
                
                </ikw:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</ui:Page>
