<Window x:Class="Ink_Canvas.Windows.SettingsViews.Pages.BoardToolbarInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Width="360" Height="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <StackPanel Margin="16">
        <TextBlock x:Name="LabelPrompt" Text="请输入：" FontSize="13" Margin="0,0,0,12"/>
        <TextBox x:Name="TextBoxInput" FontSize="13" Height="28"
                 KeyDown="TextBoxInput_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确定" Click="ButtonOK_Click" Padding="16,6" FontSize="12" Margin="0,0,8,0"/>
            <Button Content="取消" Click="ButtonCancel_Click" Padding="16,6" FontSize="12"/>
        </StackPanel>
    </StackPanel>
</Window>
