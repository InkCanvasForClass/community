<ui:Page x:Class="Ink_Canvas.Windows.SettingsViews.Pages.AutomationWorkflowPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:converters="clr-namespace:Ink_Canvas.Converter"
      mc:Ignorable="d"
      Title="自定义自动化">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="220" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：工作流列表 -->
        <Grid Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题和添加按钮 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="自定义自动化" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4"/>
                <TextBlock Text="创建自定义的触发器→条件→行动规则" Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
                <Button x:Name="BtnAddWorkflow" Content="+ 添加自动化" Margin="0,8,0,0"
                        Click="BtnAddWorkflow_Click" HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- 工作流列表 -->
            <ListBox Grid.Row="1" x:Name="WorkflowListBox"
                     SelectionChanged="WorkflowListBox_SelectionChanged"
                     DisplayMemberPath="ActionSet.Name"
                     HorizontalContentAlignment="Stretch" />

            <!-- 底部操作 -->
            <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnDeleteWorkflow" Content="删除" Click="BtnDeleteWorkflow_Click" Margin="0,0,4,0" Opacity="0.7" />
                <Button x:Name="BtnDuplicateWorkflow" Content="复制" Click="BtnDuplicateWorkflow_Click" Opacity="0.7" />
            </StackPanel>
        </Grid>

        <!-- 分割线 -->
        <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

        <!-- 右侧：编辑区域 -->
        <Grid Grid.Column="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8">
                <!-- 编辑面板 -->
                <StackPanel x:Name="EditorPanel" Visibility="Collapsed">

                <!-- 名称 -->
                <TextBlock Text="名称" Margin="0,0,0,4" FontWeight="Medium" />
                <TextBox x:Name="TextBoxWorkflowName" Margin="0,0,0,16" />

                <!-- 启用开关 -->
                <ui:SettingsCard Header="启用此自动化" Margin="0,0,0,8">
                    <ui:ToggleSwitch x:Name="ToggleIsEnabled" />
                </ui:SettingsCard>

                <!-- 启用恢复 -->
                <ui:SettingsCard Header="启用自动恢复" Description="当触发条件不再满足时自动恢复行动" Margin="0,0,0,16">
                    <ui:ToggleSwitch x:Name="ToggleIsRevertEnabled" />
                </ui:SettingsCard>

                <!-- 触发器编辑 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Important}" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="当以下事件触发时" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl x:Name="TriggersItemsControl" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            CornerRadius="4" Padding="8" Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding AssociatedTriggerInfo.Name}" VerticalAlignment="Center" />
                                            <Button Content="✕" Margin="8,0,0,0" Padding="4,0"
                                                    Click="BtnRemoveTrigger_Click" Tag="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="添加触发器" Margin="0,0,0,4" FontWeight="Medium" FontSize="12" />
                        <ComboBox x:Name="ComboBoxTriggerType" Margin="0,0,0,4" />
                        <Button x:Name="BtnAddTrigger" Content="添加触发器" Click="BtnAddTrigger_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- 条件编辑 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:ToggleSwitch x:Name="ToggleIsConditionEnabled" Margin="0,0,8,0" />
                            <TextBlock Text="并且满足以下条件时" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="ConditionDisabledHint" Text="工作流运行时不会考虑条件。" Opacity="0.5" />
                        <StackPanel x:Name="ConditionEditorPanel">
                            <ItemsControl x:Name="RulesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                CornerRadius="4" Padding="8" Margin="0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center">
                                                    <Run Text="规则: " /><Run Text="{Binding Id, Mode=OneWay}" />
                                                </TextBlock>
                                                <Button Content="✕" Margin="8,0,0,0" Padding="4,0"
                                                        Click="BtnRemoveRule_Click" Tag="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="添加条件" Margin="0,4,0,4" FontWeight="Medium" FontSize="12" />
                            <ComboBox x:Name="ComboBoxRuleType" Margin="0,0,0,4" />
                            <Button x:Name="BtnAddRule" Content="添加条件" Click="BtnAddRule_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 行动编辑 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Play}" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="触发行动" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl x:Name="ActionsItemsControl" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            CornerRadius="4" Padding="8" Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding Id, Mode=OneWay}" />
                                            </TextBlock>
                                            <Button Content="✕" Margin="8,0,0,0" Padding="4,0"
                                                    Click="BtnRemoveAction_Click" Tag="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="添加行动" Margin="0,0,0,4" FontWeight="Medium" FontSize="12" />
                        <ComboBox x:Name="ComboBoxActionType" Margin="0,0,0,4" />
                        <Button x:Name="BtnAddAction" Content="添加行动" Click="BtnAddAction_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- 恢复提示 -->
                <StackPanel x:Name="RevertHintPanel" Orientation="Horizontal" Margin="0,0,0,16" Opacity="0.6">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Back}" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="当触发条件不再满足时，将自动恢复行动。" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- 未选择时的占位 -->
        <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Visible">
            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Page}" FontSize="48" Opacity="0.3" />
            <TextBlock Text="在左侧选择或添加一个自动化" Opacity="0.5" Margin="0,8,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Grid>
</ui:Page>
