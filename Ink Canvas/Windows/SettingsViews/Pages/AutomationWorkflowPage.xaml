            </ScrollViewer>

            <!-- ========== 工作流编辑器面板 ========== -->
            <ScrollViewer x:Name="WorkflowEditorPanel" Visibility="Collapsed" Padding="16,8">
                <StackPanel DataContext="{Binding SelectedWorkflow, Mode=OneWay}">
                    <!-- 禁用时整体半透明 -->
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActionSet.IsEnabled}" Value="False">
                                    <Setter Property="Opacity" Value="0.56" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- ===== 顶部：名称 + 选项 ===== -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="名称" FontWeight="Medium" Margin="0,0,0,4" />
                                <TextBox x:Name="TextBoxWorkflowName" Padding="8,6" MinWidth="200" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                                <CheckBox x:Name="CheckBoxIsRevertEnabled" Content="启用恢复" Margin="0,0,0,8" Checked="CheckBoxIsRevertEnabled_Changed" Unchecked="CheckBoxIsRevertEnabled_Changed" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnInvokeAction" Content="触发" Padding="12,4" Margin="0,0,8,0" Click="BtnInvokeAction_Click" />
                                    <Button x:Name="BtnRevertAction" Content="恢复" Padding="12,4" Click="BtnRevertAction_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ===== 触发器编辑区 ===== -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- 标题 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Important24" FontSize="16" Margin="0,0,8,0" />
                                <TextBlock Text="当以下事件触发时" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 触发器列表 -->
                            <ItemsControl x:Name="TriggersItemsControl" Margin="0,0,0,8" dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" touch:TouchAwareDragDropHelper.IsEnabled="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="8" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 拖动按钮 -->
                                                <Border Grid.Column="0" touch:TouchAwareDragDropHelper.IsGripHandle="True" Background="Transparent" Padding="2,4" Margin="0,0,4,0" Cursor="SizeAll">
                                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Opacity="0.45" />
                                                </Border>

                                                <!-- 删除按钮 -->
                                                <Button Grid.Column="1" Content="✕" Padding="4,0" Margin="0,0,8,0" Click="BtnRemoveTrigger_Click" Tag="{Binding}" ToolTip="删除" />

                                                <!-- 触发器类型选择 -->
                                                <ComboBox Grid.Column="2" ItemsSource="{x:Static local:AutomationWorkflowPage.RegisteredTriggersList}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Id, Mode=TwoWay}" SelectionChanged="ComboBoxTriggerType_SelectionChanged" Tag="{Binding}" Padding="8,6" MinWidth="150" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 添加触发器 -->
                            <Button Content="添加触发器" Click="BtnAddTrigger_Click" Padding="12,6" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- ===== 条件编辑区（规则集） ===== -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- 标题 + 启用开关 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:ToggleSwitch x:Name="ToggleIsConditionEnabled" Margin="0,0,8,0" Checked="ToggleIsConditionEnabled_Toggled" Unchecked="ToggleIsConditionEnabled_Toggled" />
                                <ui:SymbolIcon Symbol="Tag24" FontSize="16" Margin="0,0,8,0" />
                                <TextBlock Text="并且满足以下条件时" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 条件禁用提示 -->
                            <TextBlock x:Name="ConditionDisabledHint" Text="工作流运行时不会考虑条件。" Opacity="0.5" Margin="0,0,0,8" />

                            <!-- 条件编辑面板 -->
                            <StackPanel x:Name="ConditionEditorPanel">
                                <!-- 规则集级别控制 -->
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ComboBox x:Name="ComboBoxRulesetMode" Padding="8,6" Margin="0,0,8,0" SelectionChanged="ComboBoxRulesetMode_SelectionChanged">
                                        <ComboBoxItem Content="当以下任意条件组满足时" />
                                        <ComboBoxItem Content="当以下所有条件组满足时" />
                                    </ComboBox>
                                    <CheckBox x:Name="CheckBoxRulesetReversed" Content="反转" Margin="0,0,8,0" VerticalAlignment="Center" Checked="CheckBoxRulesetReversed_Changed" Unchecked="CheckBoxRulesetReversed_Changed" />
                                    <Button Content="添加组" Padding="8,4" VerticalAlignment="Center" Click="BtnAddRuleGroup_Click" />
                                    <Ellipse x:Name="EllipseRulesetState" Width="10" Height="10" Margin="8,0,0,0" VerticalAlignment="Center" Fill="DarkGray" />
                                </WrapPanel>

                                <!-- 条件组列表 -->
                                <ItemsControl x:Name="RuleGroupsItemsControl" dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" touch:TouchAwareDragDropHelper.IsEnabled="True">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 拖动按钮 -->
                                                    <Border Grid.Column="0" touch:TouchAwareDragDropHelper.IsGripHandle="True" Background="Transparent" Padding="2,4" Margin="0,0,4,0" Cursor="SizeAll">
                                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Opacity="0.45" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1">
                                                    <!-- 条件组头部 -->
                                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <ComboBox Padding="8,6" Margin="0,0,8,0" SelectedIndex="{Binding Mode, Converter={StaticResource LogicalModeToIntConverter}, Mode=TwoWay}" SelectionChanged="ComboBoxGroupMode_SelectionChanged" Tag="{Binding}">
                                                            <ComboBoxItem Content="当以下任意条件满足时" />
                                                            <ComboBoxItem Content="当以下所有条件满足时" />
                                                        </ComboBox>
                                                        <CheckBox Content="反转" IsChecked="{Binding IsReversed}" Checked="CheckBoxGroupReversed_Changed" Unchecked="CheckBoxGroupReversed_Changed" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <Button Content="添加规则" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center" Click="BtnAddRuleToGroup_Click" Tag="{Binding}" />

                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <Ellipse Width="8" Height="8" Margin="0,0,4,0" Style="{StaticResource StateIndicatorStyle}" />
                                                            <ui:ToggleSwitch IsChecked="{Binding IsEnabled}" Checked="CheckBoxGroupEnabled_Toggled" Unchecked="CheckBoxGroupEnabled_Toggled" Width="44" Height="24" Margin="0,0,4,0" ToolTip="启用条件组" />
                                                            <Button Content="⧉" Padding="4,2" Margin="0,0,4,0" Click="BtnDuplicateGroup_Click" Tag="{Binding}" ToolTip="复制" />
                                                            <Button Content="✕" Padding="4,2" Click="BtnDeleteGroup_Click" Tag="{Binding}" ToolTip="删除" />
                                                        </StackPanel>
                                                    </WrapPanel>

                                                    <!-- 规则列表 -->
                                                    <ItemsControl ItemsSource="{Binding Rules}" Margin="4,0,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="220" />
                                                                            <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Grid.Column="0" Content="✕" FontSize="10" Click="BtnRemoveRule_Click" Padding="4,1" Margin="0,0,4,0" Tag="{Binding}" ToolTip="删除" />
                                                                    <Ellipse Grid.Column="1" Width="8" Height="8" Margin="0,0,4,0" VerticalAlignment="Center" Style="{StaticResource StateIndicatorStyle}" />
                                                                    <CheckBox Grid.Column="2" Content="反转" IsChecked="{Binding IsReversed}" Checked="CheckBoxRuleReversed_Changed" Unchecked="CheckBoxRuleReversed_Changed" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                    <ComboBox Grid.Column="3" ItemsSource="{x:Static local:AutomationWorkflowPage.RegisteredRulesList}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Id, Mode=TwoWay}" SelectionChanged="ComboBoxRuleType_SelectionChanged" Tag="{Binding}" Padding="8,6" />
                                                                        <local:AutomationSettingsPresenter Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center" Item="{Binding}" SettingsChanged="RuleSettingsPresenter_SettingsChanged" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== 行动编辑区 ===== -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- 标题 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Play24" FontSize="16" Margin="0,0,8,0" />
                                <TextBlock Text="触发行动" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 行动列表 -->
                            <ItemsControl x:Name="ActionsItemsControl" Margin="0,0,0,8" dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" touch:TouchAwareDragDropHelper.IsEnabled="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="8" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 拖动按钮 -->
                                                <Border Grid.Column="0" touch:TouchAwareDragDropHelper.IsGripHandle="True" Background="Transparent" Padding="2,4" Margin="0,0,4,0" Cursor="SizeAll">
                                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Opacity="0.45" />
                                                </Border>

                                                <!-- 删除按钮 -->
                                                <Button Grid.Column="1" Content="✕" Padding="4,0" Margin="0,0,8,0" Click="BtnRemoveAction_Click" Tag="{Binding}" ToolTip="删除" />

                                                <!-- 行动类型选择 -->
                                                <ComboBox Grid.Column="2" ItemsSource="{x:Static local:AutomationWorkflowPage.RegisteredActionsList}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Id, Mode=TwoWay}" SelectionChanged="ComboBoxActionType_SelectionChanged" Tag="{Binding}" Padding="8,6" MinWidth="150" VerticalAlignment="Center" />
                                                <local:AutomationSettingsPresenter Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" Item="{Binding}" SettingsChanged="ActionSettingsPresenter_SettingsChanged" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 添加行动 -->
                            <Button Content="添加行动" Click="BtnAddAction_Click" Padding="12,6" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- ===== 恢复提示 ===== -->
                    <StackPanel x:Name="RevertHintPanel" Orientation="Horizontal" Margin="0,0,0,16" Opacity="0.6">
                        <ui:SymbolIcon Symbol="Stop24" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="当规则不再满足时，将自动恢复行动。" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== 未选择工作流时的占位符 ========== -->
            <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Rename24" FontSize="48" HorizontalAlignment="Center" Opacity="0.4" />
                <TextBlock Text="在左侧选择或添加一个自动化，然后在此处进行设置。" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.6" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
