<?xml version="1.0" encoding="utf-8"?><Page x:Class="Ink_Canvas.Windows.SettingsViews.Pages.AutomationWorkflowPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend" xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta" xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls" xmlns:c="clr-namespace:Ink_Canvas.Converter" xmlns:props="clr-namespace:Ink_Canvas.Properties" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:dd="urn:gong-wpf-dragdrop" xmlns:touch="clr-namespace:Ink_Canvas.Helpers" mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200" Title="{x:Static props:AutomationStrings.Automation_Title}">

    <Page.Resources>
        <c:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <c:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
        <sys:Double x:Key="SettingsCardHeaderIconMaxSize">24</sys:Double>

        <Style TargetType="Ellipse" x:Key="StateIndicatorStyle">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State, Mode=OneWay}" Value="2">
                    <Setter Property="Fill" Value="Green" />
                    <Setter Property="ToolTip" Value="已满足" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State, Mode=OneWay}" Value="1">
                    <Setter Property="Fill" Value="IndianRed" />
                    <Setter Property="ToolTip" Value="不满足" />
                </DataTrigger>
            </Style.Triggers>
            <Setter Property="Fill" Value="DarkGray" />
            <Setter Property="ToolTip" Value="未知" />
        </Style>

        <local:RulesetLogicalModeToIntConverter x:Key="LogicalModeToIntConverter" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="220" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧：导航列表 ==================== -->
        <Grid Grid.Column="0" Margin="16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 添加按钮 -->
            <Button Grid.Row="0" x:Name="BtnAddWorkflow" Content="添加自动化" Click="BtnAddWorkflow_Click" Padding="12,6" Margin="0,0,0,8" HorizontalAlignment="Left" />

            <!-- 导航列表 -->
            <ui:ListView Grid.Row="1" x:Name="NavigationListBox" Background="Transparent" BorderThickness="0" SelectionChanged="NavigationListBox_SelectionChanged" HorizontalContentAlignment="Stretch" dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" touch:TouchAwareDragDropHelper.IsEnabled="True">
                <ui:ListView.Template>
                    <ControlTemplate TargetType="ui:ListView">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter HorizontalAlignment="Stretch" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ui:ListView.Template>
                <ui:ListView.ItemContainerStyle>
                    <Style TargetType="ui:ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="MinHeight" Value="36" />
                    </Style>
                </ui:ListView.ItemContainerStyle>
                <ui:ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ui:ListView.ItemsPanel>
                <!-- 预设自动化固定项 -->
                <ui:ListViewItem x:Name="NavPresetItem">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="预设自动化" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:ListViewItem>
                <!-- 工作流项通过 DataTemplate 渲染 -->
                <ui:ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" touch:TouchAwareDragDropHelper.IsGripHandle="True" Background="Transparent" Padding="2,4" Margin="0,0,4,0" Cursor="SizeAll">
                                <ui:SymbolIcon Symbol="Rename24" Width="16" Height="16" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding ActionSet.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:ToggleSwitch IsChecked="{Binding ActionSet.IsEnabled}" Checked="ToggleWorkflowEnabled_Toggled" Unchecked="ToggleWorkflowEnabled_Toggled" MinWidth="0" OnContent="" OffContent="" Margin="0,0,8,0" />
                                <Button Content="⧉" Click="BtnDuplicateWorkflow_Click" Padding="4,0" Tag="{Binding}" Margin="0,0,4,0" ToolTip="复制" />
                                <Button Content="✕" Click="BtnRemoveWorkflow_Click" Padding="4,0" Tag="{Binding}" ToolTip="删除" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>
        </Grid>

        <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

        <!-- ==================== 右侧：内容区域 ==================== -->
        <Grid Grid.Column="2">

            <!-- ========== 预设自动化面板 ========== -->
            <ScrollViewer x:Name="PresetPanel" PanningMode="VerticalFirst">
                <Grid Margin="20,0,20,0">
                    <FrameworkElement.Resources>
                        <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                        <sys:Double x:Key="SettingsCardHeaderIconMaxSize">24</sys:Double>
                        <c:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                        <Style TargetType="TextBlock" x:Key="SettingsSectionHeaderTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                            <Style.Setters>
                                <Setter Property="Margin" Value="1,30,0,6" />
                            </Style.Setters>
                        </Style>
                    </FrameworkElement.Resources>
                    <Grid>
                        <vio:SimpleStackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">

                            <TextBlock Text="{x:Static props:AutomationStrings.Automation_AutoFoldTitle}" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                            <ui:CardExpander IsExpanded="True" ContentPadding="0">
                                <ui:CardExpander.Header>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Text="{x:Static props:AutomationStrings.AutoFold_Group_Seewo}" Grid.Row="0" Grid.Column="0" FontTypography="Body" />
                                    </Grid>
                                </ui:CardExpander.Header>
                                <ui:CardExpander.Icon>
                                    <ui:ImageIcon Source="/Resources/Icons-png/EasiNote.png" />
                                </ui:CardExpander.Icon>
                                <StackPanel>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.AutoFold_App_SeewoBoard5}" Style="{StaticResource SettingsExpanderFirstRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/EasiNote.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInEasiNote" Checked="ToggleSwitchAutoFoldInEasiNote_Toggled" Unchecked="ToggleSwitchAutoFoldInEasiNote_Toggled" />
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.AutoFold_App_SeewoCamera}" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/EasiCamera.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInEasiCamera" Checked="ToggleSwitchAutoFoldInEasiCamera_Toggled" Unchecked="ToggleSwitchAutoFoldInEasiCamera_Toggled" />
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.AutoFold_App_SeewoBoard3}" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/EasiNote3.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInEasiNote3" Checked="ToggleSwitchAutoFoldInEasiNote3_Toggled" Unchecked="ToggleSwitchAutoFoldInEasiNote3_Toggled" />
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.AutoFold_App_SeewoLightBoard}" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/EasiNote3C.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInEasiNote3C" Checked="ToggleSwitchAutoFoldInEasiNote3C_Toggled" Unchecked="ToggleSwitchAutoFoldInEasiNote3C_Toggled" />
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.AutoFold_App_SeewoLightBoard5C}" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/EasiNote5C.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInEasiNote5C" Checked="ToggleSwitchAutoFoldInEasiNote5C_Toggled" Unchecked="ToggleSwitchAutoFoldInEasiNote5C_Toggled" />
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.FloatingInterceptor_App_SeewoPinco}" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/SeewoPinco.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInSeewoPincoTeacher" Checked="ToggleSwitchAutoFoldInSeewoPincoTeacher_Toggled" Unchecked="ToggleSwitchAutoFoldInSeewoPincoTeacher_Toggled" />
                                    </ui:CardControl>
                                </StackPanel>
                            </ui:CardExpander>

                            <ui:CardExpander IsExpanded="True" ContentPadding="0">
                                <ui:CardExpander.Header>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Text="{x:Static props:AutomationStrings.AutoFold_Group_Hite}" Grid.Row="0" Grid.Column="0" FontTypography="Body" />
                                    </Grid>
                                </ui:CardExpander.Header>
                                <ui:CardExpander.Icon><ui:SymbolIcon Symbol="Edit24" /></ui:CardExpander.Icon>
                                <StackPanel>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.AutoFold_App_HiteBoard}" Style="{StaticResource SettingsExpanderFirstRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/HiteBoard.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInHiteTouchPro" Checked="ToggleSwitchAutoFoldInHiteTouchPro_Toggled" Unchecked="ToggleSwitchAutoFoldInHiteTouchPro_Toggled" />
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.AutoFold_App_HiteCamera}" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/HiteCamera.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInHiteCamera" Checked="ToggleSwitchAutoFoldInHiteCamera_Toggled" Unchecked="ToggleSwitchAutoFoldInHiteCamera_Toggled" />
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.AutoFold_App_HiteLightBoard}" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/HiteLightBoard.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInHiteLightBoard" Checked="ToggleSwitchAutoFoldInHiteLightBoard_Toggled" Unchecked="ToggleSwitchAutoFoldInHiteLightBoard_Toggled" />
                                    </ui:CardControl>
                                </StackPanel>
                            </ui:CardExpander>

                            <ui:CardExpander IsExpanded="True" ContentPadding="0">
                                <ui:CardExpander.Header>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Text="{x:Static props:AutomationStrings.AutoFold_Group_Other}" Grid.Row="0" Grid.Column="0" FontTypography="Body" />
                                    </Grid>
                                </ui:CardExpander.Header>
                                <ui:CardExpander.Icon><ui:SymbolIcon Symbol="Edit24" /></ui:CardExpander.Icon>
                                <StackPanel>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.AutoFold_App_WenXiangBoard}" Style="{StaticResource SettingsExpanderFirstRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/WenXiang.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInWxBoardMain" Checked="ToggleSwitchAutoFoldInWxBoardMain_Toggled" Unchecked="ToggleSwitchAutoFoldInWxBoardMain_Toggled" />
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.AutoFold_App_MSWhiteboard}" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/Whiteboard.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInMSWhiteboard" Checked="ToggleSwitchAutoFoldInMSWhiteboard_Toggled" Unchecked="ToggleSwitchAutoFoldInMSWhiteboard_Toggled" />
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.AutoFold_App_AdmoxBoard}" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/AdmoxWhiteboard.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInAdmoxWhiteboard" Checked="ToggleSwitchAutoFoldInAdmoxWhiteboard_Toggled" Unchecked="ToggleSwitchAutoFoldInAdmoxWhiteboard_Toggled" />
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.AutoFold_App_AdmoxBooth}" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/AdmoxBooth.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInAdmoxBooth" Checked="ToggleSwitchAutoFoldInAdmoxBooth_Toggled" Unchecked="ToggleSwitchAutoFoldInAdmoxBooth_Toggled" />
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.AutoFold_App_YiYunBoard}" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/YiYunWhiteboard.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInQPoint" Checked="ToggleSwitchAutoFoldInQPoint_Toggled" Unchecked="ToggleSwitchAutoFoldInQPoint_Toggled" />
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.AutoFold_App_YiYunBooth}" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/YiYunVisualPresenter.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInYiYunVisualPresenter" Checked="ToggleSwitchAutoFoldInYiYunVisualPresenter_Toggled" Unchecked="ToggleSwitchAutoFoldInYiYunVisualPresenter_Toggled" />
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.AutoFold_App_MaxHubBoard}" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/MaxHubWhiteboard.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInMaxHubWhiteboard" Checked="ToggleSwitchAutoFoldInMaxHubWhiteboard_Toggled" Unchecked="ToggleSwitchAutoFoldInMaxHubWhiteboard_Toggled" />
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:AutomationStrings.AutoFold_OldZyBoard}" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon><ui:ImageIcon Source="/Resources/Icons-png/Donview.png" /></ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="CardAutoFoldInOldZyBoard" Checked="ToggleSwitchAutoFoldInOldZyBoard_Toggled" Unchecked="ToggleSwitchAutoFoldInOldZyBoard_Toggled" />
                                    </ui:CardControl>
                                </StackPanel>
                            </ui:CardExpander>

                            <controls:LabeledSettingsCard x:Name="CardAutoFoldInPPTSlideShow" Header="{x:Static props:AutomationStrings.Automation_AutoFoldInPPT}" Toggled="ToggleSwitchAutoFoldInPPTSlideShow_Toggled">
                                <controls:LabeledSettingsCard.HeaderIcon>
                                    <ui:ImageIcon Source="/Resources/Icons-png/PowerPoint.png" />
                                </controls:LabeledSettingsCard.HeaderIcon>
                            </controls:LabeledSettingsCard>

                            <controls:LabeledSettingsCard x:Name="CardAutoFoldWhenExitWhiteboard" Header="{x:Static props:AutomationStrings.FoldMode_AutoFoldAfterWhiteboard}" Description="{x:Static props:AutomationStrings.FoldMode_AutoFoldAfterWhiteboardHint}" Symbol="ArrowLeft24" Toggled="ToggleSwitchAutoFoldWhenExitWhiteboard_Toggled" />

                            <controls:LabeledSettingsCard x:Name="CardAutoFoldAfterPPTSlideShow" Header="{x:Static props:AutomationStrings.FoldMode_AutoFoldAfterPPT}" Description="{x:Static props:AutomationStrings.FoldMode_AutoFoldAfterPPTHint}" IconSource="/Resources/Icons-png/PPTTools.png" Toggled="ToggleSwitchAutoFoldAfterPPTSlideShow_Toggled" />

                            <controls:LabeledSettingsCard x:Name="CardKeepFoldAfterSoftwareExit" Header="{x:Static props:AutomationStrings.Automation_KeepFoldAfterExit}" Description="{x:Static props:AutomationStrings.Automation_KeepFoldAfterExitHint}" Symbol="Pin24" Toggled="ToggleSwitchKeepFoldAfterSoftwareExit_Toggled" />

                            <TextBlock Text="{x:Static props:AutomationStrings.AutoKill_Title}" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                            <controls:LabeledSettingsCard x:Name="CardAutoKillPPTService" Header="{x:Static props:AutomationStrings.AutoKill_PPTTools}" Description="{x:Static props:AutomationStrings.AutoKill_PPTToolsHint}" IconSource="/Resources/Icons-png/PPTTools.png" Toggled="ToggleSwitchAutoKillPPTService_Toggled" />

                            <controls:LabeledSettingsCard x:Name="CardAutoKillEasiNote" Header="{x:Static props:AutomationStrings.AutoKill_EasiNote5}" IconSource="/Resources/Icons-png/EasiNote.png" Toggled="ToggleSwitchAutoKillEasiNote_Toggled" />

                            <controls:LabeledSettingsCard x:Name="CardAutoKillHiteAnnotation" Header="{x:Static props:AutomationStrings.AutoKill_HiteAnnotation}" IconSource="/Resources/Icons-png/HiteAnnotation.png" Toggled="ToggleSwitchAutoKillHiteAnnotation_Toggled" />

                            <controls:LabeledSettingsCard x:Name="CardAutoKillVComYouJiao" Header="{x:Static props:AutomationStrings.AutoKill_YouJiao}" IconSource="/Resources/Icons-png/VComYouJiao.png" Toggled="ToggleSwitchAutoKillVComYouJiao_Toggled" />

                            <controls:LabeledSettingsCard x:Name="CardAutoKillSeewoLauncher2DesktopAnnotation" Header="{x:Static props:AutomationStrings.AutoKill_SeewoDesktop2Anno}" Description="{x:Static props:AutomationStrings.AutoKill_SeewoDesktop2AnnoHint}" IconSource="/Resources/Icons-png/Seewo2Annotation.png" Toggled="ToggleSwitchAutoKillSeewoLauncher2DesktopAnnotation_Toggled" />

                            <controls:LabeledSettingsCard x:Name="CardAutoKillInkCanvas" Header="{x:Static props:AutomationStrings.AutoKill_InkCanvasIC}" IconSource="/Resources/Icons-png/InkCanvas.png" Toggled="ToggleSwitchAutoKillInkCanvas_Toggled" />

                            <controls:LabeledSettingsCard x:Name="CardAutoKillICA" Header="{x:Static props:AutomationStrings.AutoKill_ICA}" IconSource="/Resources/Icons-png/ICA.png" Toggled="ToggleSwitchAutoKillICA_Toggled" />

                            <controls:LabeledSettingsCard x:Name="CardAutoKillIDT" Header="{x:Static props:AutomationStrings.AutoKill_Inkeys}" IconSource="/Resources/Icons-png/idt.png" Toggled="ToggleSwitchAutoKillIDT_Toggled" />

                            <TextBlock Text="{x:Static props:AutomationStrings.AutoFold_Mode}" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                            <controls:LabeledSettingsCard x:Name="CardAutoEnterAnnotationModeWhenExitFoldMode" Header="{x:Static props:AutomationStrings.FoldMode_ExitToAnnotation}" Description="{x:Static props:AutomationStrings.FoldMode_ExitToAnnotationHint}" Symbol="Edit24" Toggled="ToggleSwitchAutoEnterAnnotationModeWhenExitFoldMode_Toggled" />

                            <controls:LabeledSettingsCard x:Name="CardAutoEnterAnnotationAfterKillHite" Header="{x:Static props:AutomationStrings.AutoKill_HiteAfterKillEnterAnnotation}" IconSource="/Resources/Icons-png/HiteAnnotation.png" Toggled="ToggleSwitchAutoEnterAnnotationAfterKillHite_Toggled" />

                            <TextBlock Text="{x:Static props:StorageStrings.AutoSave_Title}" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                            <ui:CardExpander IsExpanded="{Binding IsChecked, ElementName=ToggleSwitchSaveScreenshotsInDateFolders, Mode=OneWay}" ContentPadding="0">
                                <ui:CardExpander.Header>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Text="{x:Static props:StorageStrings.Storage_ScreenshotSettings}" Grid.Row="0" Grid.Column="0" FontTypography="Body" />
                                        <ui:TextBlock Text="{x:Static props:StorageStrings.Storage_ScreenshotSettingsDesc}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Grid.Row="1" Grid.Column="0" />
                                        <ui:ToggleSwitch x:Name="ToggleSwitchSaveScreenshotsInDateFolders" d:IsOn="True" Checked="ToggleSwitchSaveScreenshotsInDateFolders_Toggled" Unchecked="ToggleSwitchSaveScreenshotsInDateFolders_Toggled" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    </Grid>
                                </ui:CardExpander.Header>
                                <ui:CardExpander.Icon>
                                    <ui:SymbolIcon Symbol="Camera24" />
                                </ui:CardExpander.Icon>
                                <StackPanel>
                                    <ui:CardControl Header="{x:Static props:StorageStrings.Storage_ScreenshotFormat}" Style="{StaticResource SettingsExpanderFirstRowStyle}">
                                        <ui:CardControl.Icon>
                                            <ui:SymbolIcon Symbol="Image24" />
                                        </ui:CardControl.Icon>
                                        <ComboBox x:Name="ComboBoxScreenshotFormat" SelectionChanged="ComboBoxScreenshotFormat_SelectionChanged">
                                            <ComboBoxItem Content="PNG" Tag="0" />
                                            <ComboBoxItem Content="JPG" Tag="1" />
                                        </ComboBox>
                                    </ui:CardControl>
                                    <ui:CardControl x:Name="CardScreenshotJpegQuality" Header="{x:Static props:StorageStrings.Storage_ScreenshotJpegQuality}" Visibility="Collapsed" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon>
                                            <ui:SymbolIcon Symbol="Crop24" />
                                        </ui:CardControl.Icon>
                                        <vio:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="ScreenshotJpegQualityText" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" />
                                            <Slider x:Name="ScreenshotJpegQualitySlider" Width="200" Minimum="50" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="None" ValueChanged="ScreenshotJpegQualitySlider_ValueChanged" />
                                        </vio:SimpleStackPanel>
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:StorageStrings.Storage_ScreenshotScale}" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon>
                                            <ui:SymbolIcon Symbol="ZoomIn24" />
                                        </ui:CardControl.Icon>
                                        <ComboBox x:Name="ComboBoxScreenshotScale" SelectionChanged="ComboBoxScreenshotScale_SelectionChanged">
                                            <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ScreenshotScale_100}" Tag="0" />
                                            <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ScreenshotScale_75}" Tag="1" />
                                            <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ScreenshotScale_50}" Tag="2" />
                                            <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ScreenshotScale_25}" Tag="3" />
                                        </ComboBox>
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:StorageStrings.Storage_AutoSaveInkOnScreenshot}" Style="{StaticResource SettingsExpanderRowStyle}">
                                        <ui:CardControl.Icon>
                                            <ui:SymbolIcon Symbol="Save24" />
                                        </ui:CardControl.Icon>
                                        <ui:ToggleSwitch x:Name="ToggleSwitchAutoSaveStrokesAtScreenshot" Checked="ToggleSwitchAutoSaveStrokesAtScreenshot_Toggled" Unchecked="ToggleSwitchAutoSaveStrokesAtScreenshot_Toggled" />
                                    </ui:CardControl>
                                    <ui:CardControl Header="{x:Static props:StorageStrings.Storage_AutoScreenshotOnClear}" Style="{StaticResource SettingsExpanderRowStyle}">
