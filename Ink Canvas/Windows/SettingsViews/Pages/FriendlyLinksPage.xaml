<Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.FriendlyLinksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
      xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d"
      Title="{x:Static props:FriendlyLinksStrings.FriendlyLinks_Title}">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                    BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                    TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>

            <vio:SimpleStackPanel MaxWidth="1000"
                HorizontalAlignment="Stretch"
                Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="{x:Static props:FriendlyLinksStrings.FriendlyLinks_SponsorSectionTitle}" />

                <controls:SettingsCard Header="CJK_mkp"
                    Description="{x:Static props:FriendlyLinksStrings.FriendlyLinks_CjikSponsorDescription}">
                    <controls:SettingsCard.Icon>
                        <ui:SymbolIcon Symbol="Heart24" />
                    </controls:SettingsCard.Icon>
                    <ui:HyperlinkButton Content="{x:Static props:FriendlyLinksStrings.FriendlyLinks_Sponsor}"
                        NavigateUri="https://www.ifdian.net/a/CJIK_mkp" />
                </controls:SettingsCard>

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="{x:Static props:FriendlyLinksStrings.FriendlyLinks_FriendsSectionTitle}" />

                <controls:SettingsCard Header="NamePicker"
                    Description="{x:Static props:FriendlyLinksStrings.FriendlyLinks_NamePickerDescription}">
                    <controls:SettingsCard.Icon>
                        <ui:SymbolIcon Symbol="Link24" />
                    </controls:SettingsCard.Icon>
                    <ui:HyperlinkButton Content="{x:Static props:FriendlyLinksStrings.FriendlyLinks_Visit}"
                        NavigateUri="https://github.com/NamePickerOrg/NamePicker" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="Inkeys"
                    Description="{x:Static props:FriendlyLinksStrings.FriendlyLinks_InkeysDescription}">
                    <controls:SettingsCard.Icon>
                        <ui:SymbolIcon Symbol="Link24" />
                    </controls:SettingsCard.Icon>
                    <ui:HyperlinkButton Content="{x:Static props:FriendlyLinksStrings.FriendlyLinks_Visit}"
                        NavigateUri="https://github.com/Alan-CRL/Inkeys/" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="开发者云平台"
                    Description="{x:Static props:FriendlyLinksStrings.FriendlyLinks_DeveloperCloudDescription}">
                    <controls:SettingsCard.Icon>
                        <ui:SymbolIcon Symbol="Link24" />
                    </controls:SettingsCard.Icon>
                    <ui:HyperlinkButton Content="{x:Static props:FriendlyLinksStrings.FriendlyLinks_Visit}"
                        NavigateUri="https://developer.dy.ci/" />
                </controls:SettingsCard>

                <Rectangle Height="48" />
            </vio:SimpleStackPanel>
        </Grid>
    </ScrollViewer>
</Page>
