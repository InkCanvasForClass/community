<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.PalmEraserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:helpers="clr-namespace:Ink_Canvas.Windows.SettingsViews.Helpers"
      mc:Ignorable="d"
      Title="{x:Static props:AdvancedStrings.PalmEraser_Title}">
    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                       BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                       TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>
            <Grid>
                <ikw:SimpleStackPanel MaxWidth="1000" HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:AdvancedStrings.PalmEraser_Title}" />

                    <ui:SettingsCard Header="{x:Static props:GestureStrings.Gesture_EnablePalmEraser}"
                                     Description="{x:Static props:AdvancedStrings.PalmEraser_EnableHint}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.EraseTool}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ui:ToggleSwitch x:Name="ToggleSwitchEnablePalmEraser"
                                         helpers:SettingsBinder.PropertyPath="Canvas.EnablePalmEraser"
                                         Toggled="ToggleSwitchEnablePalmEraser_Toggled" />
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:AdvancedStrings.TouchInput_PalmSizeTitle}"
                                     Description="{x:Static props:AdvancedStrings.TouchInput_PalmSizeHint}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="SliderPalmSize" Width="220"
                                    Minimum="0.5" Maximum="2.0"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ValueChanged="SliderPalmSize_ValueChanged" />
                            <TextBlock x:Name="TextPalmSize" Margin="12,0,0,0"
                                       VerticalAlignment="Center" MinWidth="52"
                                       Text="1.00×" />
                        </StackPanel>
                    </ui:SettingsCard>

                    <ui:InfoBar x:Name="BarCalibrationRequired"
                                IsClosable="False"
                                Severity="Warning"
                                Title="{x:Static props:AdvancedStrings.CalibrationTitle}"
                                Message="{x:Static props:AdvancedStrings.PalmEraser_CalibrationRequired}" />

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:AdvancedStrings.PalmEraser_CalibrationSection}" />

                    <ui:SettingsCard Header="{x:Static props:AdvancedStrings.CalibrationTitle}"
                                     Description="{x:Static props:AdvancedStrings.CalibrationDescription}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Touch}" />
                        </ui:SettingsCard.HeaderIcon>
                        <StackPanel MinWidth="260">
                            <TextBlock x:Name="TextCalibrateStatus" TextWrapping="Wrap"
                                       MaxWidth="320" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button x:Name="BtnStartCalibrate"
                                        Content="{x:Static props:AdvancedStrings.CalibrationStart}"
                                        Click="BtnStartCalibrate_Click" Margin="0,0,8,0" />
                                <Button x:Name="BtnClearCalibration"
                                        Content="{x:Static props:AdvancedStrings.CalibrationClear}"
                                        Click="ClearCalibration_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:SettingsCard>

                    <ui:InfoBar IsClosable="False"
                                IsOpen="True"
                                Severity="Informational"
                                Message="{x:Static props:AdvancedStrings.PalmEraser_GroupingHint}" />

                    <Rectangle Height="48" />
                </ikw:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</ui:Page>
