<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties"
    x:Class="Ink_Canvas.Windows.SettingsViews.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    Title="{x:Static props:NavStrings.Settings_Title}"
    mc:Ignorable="d">
    <ScrollViewer PanningMode="VerticalFirst">
        <Grid>
            <StackPanel Margin="24">
                <TextBlock Text="{x:Static props:NavStrings.Settings_Title}" Style="{DynamicResource TitleTextBlockStyle}" Margin="0,0,0,16" />
                <TextBlock Text="{x:Static props:NavStrings.Settings_Description}" Style="{DynamicResource BodyTextBlockStyle}" />
                <Rectangle Height="48" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</ui:Page>