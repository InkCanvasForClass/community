<UserControl x:Class="Ink_Canvas.Windows.TimerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:controls="clr-namespace:Ink_Canvas.Windows.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="900"
             ui:ThemeManager.IsThemeAware="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Controls/WinUI3CloseButton.xaml" />
                <ResourceDictionary Source="DigitResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="TimerAccentBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="TimerAccentPointerOverBrush" Color="#1D4ED8" />
            <SolidColorBrush x:Key="TimerAccentPressedBrush" Color="#1E40AF" />
            <SolidColorBrush x:Key="TimerDangerBrush" Color="#D13438" />

            <Style x:Key="ModernTimerCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource {x:Static ui:ThemeKeys.CardBackgroundFillColorDefaultBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.CardStrokeColorDefaultBrushKey}}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="ModernTimerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Static ui:ThemeKeys.DefaultButtonStyleKey}}">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="ModernTimerQuickButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Static ui:ThemeKeys.DefaultButtonStyleKey}}">
                <Setter Property="Width" Value="104" />
                <Setter Property="Height" Value="48" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="ModernTimerBottomButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Static ui:ThemeKeys.DefaultButtonStyleKey}}">
                <Setter Property="Width" Value="76" />
                <Setter Property="Height" Value="42" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="ModernTimerPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernTimerBottomButtonStyle}">
                <Setter Property="Background" Value="{StaticResource TimerAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TimerAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Style.Resources>
                    <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonBackgroundPointerOverKey}" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonBackgroundPressedKey}" Color="#1E40AF" />
                    <SolidColorBrush x:Key="{x:Static ui:ThemeKeys.ButtonForegroundKey}" Color="White" />
                </Style.Resources>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="MainBorder"
            Margin="8"
            CornerRadius="8"
            BorderThickness="1"
            Background="{DynamicResource {x:Static ui:ThemeKeys.AcrylicBackgroundFillColorDefaultBrushKey}}"
            BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.CardStrokeColorDefaultBrushKey}}"
            MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <Grid>
            <controls:WinUI3CloseButton x:Name="CloseButton"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Panel.ZIndex="10"
                                        Cursor="Hand"
                                        Click="CloseButton_Click"
                                        Content="x" />

            <Viewbox x:Name="MainViewController"
                     Margin="22,18,22,20"
                     StretchDirection="DownOnly"
                     MaxWidth="900"
                     MaxHeight="500">
                <Grid Width="900" Height="410">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="82" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="TitleBar"
                          Grid.Row="0"
                          Margin="0,0,104,0"
                          Background="Transparent"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Margin="4,0,0,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Width="36"
                                    Height="36"
                                    CornerRadius="8"
                                    Background="{DynamicResource {x:Static ui:ThemeKeys.LayerFillColorDefaultBrushKey}}"
                                    BorderBrush="{DynamicResource {x:Static ui:ThemeKeys.CardStrokeColorDefaultBrushKey}}"
                                    BorderThickness="1">
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Stopwatch}"
                                             FontSize="18"
                                             Foreground="{DynamicResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}" />
                            </Border>
                            <TextBlock x:Name="TitleText"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="计时"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="MainContentGrid"
                          Grid.Row="1"
                          Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="500" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="382" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource ModernTimerCardStyle}">
                            <Grid x:Name="MainDisplayGrid"
                                  Width="464"
                                  Height="246"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <StackPanel x:Name="DigitsPanel"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <StackPanel Width="46" Margin="0,0,10,0">
                                        <Button x:Name="Digit1PlusBtn" Style="{StaticResource ModernTimerIconButtonStyle}" Click="Digit1Plus_Click" ToolTipService.ToolTip="小时十位加一">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronUp}" FontSize="12" />
                                        </Button>
                                        <Path x:Name="Digit1Display" Data="{StaticResource Digit0}" Fill="{DynamicResource NewTimerWindowDigitForeground}" Width="38" Height="62" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,12" />
                                        <Button x:Name="Digit1MinusBtn" Style="{StaticResource ModernTimerIconButtonStyle}" Click="Digit1Minus_Click" ToolTipService.ToolTip="小时十位减一">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronDown}" FontSize="12" />
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Width="46" Margin="0,0,22,0">
                                        <Button x:Name="Digit2PlusBtn" Style="{StaticResource ModernTimerIconButtonStyle}" Click="Digit2Plus_Click" ToolTipService.ToolTip="小时个位加一">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronUp}" FontSize="12" />
                                        </Button>
                                        <Path x:Name="Digit2Display" Data="{StaticResource Digit0}" Fill="{DynamicResource NewTimerWindowDigitForeground}" Width="38" Height="62" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,12" />
                                        <Button x:Name="Digit2MinusBtn" Style="{StaticResource ModernTimerIconButtonStyle}" Click="Digit2Minus_Click" ToolTipService.ToolTip="小时个位减一">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronDown}" FontSize="12" />
                                        </Button>
                                    </StackPanel>

                                    <TextBlock x:Name="Colon1Display"
                                               Width="18"
                                               Margin="0,48,22,0"
                                               Text=":"
                                               FontSize="48"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource NewTimerWindowDigitForeground}" />

                                    <StackPanel Width="46" Margin="0,0,10,0">
                                        <Button x:Name="Digit3PlusBtn" Style="{StaticResource ModernTimerIconButtonStyle}" Click="Digit3Plus_Click" ToolTipService.ToolTip="分钟十位加一">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronUp}" FontSize="12" />
                                        </Button>
                                        <Path x:Name="Digit3Display" Data="{StaticResource Digit0}" Fill="{DynamicResource NewTimerWindowDigitForeground}" Width="38" Height="62" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,12" />
                                        <Button x:Name="Digit3MinusBtn" Style="{StaticResource ModernTimerIconButtonStyle}" Click="Digit3Minus_Click" ToolTipService.ToolTip="分钟十位减一">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronDown}" FontSize="12" />
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Width="46" Margin="0,0,22,0">
                                        <Button x:Name="Digit4PlusBtn" Style="{StaticResource ModernTimerIconButtonStyle}" Click="Digit4Plus_Click" ToolTipService.ToolTip="分钟个位加一">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronUp}" FontSize="12" />
                                        </Button>
                                        <Path x:Name="Digit4Display" Data="{StaticResource Digit0}" Fill="{DynamicResource NewTimerWindowDigitForeground}" Width="38" Height="62" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,12" />
                                        <Button x:Name="Digit4MinusBtn" Style="{StaticResource ModernTimerIconButtonStyle}" Click="Digit4Minus_Click" ToolTipService.ToolTip="分钟个位减一">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronDown}" FontSize="12" />
                                        </Button>
                                    </StackPanel>

                                    <TextBlock x:Name="Colon2Display"
                                               Width="18"
                                               Margin="0,48,22,0"
                                               Text=":"
                                               FontSize="48"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource NewTimerWindowDigitForeground}" />

                                    <StackPanel Width="46" Margin="0,0,10,0">
                                        <Button x:Name="Digit5PlusBtn" Style="{StaticResource ModernTimerIconButtonStyle}" Click="Digit5Plus_Click" ToolTipService.ToolTip="秒十位加一">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronUp}" FontSize="12" />
                                        </Button>
                                        <Path x:Name="Digit5Display" Data="{StaticResource Digit0}" Fill="{DynamicResource NewTimerWindowDigitForeground}" Width="38" Height="62" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,12" />
                                        <Button x:Name="Digit5MinusBtn" Style="{StaticResource ModernTimerIconButtonStyle}" Click="Digit5Minus_Click" ToolTipService.ToolTip="秒十位减一">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronDown}" FontSize="12" />
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Width="46">
                                        <Button x:Name="Digit6PlusBtn" Style="{StaticResource ModernTimerIconButtonStyle}" Click="Digit6Plus_Click" ToolTipService.ToolTip="秒个位加一">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronUp}" FontSize="12" />
                                        </Button>
                                        <Path x:Name="Digit6Display" Data="{StaticResource Digit0}" Fill="{DynamicResource NewTimerWindowDigitForeground}" Width="38" Height="62" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,12" />
                                        <Button x:Name="Digit6MinusBtn" Style="{StaticResource ModernTimerIconButtonStyle}" Click="Digit6Minus_Click" ToolTipService.ToolTip="秒个位减一">
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronDown}" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2" x:Name="QuickOptionsGrid">
                            <Border Style="{StaticResource ModernTimerCardStyle}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TabControl x:Name="TimerQuickTabControl"
                                            Width="368"
                                            HorizontalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="14"
                                            Style="{StaticResource {x:Static ui:ThemeKeys.TabControlPivotStyleKey}}"
                                            SelectionChanged="TimerQuickTabControl_SelectionChanged">
                                    <TabItem Header="常用">
                                        <Grid x:Name="CommonTimersGrid" Margin="0,12,0,0">
                                            <UniformGrid Rows="2" Columns="3" Margin="2,0,2,0">
                                                <Button x:Name="Common5MinBtn" Style="{StaticResource ModernTimerQuickButtonStyle}" Margin="0,0,10,8" Click="Common5Min_Click">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Path Data="M10 15h2a1.5 1.5 0 0 0 0 -3h-2v-3h3.5 M3 12v.01 M21 12v.01 M12 21v.01 M7.5 4.2v.01 M16.5 19.8v.01 M7.5 19.8v.01 M4.2 16.5v.01 M19.8 16.5v.01 M19.8 7.5v.01 M4.2 7.5v.01 M16.5 4.206a9.042 9.042 0 0 0 -4.5 -1.206" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="19" Height="19" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="5 分钟" VerticalAlignment="Center" FontWeight="Medium" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="Common10MinBtn" Style="{StaticResource ModernTimerQuickButtonStyle}" Margin="0,0,10,8" Click="Common10Min_Click">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Path Data="M9 9v6 M12 11v2a2 2 0 1 0 4 0v-2a2 2 0 1 0 -4 0z M3 12v.01 M21 12v.01 M12 21v.01 M7.5 4.2v.01 M16.5 19.8v.01 M7.5 19.8v.01 M4.2 16.5v.01 M19.8 16.5v.01 M4.2 7.5v.01 M19.81 7.527a8.994 8.994 0 0 0 -7.81 -4.527" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="19" Height="19" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="10 分钟" VerticalAlignment="Center" FontWeight="Medium" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="Common15MinBtn" Style="{StaticResource ModernTimerQuickButtonStyle}" Margin="0,0,0,8" Click="Common15Min_Click">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Path Data="M12 15h2a1 1 0 0 0 1 -1v-1a1 1 0 0 0 -1 -1h-2v-3h3 M9 9v6 M3 12v.01 M12 21v.01 M7.5 4.2v.01 M16.5 19.8v.01 M7.5 19.8v.01 M4.2 16.5v.01 M19.8 16.5v.01 M4.2 7.5v.01 M21 12a9 9 0 0 0 -9 -9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="19" Height="19" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="15 分钟" VerticalAlignment="Center" FontWeight="Medium" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="Common30MinBtn" Style="{StaticResource ModernTimerQuickButtonStyle}" Margin="0,0,10,0" Click="Common30Min_Click">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Path Data="M14 10.5v3a1.5 1.5 0 0 0 3 0v-3a1.5 1.5 0 0 0 -3 0z M8 9h1.5a1.5 1.5 0 0 1 0 3h-.5h.5a1.5 1.5 0 0 1 0 3h-1.5 M3 12v.01 M7.5 4.2v.01 M7.5 19.8v.01 M4.2 16.5v.01 M4.2 7.5v.01 M12 21a9 9 0 0 0 0 -18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="19" Height="19" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="30 分钟" VerticalAlignment="Center" FontWeight="Medium" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="Common45MinBtn" Style="{StaticResource ModernTimerQuickButtonStyle}" Margin="0,0,10,0" Click="Common45Min_Click">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Path Data="M13 15h2a1 1 0 0 0 1 -1v-1a1 1 0 0 0 -1 -1h-2v-3h3 M7 9v2a1 1 0 0 0 1 1h1 M10 9v6 M7.5 4.2v.01 M4.2 7.5v.01 M3 12a9 9 0 1 0 9 -9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="19" Height="19" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="45 分钟" VerticalAlignment="Center" FontWeight="Medium" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="Common60MinBtn" Style="{StaticResource ModernTimerQuickButtonStyle}" Click="Common60Min_Click">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Path Data="M14 10.5v3a1.5 1.5 0 0 0 3 0v-3a1.5 1.5 0 0 0 -3 0z M11 9h-2a1 1 0 0 0 -1 1v4a1 1 0 0 0 1 1h1a1 1 0 0 0 1 -1v-1a1 1 0 0 0 -1 -1h-2 M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="19" Height="19" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="60 分钟" VerticalAlignment="Center" FontWeight="Medium" />
                                                    </StackPanel>
                                                </Button>
                                            </UniformGrid>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="最近">
                                        <Grid x:Name="RecentTimersGrid" Margin="0,12,0,0">
                                            <UniformGrid Rows="2" Columns="3" Margin="2,0,2,0">
                                                <Button x:Name="RecentTimer1Btn" Style="{StaticResource ModernTimerQuickButtonStyle}" Margin="0,0,8,8" Click="RecentTimer1_Click"><TextBlock x:Name="RecentTimer1Text" Text="--:--" /></Button>
                                                <Button x:Name="RecentTimer2Btn" Style="{StaticResource ModernTimerQuickButtonStyle}" Margin="0,0,8,8" Click="RecentTimer2_Click"><TextBlock x:Name="RecentTimer2Text" Text="--:--" /></Button>
                                                <Button x:Name="RecentTimer3Btn" Style="{StaticResource ModernTimerQuickButtonStyle}" Margin="0,0,0,8" Click="RecentTimer3_Click"><TextBlock x:Name="RecentTimer3Text" Text="--:--" /></Button>
                                                <Button x:Name="RecentTimer4Btn" Style="{StaticResource ModernTimerQuickButtonStyle}" Margin="0,0,8,0" Click="RecentTimer4_Click"><TextBlock x:Name="RecentTimer4Text" Text="--:--" /></Button>
                                                <Button x:Name="RecentTimer5Btn" Style="{StaticResource ModernTimerQuickButtonStyle}" Margin="0,0,8,0" Click="RecentTimer5_Click"><TextBlock x:Name="RecentTimer5Text" Text="--:--" /></Button>
                                                <Button x:Name="RecentTimer6Btn" Style="{StaticResource ModernTimerQuickButtonStyle}" Click="RecentTimer6_Click"><TextBlock x:Name="RecentTimer6Text" Text="--:--" /></Button>
                                            </UniformGrid>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <Border Width="330" Height="64" Style="{StaticResource ModernTimerCardStyle}" Padding="10" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="FullscreenBtn"
                                    Style="{StaticResource ModernTimerBottomButtonStyle}"
                                    Margin="0,0,18,0"
                                    IsEnabled="False"
                                    Click="Fullscreen_Click"
                                    ToolTipService.ToolTip="全屏显示">
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.FullScreen}" FontSize="17" />
                            </Button>

                            <Button x:Name="StartPauseBtn"
                                    Style="{StaticResource ModernTimerPrimaryButtonStyle}"
                                    Width="92"
                                    Margin="0,0,18,0"
                                    Click="StartPause_Click"
                                    ToolTipService.ToolTip="开始或暂停">
                                <Path x:Name="StartPauseIcon"
                                      Width="18"
                                      Height="18"
                                      Data="M6.5 4.00004V20C6.49995 20.178 6.54737 20.3527 6.63738 20.5062C6.72739 20.6597 6.85672 20.7864 7.01202 20.8732C7.16733 20.96 7.34299 21.0038 7.52088 21.0001C7.69878 20.9964 7.87245 20.9453 8.024 20.852L21.024 12.852C21.1696 12.7626 21.2898 12.6373 21.3733 12.4881C21.4567 12.339 21.5005 12.1709 21.5005 12C21.5005 11.8291 21.4567 11.6611 21.3733 11.512C21.2898 11.3628 21.1696 11.2375 21.024 11.148L8.024 3.14804C7.87245 3.0548 7.69878 3.00369 7.52088 2.99997C7.34299 2.99626 7.16733 3.04007 7.01202 3.1269C6.85672 3.21372 6.72739 3.34042 6.63738 3.4939C6.54737 3.64739 6.49995 3.82211 6.5 4.00004Z"
                                      Fill="White"
                                      Stretch="Uniform" />
                            </Button>

                            <Button x:Name="ResetBtn"
                                    Style="{StaticResource ModernTimerBottomButtonStyle}"
                                    Click="Reset_Click"
                                    ToolTipService.ToolTip="重置计时">
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Refresh}" FontSize="17" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Viewbox>
        </Grid>
    </Border>
</UserControl>
