<UserControl x:Class="Ink_Canvas.CustomIconWindow"
             xmlns:props="clr-namespace:Ink_Canvas.Properties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="420" d:DesignHeight="320">
    <ListView Name="CustomIconsListView" Margin="0,10,0,0">
        <ListView.View>
            <GridView>
                <GridViewColumn Header="{x:Static props:RandomStrings.Random_Preview}" Width="70">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding FilePath}" Width="32" Height="32"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="{x:Static props:RandomStrings.Random_Name}" Width="200" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="{x:Static props:NotificationStrings.ActionsTitle}" Width="100">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{x:Static props:RandomStrings.Random_Delete}" Click="DeleteCustomIcon_Click" Tag="{Binding}"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
            </GridView>
        </ListView.View>
    </ListView>
</UserControl>
