<UserControl x:Class="Ink_Canvas.AddCustomIconWindow"
             xmlns:props="clr-namespace:Ink_Canvas.Properties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="500" d:DesignHeight="180">
    <StackPanel Margin="0,5,0,0">
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static props:RandomStrings.Random_AddIcon_SelectFile}" Grid.Column="0" VerticalAlignment="Center" FontSize="14"/>
            <TextBox Name="IconPathTextBox" Grid.Column="1" IsReadOnly="True" Margin="10,0,10,0" Height="28" VerticalAlignment="Center"/>
            <Button Content="{x:Static props:RandomStrings.Random_Browse}" Grid.Column="2" Click="BrowseButton_Click" Width="70" Height="30"/>
        </Grid>

        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static props:RandomStrings.Random_AddIcon_NameLabel}" Grid.Column="0" VerticalAlignment="Center" FontSize="14"/>
            <TextBox Name="IconNameTextBox" Grid.Column="1" Margin="10,0,0,0" Height="28" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Text="{x:Static props:RandomStrings.Random_AddIcon_PreviewLabel}" Margin="0,0,0,8" FontSize="14"/>

        <Border BorderBrush="{DynamicResource ComboBoxBorderBrush}" BorderThickness="1" Padding="8" HorizontalAlignment="Left">
            <Image Name="IconPreviewImage" Width="64" Height="64" Stretch="Uniform"/>
        </Border>
    </StackPanel>
</UserControl>
