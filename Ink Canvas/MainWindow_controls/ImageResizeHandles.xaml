<UserControl x:Class="Ink_Canvas.MainWindow_controls.ImageResizeHandles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="ImageResizeHandleBase" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Stroke" Value="#0078D4"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>
        <Style x:Key="ImageResizeHandleNWSE" TargetType="Ellipse" BasedOn="{StaticResource ImageResizeHandleBase}">
            <Setter Property="Cursor" Value="SizeNWSE"/>
        </Style>
        <Style x:Key="ImageResizeHandleNESW" TargetType="Ellipse" BasedOn="{StaticResource ImageResizeHandleBase}">
            <Setter Property="Cursor" Value="SizeNESW"/>
        </Style>
        <Style x:Key="ImageResizeHandleNS" TargetType="Ellipse" BasedOn="{StaticResource ImageResizeHandleBase}">
            <Setter Property="Cursor" Value="SizeNS"/>
        </Style>
        <Style x:Key="ImageResizeHandleWE" TargetType="Ellipse" BasedOn="{StaticResource ImageResizeHandleBase}">
            <Setter Property="Cursor" Value="SizeWE"/>
        </Style>
    </UserControl.Resources>
    <Canvas Name="ImageResizeHandlesCanvas"
            Visibility="Collapsed"
            Panel.ZIndex="1000">
        <!-- 四个角控制点 -->
        <Ellipse Name="ImageTopLeftHandle" Style="{StaticResource ImageResizeHandleNWSE}"
                 />
        <Ellipse Name="ImageTopRightHandle" Style="{StaticResource ImageResizeHandleNESW}"
                 />
        <Ellipse Name="ImageBottomLeftHandle" Style="{StaticResource ImageResizeHandleNESW}"
                 />
        <Ellipse Name="ImageBottomRightHandle" Style="{StaticResource ImageResizeHandleNWSE}"
                 />
        
        <!-- 四个边控制点 -->
        <Ellipse Name="ImageTopHandle" Style="{StaticResource ImageResizeHandleNS}"
                 />
        <Ellipse Name="ImageBottomHandle" Style="{StaticResource ImageResizeHandleNS}"
                 />
        <Ellipse Name="ImageLeftHandle" Style="{StaticResource ImageResizeHandleWE}"
                 />
        <Ellipse Name="ImageRightHandle" Style="{StaticResource ImageResizeHandleWE}"
                 />
    </Canvas>
</UserControl>
