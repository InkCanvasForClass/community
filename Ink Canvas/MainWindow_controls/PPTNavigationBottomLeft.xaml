<UserControl x:Class="Ink_Canvas.MainWindow_controls.PPTNavigationBottomLeft"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             x:Name="Root">
    <Viewbox x:Name="ViewboxPPTNavigationBottomLeft" Height="50">
        <Border BorderThickness="1" BorderBrush="#a1a1aa" x:Name="PPTBtnLBBorderElement"
                Background="#f4f4f5" Opacity="1" CornerRadius="6">
            <ikw:SimpleStackPanel Orientation="Horizontal">
                <Border Width="50" Height="50" MouseUp="GridPPTControlPrevious_MouseUp" Style="{StaticResource PPTPreviousButtonBorderBase}"
                        x:Name="PPTLBPreviousButtonBorderElement"
                        MouseDown="GridPPTControlPrevious_MouseDown"
                        MouseLeave="GridPPTControlPrevious_MouseLeave"
                        CornerRadius="5 5 0 0" Background="Transparent">
                    <Grid>
                        <Border Margin="3" CornerRadius="5" x:Name="PPTLBPreviousButtonFeedbackBorderElement" Style="{StaticResource PPTButtonFeedbackBorderBase}"
                                Background="#18181b" Opacity="0" />
                        <Image Height="28" Width="28">
                            <Image.Source>
                                <DrawingImage>
                                    <DrawingImage.Drawing>
                                        <DrawingGroup ClipGeometry="M0,0 V24 H24 V0 H0 Z">
                                            <GeometryDrawing Brush="#27272a"
                                                             x:Name="PPTLBPreviousButtonGeometryElement"
                                                             Geometry="{StaticResource PPTLBPreviousButtonGeometry}" />
                                        </DrawingGroup>
                                    </DrawingImage.Drawing>
                                </DrawingImage>
                            </Image.Source>
                        </Image>
                    </Grid>
                </Border>
                <Border Visibility="Visible" x:Name="PPTLBPageButtonElement" TextBlock.Foreground="#171717" Style="{StaticResource PPTPageButtonBase}"
                        MouseUp="PPTNavigationBtn_MouseUp" MouseDown="PPTNavigationBtn_MouseDown"
                        MouseLeave="PPTNavigationBtn_MouseLeave" Width="auto" MinWidth="50" Height="50"
                        Background="Transparent">
                    <Grid>
                        <Border Margin="0,3" CornerRadius="5" x:Name="PPTLBPageButtonFeedbackBorderElement" Style="{StaticResource PPTButtonFeedbackBorderBase}"
                                Background="#18181b" Opacity="0" />
                        <ikw:SimpleStackPanel VerticalAlignment="Center" Orientation="Vertical"
                                             Spacing="0.5" Margin="12,0">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="17" FontWeight="Bold"
                                       Text="{Binding CurrentPage, ElementName=Root, StringFormat={}{0}}" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="10"
                                       Text="{Binding TotalPages, ElementName=Root, StringFormat=/ {0}}" />
                        </ikw:SimpleStackPanel>
                    </Grid>
                </Border>
                <Border Width="50" Height="50" MouseUp="GridPPTControlNext_MouseUp" Style="{StaticResource PPTNextButtonBorderBase}"
                        MouseDown="GridPPTControlNext_MouseDown" MouseLeave="GridPPTControlNext_MouseLeave"
                        CornerRadius="0 0 5 5" Background="Transparent" x:Name="PPTLBNextButtonBorderElement">
                    <Grid>
                        <Border Margin="3" CornerRadius="5" x:Name="PPTLBNextButtonFeedbackBorderElement" Style="{StaticResource PPTButtonFeedbackBorderBase}"
                                Background="#18181b" Opacity="0" />
                        <Image VerticalAlignment="Center" HorizontalAlignment="Center" Height="28"
                               Width="28">
                            <Image.Source>
                                <DrawingImage>
                                    <DrawingImage.Drawing>
                                        <DrawingGroup ClipGeometry="M0,0 V24 H24 V0 H0 Z">
                                            <GeometryDrawing Brush="#27272a"
                                                             x:Name="PPTLBNextButtonGeometryElement"
                                                             Geometry="{StaticResource PPTLBNextButtonGeometry}" />
                                        </DrawingGroup>
                                    </DrawingImage.Drawing>
                                </DrawingImage>
                            </Image.Source>
                        </Image>
                    </Grid>
                </Border>
            </ikw:SimpleStackPanel>
        </Border>
    </Viewbox>
</UserControl>
