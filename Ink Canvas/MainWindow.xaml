        <Viewbox Width="50" Visibility="Collapsed"  d:Visibility="Visible" Name="RightUnFoldButtonQuickPanel" Margin="0,0,-60,-150" d:Margin="0,0,-60,500"
                 HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border x:Name="RightQuickPanelBorder" ClipToBounds="False" Visibility="Visible" CornerRadius="6" Background="{DynamicResource FloatBarBackground}" Opacity="1"
                    BorderThickness="1" BorderBrush="{DynamicResource FloatBarBorderBrush}" d:BorderBrush="Red" d:Background="Green" Width="32">
                <Border.Effect>
                    <DropShadowEffect x:Name="RightQuickPanelShadow" BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.3" Color="#000000" />
                </Border.Effect>
                <ikw:SimpleStackPanel Orientation="Vertical" Margin="0,5">
                    <controls:QuickPanelButton IconSource="{DynamicResource QuickPanelPersonMoneyIcon}" Label="{x:Static props:FloatingBarStrings.QuickPanel_SingleDraw}" ButtonMouseUp="SymbolIconRandOne_MouseUp" />
                    <controls:QuickPanelButton IconSource="{DynamicResource QuickPanelPeopleMoneyIcon}" Label="{x:Static props:FloatingBarStrings.Tools_RandomDraw}" ButtonMouseUp="SymbolIconRand_MouseUp" />
                    <controls:QuickPanelButton IconSource="{DynamicResource QuickPanelTimerIcon}" Label="{x:Static props:FloatingBarStrings.QuickPanel_Timer}" ButtonMouseUp="ImageCountdownTimer_MouseUp" />
                    <controls:QuickPanelButton IconSource="{DynamicResource QuickPanelBlackboardIcon}" Label="{x:Static props:FloatingBarStrings.FloatingBar_Whiteboard}" ButtonMouseUp="ImageBlackboard_MouseUp" />
                    <controls:QuickPanelButton x:Name="BtnExitPptFromSidebarRight" IconSource="{DynamicResource QuickPanelEndSlideshowIcon}" Label="{x:Static props:FloatingBarStrings.QuickPanel_ExitShow}" LabelFontSize="7" Visibility="Collapsed"  d:Visibility="Visible" ButtonMouseUp="ExitPPTSlideShow_MouseUp" />
                    <controls:QuickPanelButton IconSource="{DynamicResource QuickPanelEyeIcon}" Label="{x:Static props:FloatingBarStrings.QuickPanel_Show}" ButtonMouseUp="UnFoldFloatingBar_MouseUp" />
                    <controls:QuickPanelButton IconSource="{DynamicResource QuickPanelChevronLeftIcon}" ButtonMouseUp="HideQuickPanel_MouseUp" RenderTransformOrigin="0.5,0.5">
