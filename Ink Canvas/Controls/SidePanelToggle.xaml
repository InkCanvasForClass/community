<UserControl x:Class="Ink_Canvas.Controls.SidePanelToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             mc:Ignorable="d">
    <Viewbox Height="50" Width="32" VerticalAlignment="Center">
        <ikw:SimpleStackPanel>
            <Border x:Name="PanelBorder" Background="#9918181b" Opacity="1"
                    CornerRadius="0,25,25,0" Height="50" Width="32">
                <Image x:Name="ChevronImage" Margin="10,0,0,0"
                       Source="{DynamicResource QuickPanelUnfoldChevronIcon}"
                       RenderOptions.BitmapScalingMode="HighQuality" Height="14" Width="14" />
            </Border>
        </ikw:SimpleStackPanel>
    </Viewbox>
</UserControl>
