<UserControl xmlns:props="clr-namespace:Ink_Canvas.Properties"
             xmlns:fb="clr-namespace:Ink_Canvas.Properties"
             x:Class="Ink_Canvas.Controls.WhiteboardModeSelectionPopupContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="6" Padding="4"
            MinWidth="120">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- 全屏白板 -->
            <Border x:Name="FullWhiteboardMenuItem"
                    CornerRadius="4" Padding="10,6" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{DynamicResource QuickPanelBlackboardIcon}"
                           Width="14" Height="14"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Static fb:FloatingBarStrings.FloatingBar_Whiteboard}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <!-- 小白板 -->
            <Border x:Name="MiniWhiteboardMenuItem"
                    CornerRadius="4" Padding="10,6" Cursor="Hand"
                    Margin="0,2,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{DynamicResource QuickPanelBlackboardIcon}"
                           Width="14" Height="14"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Static fb:FloatingBarStrings.FloatingBar_MiniWhiteboard}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
