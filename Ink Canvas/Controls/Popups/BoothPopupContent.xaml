<UserControl xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Controls.BoothPopupContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
             mc:Ignorable="d"
             d:DesignWidth="320" d:DesignHeight="240">
    <Grid>
        <controls:PopupShellContent x:Name="Shell" Title="{x:Static props:BoothStrings.Title}" d:Visibility="Collapsed" />
        <ContentControl x:Name="InnerContentHost" Visibility="Collapsed" d:Visibility="Visible">
            <ikw:SimpleStackPanel Margin="10" Spacing="8" HorizontalAlignment="Stretch">
                <!-- 摄像头设备 -->
                <ikw:SimpleStackPanel Orientation="Vertical" Spacing="3">
                    <TextBlock Text="{x:Static props:BoothStrings.CameraDevices}"
                               Foreground="{DynamicResource FloatingBarForegroundBrush}"
                               FontSize="13" FontWeight="SemiBold" />
                    <ComboBox x:Name="CameraDevicesComboBoxCtrl"
                              MinWidth="260" />
                </ikw:SimpleStackPanel>

                <!-- 分辨率 -->
                <ikw:SimpleStackPanel Orientation="Vertical" Spacing="3">
                    <TextBlock Text="{x:Static props:BoothStrings.Resolution_Tooltip}"
                               Foreground="{DynamicResource FloatingBarForegroundBrush}"
                               FontSize="13" FontWeight="SemiBold" />
                    <ComboBox x:Name="BoothResolutionComboBoxCtrl"
                              MinWidth="260"
                              ToolTip="{x:Static props:BoothStrings.Resolution_Tooltip}" />
                </ikw:SimpleStackPanel>

                <!-- 加速模式：CPU / OpenCL / CUDA -->
                <ikw:SimpleStackPanel Orientation="Vertical" Spacing="3">
                    <TextBlock Text="{x:Static props:BoothStrings.Acceleration}"
                               Foreground="{DynamicResource FloatingBarForegroundBrush}"
                               FontSize="13" FontWeight="SemiBold" />
                    <ComboBox x:Name="PhotoCorrectionAccelerationComboBoxCtrl"
                              MinWidth="260"
                              ToolTip="{x:Static props:BoothStrings.Acceleration_Tooltip}"
                              SelectedIndex="0">
                        <ComboBoxItem Content="{x:Static props:BoothStrings.AccelerationCpu}" />
                        <ComboBoxItem Content="{x:Static props:BoothStrings.AccelerationOpenCL}" />
                        <ComboBoxItem Content="{x:Static props:BoothStrings.AccelerationCUDA}" />
                    </ComboBox>
                </ikw:SimpleStackPanel>

                <!-- 亮度（曝光度） -->
                <ikw:SimpleStackPanel Orientation="Vertical" Spacing="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{x:Static props:BoothStrings.Brightness}"
                                   Foreground="{DynamicResource FloatingBarForegroundBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Slider Grid.Column="1"
                                x:Name="BrightnessSliderCtrl"
                                Minimum="-100" Maximum="100" Value="0"
                                TickFrequency="10" TickPlacement="BottomRight"
                                SmallChange="1" LargeChange="10"
                                Margin="8,0"
                                MinWidth="180"
                                VerticalAlignment="Center"
                                ToolTip="{x:Static props:BoothStrings.Brightness_Tooltip}" />
                        <TextBlock Grid.Column="2"
                                   x:Name="BrightnessValueTextCtrl"
                                   Text="0" MinWidth="36" TextAlignment="Right"
                                   Foreground="{DynamicResource FloatingBarForegroundBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Grid>
                </ikw:SimpleStackPanel>

                <!-- 专业模式：对比度 / 饱和度 / 色温 / 增益 / 焦距 / 快门 -->
                <Expander x:Name="ProModeExpanderCtrl"
                          Header="{x:Static props:BoothStrings.ProMode}"
                          ToolTip="{x:Static props:BoothStrings.ProMode_Tooltip}"
                          IsExpanded="False"
                          Padding="0,2">
                    <ikw:SimpleStackPanel Orientation="Vertical" Spacing="6" Margin="0,4,0,0">
                        <!-- 对比度 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static props:BoothStrings.Contrast}"
                                       Foreground="{DynamicResource FloatingBarForegroundBrush}"
                                       FontSize="12" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" x:Name="ContrastSliderCtrl"
                                    Minimum="-100" Maximum="100" Value="0"
                                    TickFrequency="10" TickPlacement="BottomRight"
                                    SmallChange="1" LargeChange="10"
                                    Margin="8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="ContrastValueTextCtrl"
                                       Text="0" TextAlignment="Right"
                                       Foreground="{DynamicResource FloatingBarForegroundBrush}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                        <!-- 饱和度 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static props:BoothStrings.Saturation}"
                                       Foreground="{DynamicResource FloatingBarForegroundBrush}"
                                       FontSize="12" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" x:Name="SaturationSliderCtrl"
                                    Minimum="-100" Maximum="100" Value="0"
                                    TickFrequency="10" TickPlacement="BottomRight"
                                    SmallChange="1" LargeChange="10"
                                    Margin="8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="SaturationValueTextCtrl"
                                       Text="0" TextAlignment="Right"
                                       Foreground="{DynamicResource FloatingBarForegroundBrush}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                        <!-- 色温（白平衡） -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static props:BoothStrings.WhiteBalance}"
                                       Foreground="{DynamicResource FloatingBarForegroundBrush}"
                                       FontSize="12" VerticalAlignment="Center"
                                       ToolTip="{x:Static props:BoothStrings.WhiteBalance_Tooltip}" />
                            <Slider Grid.Column="1" x:Name="WhiteBalanceSliderCtrl"
                                    Minimum="-100" Maximum="100" Value="0"
                                    TickFrequency="10" TickPlacement="BottomRight"
                                    SmallChange="1" LargeChange="10"
                                    Margin="8,0" VerticalAlignment="Center"
                                    ToolTip="{x:Static props:BoothStrings.WhiteBalance_Tooltip}" />
                            <TextBlock Grid.Column="2" x:Name="WhiteBalanceValueTextCtrl"
                                       Text="0" TextAlignment="Right"
                                       Foreground="{DynamicResource FloatingBarForegroundBrush}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                        <!-- 增益（ISO 替代） -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static props:BoothStrings.Gain}"
                                       Foreground="{DynamicResource FloatingBarForegroundBrush}"
                                       FontSize="12" VerticalAlignment="Center"
                                       ToolTip="{x:Static props:BoothStrings.Gain_Tooltip}" />
                            <Slider Grid.Column="1" x:Name="GainSliderCtrl"
                                    Minimum="-100" Maximum="100" Value="0"
                                    TickFrequency="10" TickPlacement="BottomRight"
                                    SmallChange="1" LargeChange="10"
                                    Margin="8,0" VerticalAlignment="Center"
                                    ToolTip="{x:Static props:BoothStrings.Gain_Tooltip}" />
                            <TextBlock Grid.Column="2" x:Name="GainValueTextCtrl"
                                       Text="0" TextAlignment="Right"
                                       Foreground="{DynamicResource FloatingBarForegroundBrush}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                        <!-- 焦距 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static props:BoothStrings.Focus}"
                                       Foreground="{DynamicResource FloatingBarForegroundBrush}"
                                       FontSize="12" VerticalAlignment="Center"
                                       ToolTip="{x:Static props:BoothStrings.Focus_Tooltip}" />
                            <Slider Grid.Column="1" x:Name="FocusSliderCtrl"
                                    Minimum="-100" Maximum="100" Value="0"
                                    TickFrequency="10" TickPlacement="BottomRight"
                                    SmallChange="1" LargeChange="10"
                                    Margin="8,0" VerticalAlignment="Center"
                                    ToolTip="{x:Static props:BoothStrings.Focus_Tooltip}" />
                            <TextBlock Grid.Column="2" x:Name="FocusValueTextCtrl"
                                       Text="0" TextAlignment="Right"
                                       Foreground="{DynamicResource FloatingBarForegroundBrush}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                        <!-- 快门（曝光） -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static props:BoothStrings.Exposure}"
                                       Foreground="{DynamicResource FloatingBarForegroundBrush}"
                                       FontSize="12" VerticalAlignment="Center"
                                       ToolTip="{x:Static props:BoothStrings.Exposure_Tooltip}" />
                            <Slider Grid.Column="1" x:Name="ExposureSliderCtrl"
                                    Minimum="-100" Maximum="100" Value="0"
                                    TickFrequency="10" TickPlacement="BottomRight"
                                    SmallChange="1" LargeChange="10"
                                    Margin="8,0" VerticalAlignment="Center"
                                    ToolTip="{x:Static props:BoothStrings.Exposure_Tooltip}" />
                            <TextBlock Grid.Column="2" x:Name="ExposureValueTextCtrl"
                                       Text="0" TextAlignment="Right"
                                       Foreground="{DynamicResource FloatingBarForegroundBrush}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </ikw:SimpleStackPanel>
                </Expander>

                <!-- 4 个操作按钮：矫正 / 拍照 / 旋转 / 关闭 -->
                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <ToggleButton x:Name="PhotoCorrectionToggleCtrl"
                                  Padding="10,4"
                                  MinWidth="64">
                        <TextBlock Text="{x:Static props:BoothStrings.Correction}" />
                    </ToggleButton>
                    <Button x:Name="CapturePhotoButtonCtrl"
                            Padding="10,4"
                            MinWidth="64">
                        <TextBlock Text="{x:Static props:BoothStrings.Capture}" />
                    </Button>
                    <Button x:Name="RotateImageButtonCtrl"
                            Padding="10,4"
                            MinWidth="64">
                        <TextBlock Text="{x:Static props:BoothStrings.Rotate}" />
                    </Button>
                    <Button x:Name="ExitVideoPresenterButtonCtrl"
                            Padding="10,4"
                            MinWidth="64">
                        <TextBlock Text="{x:Static props:BoothStrings.Close}" />
                    </Button>
                </ikw:SimpleStackPanel>
            </ikw:SimpleStackPanel>
        </ContentControl>
    </Grid>
</UserControl>
