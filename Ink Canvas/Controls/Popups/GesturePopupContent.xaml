<UserControl xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Controls.GesturePopupContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
mc:Ignorable="d">
    <Grid>
        <controls:PopupShellContent x:Name="Shell" Title="{x:Static props:GestureStrings.Gesture_Title}" d:Visibility="Collapsed" />
        <ContentControl x:Name="InnerContentHost" Visibility="Collapsed" d:Visibility="Visible">
            <ikw:SimpleStackPanel x:Name="_OpacityPanel" Spacing="2" Margin="10">
                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                    <Image Source="{DynamicResource MultiTouchIcon}"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Height="24" Width="24" />
                    <Label x:Name="MultiTouchLabel"
                           Content="{x:Static props:FloatingBarStrings.FloatingBar_Gesture_MultiTouchWriting}"
                           Foreground="{DynamicResource FloatBarForeground}"
                           VerticalAlignment="Center"/>
                    <ui:ToggleSwitch x:Name="ToggleSwitchEnableMultiTouchMode"
                                     MinWidth="0" OnContent="" OffContent=""
                                    RenderTransformOrigin="0.5,0.5">
                    </ui:ToggleSwitch>
                </ikw:SimpleStackPanel>
                <ikw:SimpleStackPanel x:Name="TwoFingerMoveRow" Orientation="Horizontal" Spacing="8">
                    <Image Source="{DynamicResource HandMoveIcon}"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Height="24" Width="24" />
                    <Label x:Name="TwoFingerMoveLabel"
                           Content="{x:Static props:FloatingBarStrings.Board_TwoFingerMove}"
                           Foreground="{DynamicResource FloatBarForeground}"
                           VerticalAlignment="Center"/>
                    <ui:ToggleSwitch x:Name="ToggleSwitchEnableTwoFingerTranslate"
                                     MinWidth="0" OnContent="" OffContent=""
                                     RenderTransformOrigin="0.5,0.5">
                    </ui:ToggleSwitch>
                </ikw:SimpleStackPanel>
                <ikw:SimpleStackPanel x:Name="TwoFingerZoomRow" Orientation="Horizontal" Spacing="8">
                    <Image Source="{DynamicResource ZoomIcon}"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Height="24" Width="24" />
                    <Label x:Name="TwoFingerZoomLabel"
                           Content="{x:Static props:FloatingBarStrings.FloatingBar_Gesture_TwoFingerZoom}"
                           Foreground="{DynamicResource FloatBarForeground}"
                           VerticalAlignment="Center"/>
                    <ui:ToggleSwitch x:Name="ToggleSwitchEnableTwoFingerZoom"
                                     MinWidth="0" OnContent="" OffContent=""
                                     RenderTransformOrigin="0.5,0.5">
                    </ui:ToggleSwitch>
                </ikw:SimpleStackPanel>
                <ikw:SimpleStackPanel x:Name="TwoFingerRotateRow" Orientation="Horizontal" Spacing="8">
                    <Image Source="{DynamicResource RotateIcon}"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Height="24" Width="24" />
                    <Label x:Name="TwoFingerRotateLabel"
                           Content="{x:Static props:FloatingBarStrings.FloatingBar_Gesture_TwoFingerRotate}"
                           Foreground="{DynamicResource FloatBarForeground}"
                           VerticalAlignment="Center"/>
                    <ui:ToggleSwitch x:Name="ToggleSwitchEnableTwoFingerRotation"
                                     MinWidth="0" OnContent="" OffContent="" 
                                     RenderTransformOrigin="0.5,0.5">
                    </ui:ToggleSwitch>
                </ikw:SimpleStackPanel>
            </ikw:SimpleStackPanel>
        </ContentControl>
    </Grid>
</UserControl>
