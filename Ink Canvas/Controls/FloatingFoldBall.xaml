<UserControl x:Class="Ink_Canvas.Controls.FloatingFoldBall"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:props="clr-namespace:Ink_Canvas.Properties"
             Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top"
             Cursor="Hand" ToolTip="{x:Static props:ThemeStrings.Theme_FloatingFoldBall_Hint}"
             Stylus.IsPressAndHoldEnabled="False" Stylus.IsFlicksEnabled="False">
    <Border CornerRadius="24" Background="{DynamicResource FloatingBarBackgroundBrush}"
            BorderBrush="{DynamicResource FloatingBarBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.25" />
        </Border.Effect>
        <Image Source="{DynamicResource QuickPanelEyeIcon}" Width="24" Height="24"
               IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
    </Border>
</UserControl>
