<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
                    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf">
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#27272a"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#3b82f6"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag}" Value="startup"><Setter Property="Background" Value="#3b82f6"/></DataTrigger>
                        <DataTrigger Binding="{Binding Tag}" Value="canvas"><Setter Property="Background" Value="#3b82f6"/></DataTrigger>
                        <DataTrigger Binding="{Binding Tag}" Value="gesture"><Setter Property="Background" Value="#3b82f6"/></DataTrigger>
                        <DataTrigger Binding="{Binding Tag}" Value="inkrecognition"><Setter Property="Background" Value="#3b82f6"/></DataTrigger>
                        <DataTrigger Binding="{Binding Tag}" Value="crashaction"><Setter Property="Background" Value="#3b82f6"/></DataTrigger>
                        <DataTrigger Binding="{Binding Tag}" Value="ppt"><Setter Property="Background" Value="#3b82f6"/></DataTrigger>
                        <DataTrigger Binding="{Binding Tag}" Value="advanced"><Setter Property="Background" Value="#3b82f6"/></DataTrigger>
                        <DataTrigger Binding="{Binding Tag}" Value="automation"><Setter Property="Background" Value="#3b82f6"/></DataTrigger>
                        <DataTrigger Binding="{Binding Tag}" Value="randomwindow"><Setter Property="Background" Value="#3b82f6"/></DataTrigger>
                        <DataTrigger Binding="{Binding Tag}" Value="theme"><Setter Property="Background" Value="#3b82f6"/></DataTrigger>
                        <DataTrigger Binding="{Binding Tag}" Value="shortcuts"><Setter Property="Background" Value="#3b82f6"/></DataTrigger>
                        <DataTrigger Binding="{Binding Tag}" Value="about"><Setter Property="Background" Value="#3b82f6"/></DataTrigger>
                        <DataTrigger Binding="{Binding Tag}" Value="plugins"><Setter Property="Background" Value="#3b82f6"/></DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GroupBoxBase" TargetType="GroupBox">
        <Setter Property="Foreground" Value="#fafafa"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="GroupBoxPlugins" TargetType="GroupBox" BasedOn="{StaticResource GroupBoxBase}"/>
    <Style x:Key="GroupBoxStartup" TargetType="GroupBox" BasedOn="{StaticResource GroupBoxBase}"/>
    <Style x:Key="GroupBoxModeSettings" TargetType="GroupBox" BasedOn="{StaticResource GroupBoxBase}"/>
    <Style x:Key="GroupBoxNewSettings" TargetType="GroupBox" BasedOn="{StaticResource GroupBoxBase}"/>
    <Style x:Key="GroupBoxCanvas" TargetType="GroupBox" BasedOn="{StaticResource GroupBoxBase}"/>
    <Style x:Key="GroupBoxCrashAction" TargetType="GroupBox" BasedOn="{StaticResource GroupBoxBase}"/>
    <Style x:Key="GroupBoxGesture" TargetType="GroupBox" BasedOn="{StaticResource GroupBoxBase}"/>
    <Style x:Key="GroupBoxInkRecognition" TargetType="GroupBox" BasedOn="{StaticResource GroupBoxBase}"/>
    <Style x:Key="GroupBoxAppearanceNewUI" TargetType="GroupBox" BasedOn="{StaticResource GroupBoxBase}"/>

    <Style x:Key="SettingsPanelScrollViewer" TargetType="ui:ScrollViewerEx">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="PanningMode" Value="VerticalOnly"/>
    </Style>

    <Style x:Key="SimpleStackPanel" TargetType="ikw:SimpleStackPanel">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BoardToolBorderBase" TargetType="Border">
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Background" Value="{DynamicResource BoardFloatBarBackground}"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BoardFloatBarBorderBrush}"/>
    </Style>
    <Style x:Key="BoardSelect" TargetType="Border" BasedOn="{StaticResource BoardToolBorderBase}">
        <Setter Property="BorderThickness" Value="1,1,0,1"/>
        <Setter Property="CornerRadius" Value="5,0,0,5"/>
    </Style>
    <Style x:Key="BoardPen" TargetType="Border" BasedOn="{StaticResource BoardToolBorderBase}">
        <Setter Property="BorderThickness" Value="0,1,0,1"/>
    </Style>
    <Style x:Key="BoardEraser" TargetType="Border" BasedOn="{StaticResource BoardToolBorderBase}">
        <Setter Property="BorderThickness" Value="0,1,1,1"/>
    </Style>

    <Style x:Key="BoardDefaultPenTabButton" TargetType="Border">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style x:Key="BoardHighlightPenTabButton" TargetType="Border">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Width" Value="52"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style x:Key="BoardCircleEraserTabButton" TargetType="Border">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style x:Key="BoardRectangleEraserTabButton" TargetType="Border" BasedOn="{StaticResource BoardCircleEraserTabButton}"/>

    <Style x:Key="BoardBorderPenColor" TargetType="Border">
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="100"/>
        <Setter Property="Width" Value="45"/>
    </Style>

    <Style x:Key="PPTPreviousButtonBorderBase" TargetType="Border">
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="PPTNextButtonBorderBase" TargetType="Border" BasedOn="{StaticResource PPTPreviousButtonBorderBase}">
        <Setter Property="CornerRadius" Value="0 0 5 5"/>
    </Style>
    <Style x:Key="PPTPageButtonBase" TargetType="Border">
        <Setter Property="Visibility" Value="Visible"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="PPTButtonFeedbackBorderBase" TargetType="Border">
        <Setter Property="Background" Value="#18181b"/>
        <Setter Property="Opacity" Value="0"/>
    </Style>

    <Style x:Key="GridNotifications" TargetType="Grid">
        <Setter Property="Margin" Value="0,110"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>

    <Style x:Key="PopupBorderBase" TargetType="Border">
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Background" Value="{DynamicResource FloatBarBackground}"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="BorderTools" TargetType="Border" BasedOn="{StaticResource PopupBorderBase}">
        <Setter Property="BorderBrush" Value="#2563eb"/>
    </Style>
    <Style x:Key="BoardBorderTools" TargetType="Border" BasedOn="{StaticResource PopupBorderBase}">
        <Setter Property="BorderBrush" Value="#2563eb"/>
    </Style>
    <Style x:Key="BorderDrawShape" TargetType="Border" BasedOn="{StaticResource PopupBorderBase}">
        <Setter Property="BorderBrush" Value="#2563eb"/>
    </Style>
    <Style x:Key="BoardBorderDrawShape" TargetType="Border" BasedOn="{StaticResource BorderDrawShape}"/>
    <Style x:Key="EraserSizePanel" TargetType="Border" BasedOn="{StaticResource PopupBorderBase}">
        <Setter Property="BorderBrush" Value="#2563eb"/>
    </Style>
    <Style x:Key="BoardEraserSizePanel" TargetType="Border" BasedOn="{StaticResource EraserSizePanel}"/>
    <Style x:Key="TwoFingerGestureBorder" TargetType="Border" BasedOn="{StaticResource PopupBorderBase}">
        <Setter Property="BorderBrush" Value="#2563eb"/>
    </Style>
    <Style x:Key="BoardTwoFingerGestureBorder" TargetType="Border" BasedOn="{StaticResource TwoFingerGestureBorder}"/>
    <Style x:Key="EnableTwoFingerGestureBorder" TargetType="Border">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Background" Value="{DynamicResource FloatBarBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FloatBarBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
</ResourceDictionary>
