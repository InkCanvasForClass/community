<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-windows10.0.19041.0</TargetFramework>
    <!-- 声明支持的全部 RID：CI include_runtime 分支用 dotnet publish -r win-x64/win-x86
         （带 no-restore）时，RID 会以全局属性传给 ProjectReference 的 MagHost。
         不声明 RuntimeIdentifiers，restore 就不会为 MagHost 生成对应的 RID 目标，
         构建时会报 NETSDK1047（assets 缺 net6.0-windows.../win-x64）。
         与主项目 InkCanvasForClass.csproj 的声明保持一致；默认构建仍为 portable，无 RID 选中。 -->
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>InkCanvas.LiquidGlassMagHost</RootNamespace>
    <AssemblyName>InkCanvas.LiquidGlassMagHost</AssemblyName>
    <UseWPF>false</UseWPF>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 不生成 PDB -->
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <!-- 输出到自己的 bin\$(Configuration)\$(TargetFramework)\，
         由主项目 CopyLiquidGlassMagHost 在 Build/Publish 后复制到主程序输出目录。
         与 IACoreHelper 的 Copy target 模式一致，AnyCPU(=x64 产物)/x86/x64 的 CI 构建都能带上 exe。 -->
    <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
  </PropertyGroup>

  <!-- 主程序 AnyCPU 在 CI 里对应 x64 产物（见 prerelease.yml 的 -x64 后缀），
       辅助进程位宽与主程序对齐：x86→x86、ARM64→ARM64、其余（AnyCPU/x64/空）→x64。 -->
  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <PlatformTarget>ARM64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' != 'x86' And '$(Platform)' != 'ARM64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- .NET SDK 自动包含所有 *.cs 与 Properties\*.cs，这里不再重复声明 -->
  <ItemGroup>
    <None Include="app.manifest" />
  </ItemGroup>

  <!-- Costura.Fody 把所有引用的运行时 dll（System.*、Microsoft.* 等）嵌入到 exe 里，
       运行时从内存加载，不产生额外 dll 文件。需要 FodyWeavers.xml 显式开启嵌入。 -->
  <ItemGroup>
    <PackageReference Include="Fody" Version="6.8.2" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
