<Project Sdk="Microsoft.NET.Sdk">
  <!--
    菜单弹出动画的诊断工具：把动画代码"声称"的行为放进真实 WPF 管线跑一遍。

    与 InkCanvas.NativeInk.Tests 的分工：
    - NativeInk.Tests 是无人值守的单测（纯数学，不碰 WPF）；
    - 本工具是人工/半自动的端到端核对，需要真实窗口与 Popup，因此单独成工程。

    它同样用 <Compile Include> 源码链接被测代码，避免"测的是拷贝、跑的是原版"。
    故意不加入 Ink Canvas.sln：与 NativeInk.Tests 一样不参与 CI 构建，
    免得给发布流水线增加一个只为诊断存在的产物。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>10</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Ink_Canvas.PopupDiagnostics</RootNamespace>
    <AssemblyName>InkCanvas.PopupDiagnostics</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- 纯数学：曲线形状与时钟规则 -->
    <Compile Include="..\Ink Canvas\Helpers\Motion\PopupCurve.cs" Link="Linked\Motion\PopupCurve.cs" />
    <Compile Include="..\Ink Canvas\Helpers\Motion\PopupTiming.cs" Link="Linked\Motion\PopupTiming.cs" />
    <!-- 依赖 WPF：缩放原点换算与过冲留白 -->
    <Compile Include="..\Ink Canvas\Helpers\PopupScaleOrigin.cs" Link="Linked\PopupScaleOrigin.cs" />
    <Compile Include="..\Ink Canvas\Helpers\PopupOverflowRoom.cs" Link="Linked\PopupOverflowRoom.cs" />
  </ItemGroup>
</Project>
